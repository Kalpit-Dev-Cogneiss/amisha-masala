                      <span class="hover-underline d-inline-block white-space">
                        {{- 'products.facets.clear_all' | t -}}
                      </span>
                                        </a>
                                    </facet-remove>
                                    <button
                                            type="button"
                                            class="no-js-hidden btn btn-white button-sm w-50"
                                            onclick="this.closest('.mobile-facets__wrapper').querySelector('summary').click()"
