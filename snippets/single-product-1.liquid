{% assign featured_media = product.selected_or_first_available_variant.featured_media
        | default: product.featured_media
%}
{% liquid assign count = 0 %}
{% for media in product.media %}
    {% liquid assign count = forloop.index0 %}
{% endfor %}
<div class="content-slide position-relative">
    <div class="hero-slider {{ style }}{% if count < 2 %} hero-nothumb{% endif %}">
        <div
                class="swiper-container-pd-thumb overflow-hidden position-relative"
                data-swiper-v="{{ section_id }}"
                data-slide='
        {
          "slidesPerView": 1,
          "lazy": true,
          "loop": false,
          "autoplay": false,
          "speed": 400,
          "autoHeight": false,
          "spaceBetween": 10,
          "navigation": {
            "nextEl": ".cs-swiper-button-next",
            "prevEl": ".cs-swiper-button-prev"
          },
          "pagination": {
            "el": ".swiper-pagination",
            "dynamicBullets": true,
            "clickable": true
          },

          "thumb":{
            "spaceBetween": 10,
            "loop": false,
             "slideToClickedSlide": true,
            {% if style == "style-vertical" %}

              "breakpoints": {
                                  "0": { "direction": "horizontal", "slidesPerView": 4 },
                                  "768": { "direction": "horizontal", "slidesPerView": 12 },
                                  "992": { "direction": "vertical", "slidesPerView": "auto" }
                                  },
            {% else %}
            "breakpoints": {
                                  "0": { "direction": "horizontal", "slidesPerView": 6 },
                                  "768": { "direction": "horizontal", "slidesPerView": 12 },
                                  "992": { "direction": "horizontal", "slidesPerView": "12" }
                                  },
            {% endif %}
              "spaceBetween": 10
          }
        }
      '
        >

            {% if count > 1 %}
                <div class="clearfix cs-navigation style-center">
                    <div class="cs-swiper-button cs-swiper-button-prev">
                        <span></span>
                    </div>
                    <div class="cs-swiper-button cs-swiper-button-next">
                        <span></span>
                    </div>
                </div>
            {% endif %}
            <div class="swiper-wrapper">
                {% for media in product.media %}
                    <div
                            class="swiper-slide position-relative item"
                            data-target="{{ section_id }}-{{ media.id }}"
                            data-media-position="{{ forloop.index0 }}"
                    >
                        {% render 'product-media-main',
                                media: media,
                                loop: enable_video_looping,
                                enable_image_zoom: enable_image_zoom
                        %}
                    </div>
                {% endfor %}
            </div>
            <div class="swiper-pagination mb-2"></div>
        </div>
    </div>
</div>

<noscript>
    {% capture product_image_size %}{{ height }}x{% endcapture %}
    <img
            src="{{ featured_media | image_url: product_image_size, scale: product_image_scale }}"
            loading="lazy"
            alt="{{ featured_media.alt }}"
            id="FeaturedMedia-{{ section_id }}"
            class="product-featured-media"
            width="auto"
            height="auto"
            style="max-width: {{ height }}px;"
    >
</noscript>

{% assign three_d_model_media = product.media | where: 'media_type', 'model' | first %}
{% if three_d_model_media %}
    <button
            aria-label="{{ 'products.product.view_in_space_label' | t }}"
            class="product-single__view-in-space"
            data-shopify-xr
            data-shopify-model3d-id="{{ three_d_model_media.id }}"
            data-shopify-title="{{ product.title | escape }}"
            data-shopify-xr-hidden
    >
        <i class="bi bi-hexagon-half"></i>
        <span
                class="product-single__view-in-space-text"
        >
      {{- 'products.product.view_in_space' | t -}}
    </span>
    </button>
{% endif %}
