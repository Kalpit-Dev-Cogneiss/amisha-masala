<div class="clearfix cs-navigation {{ class }}">
  <div class="cs-swiper-button cs-swiper-button-prev cs-swiper-button-prev{{ section_id }}">
    {% if navigation_icon == 'style-2' %}
      <i class="bi bi-arrow-left"></i>
    {% else %}
      <i class="bi bi-chevron-left"></i>
    {% endif %}
  </div>
  <div class="cs-swiper-button cs-swiper-button-next cs-swiper-button-next{{ section_id }}">
    {% if navigation_icon == 'style-2' %}
      <i class="bi bi-arrow-right"></i>
    {% else %}
      <i class="bi bi-chevron-right"></i>
    {% endif %}
  </div>
</div>
