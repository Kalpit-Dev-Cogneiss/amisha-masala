{% if block.settings.show_1 %}
    <div class="card-icon w-100 mb-2 me-3 position-relative d-flex align-items-center{% if block.settings.link_1 != blank %} color-link{% endif %} {% if layout == 'vertical' %} flex-column justify-content-between text-center {% endif %}">
        {% if block.settings.link_1 != blank %}
            <a class="full-width-link" href="{{ block.settings.link_1 }}">
                <span class="d-none">{{ text_1 }}</span>
            </a>
        {% endif %}
        <div class="clearfix lh-0 item-hover {% if layout == 'vertical' %} {{ size }}{% endif %}">
            {% if block.settings.image_1 != blank %}
                {% render 'image', lazyload: true,
                        image: block.settings.image_1
                %}
            {% else %}
                <i class="bi text-success {{  block.settings.icon_1 }}"></i>
            {% endif %}
        </div>
        {% if block.settings.text_1 != blank %}
            <p class="fs-14 opacity-85 mb-0 mt-1 mx-auto{% if layout == 'horizontal' %} ms-2{% endif %}">
                {{ block.settings.text_1 }}
            </p>
        {% endif %}
    </div>
{% endif %}
