<!-- /snippets/social-sharing.liquid -->
<ul class="ul-none-style list--inline social-icons  d-flex flex-wrap align-items-center m-0 p-0 {{ class }}">
  {% if title != null %}
    <li class="social-icons__item lh-1">
      <span class="share-title fw-bold" aria-hidden="true">{{ 'general.social.label' | t }}:</span>
    </li>
  {% endif %}
  {% if settings.share_facebook %}
    <li class="social-icons__item">
      <a
        target="_blank"
        href="//www.facebook.com/sharer.php?u={{ shop.url | append: share_permalink }}"
        class="social-icons__link"
        aria-label="Facebook"
      >
        <i class="bi bi-facebook"></i>
      </a>
    </li>
  {% endif %}

  {% if settings.share_twitter %}
    <li class="social-icons__item">
      <a
        target="_blank"
        href="//x.com/share?text={{ share_title | url_param_escape }}&amp;url={{ shop.url | append: share_permalink }}"
        class="social-icons__link"
        aria-label="Pinterest"
      >
        <i class="bi bi-twitter-x"></i>
      </a>
    </li>
  {% endif %}

  {% if settings.share_pinterest %}
    <li class="social-icons__item">
      <a
        target="_blank"
        href="//pinterest.com/pin/create/button/?url={{ shop.url | append: share_permalink }}&amp;media={{ share_image | image_url: width: 1024, height: 1024 }}&amp;description={{ share_title | url_param_escape }}"
        class="social-icons__link"
        aria-label="Twitter"
      >
       <i class="bi bi-pinterest"></i>
      </a>
    </li>
  {% endif %}
</ul>
