{% assign socials = 'Facebook Instagram YouTube Tiktok Twitter Snapchat Pinterest Vimeo' | split: ' ' %}
<ul class="list--inline social-icons py-0 d-flex align-items-center flex-wrap {{ class }}">
  {% for social in socials %}
    {% assign social_link = social | prepend: 'social_' | append: '_link' | downcase %}
    {% assign icon_link = social | prepend: 'icon-' | downcase %}
    {% if settings[social_link] != blank %}
      <li class="social-icons__item">
        <a
          class="social-icons__link"
          href="{{ settings[social_link] | escape }}"
          target="_blank"
          aria-describedby="a11y-external-message"
          aria-label="{{ social }}"
        >
          {% if icon_link == 'icon-facebook' %}
            <i class="bi bi-facebook"></i>
          {% endif %}
          {% if icon_link == 'icon-instagram' %}
            <i class="bi bi-instagram"></i>
          {% endif %}
          {% if icon_link == 'icon-youtube' %}
            <i class="bi bi-youtube"></i>
          {% endif %}
          {% if icon_link == 'icon-tiktok' %}
            <i class="bi bi-tiktok"></i>
          {% endif %}
          {% if icon_link == 'icon-twitter' %}
            <i class="bi bi-twitter-x"></i>
          {% endif %}
          {% if icon_link == 'icon-snapchat' %}
            <i class="bi bi-snapchat"></i>
          {% endif %}
          {% if icon_link == 'icon-pinterest' %}
            <i class="bi bi-pinterest"></i>
          {% endif %}
          {% if icon_link == 'icon-vimeo' %}
            <i class="bi bi-vimeo"></i>
          {% endif %}
          <span class="d-none">{{ social }}</span>
        </a>
      </li>
    {% endif %}
  {% endfor %}
  {% if request.page_type == 'blog' or request.page_type == 'article' %}
    <li class="social-icons__item">
      <a class="social-icons__link" href="{{ shop.url }}{{ blog.url }}.atom">
        <i class="bi bi-rss"></i>
        <span class="d-none">RSS</span>
      </a>
    </li>
  {% endif %}
</ul>
