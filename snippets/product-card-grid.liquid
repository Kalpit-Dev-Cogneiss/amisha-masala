{% comment %}
  Renders a product card using "Grid" style
  Accepts:
  - max_height: {Number} Maximum height of the product's image (required)
  - product: {Object} Product Liquid object (required)
  - show_vendor: {Boolean} Show the product's vendor depending on the section setting (optional)

  Usage:
  {% render 'product-card-grid',
                            product: product,
                            image_position: image_position,
                            image_height: image_height,
                            show_quick_add: enable_quick_add
                    %}
{% endcomment %}

{% liquid
    assign product_has_only_one_variant = false
    if style_product != blank
        assign style_product_end = style_product
    else
        assign style_product_end = settings.style_products
    endif
%}
{% if style_product_end == 'style-1' %}
    <div class="{% unless product.available %} product-card-sold-out{% endunless %} product-card position-relative h-100 d-flex flex-column {% if settings.show_border %} settings-card p-2 rounded-{{ settings.border_radius }}{% endif %} style-v1">
        <div class="mb-3 card-img-top-wrap overflow-hidden position-relative">
            <a class="full-width-link" href="{{ product.url }}">
                <span class="d-none">{{ product.title }}</span>
            </a>
            {% if product.featured_media != null %}
                <div class="card-img-top position-relative hover-secondary-image style-hover-1 {% if image_height == 'adapt' %} card-adapt{% else %} card-img-custom-height {{ image_height }} {% endif %}">
                    {% render 'image', lazyload: true, image: product.featured_media, class: image_position %}

                    {% if product.media[1] != null %}
                        {% render 'image', lazyload: true, image: product.media[1], class: image_position %}
                    {% endif %}
                </div>
            {% endif %}
            {% if show_quick_add %}
                <div class="position-absolute bottom-0 end-0 start-0 w-100 flex-1 action-btn z-index-11">
                    <div
                            id="ProductSection-{{ section.id }}"
                            data-section-id="{{ section.id }}"
                            data-section-type="product"
                            data-enable-history-state="true"
                            data-ajax-enabled="{{ settings.enable_ajax }}"
                            class="card-button mt-2 {% if product.has_only_default_variant == false and product_has_only_one_variant != true %} active-popup custom-dropdown shadow-sm p-2{% endif %}"
                    >
                        {% if product.has_only_default_variant == false and product_has_only_one_variant != true %}
                            <div class="d-flex align-items-center justify-content-between mb-0">
                                <p class="fs-12-767 fs-14 mb-0 me-2 fw-bold">{{ 'products.product.choose_options' | t }}</p>
                                <button type="button" class="js-close-custom close-button style-body"><span
                                            class="d-none"></span></button>
                            </div>
                        {% endif %}
                        {% assign current_variant = product.selected_or_first_available_variant %}
                        {% form 'product', product, class: form_classes, novalidate: 'novalidate', data-product-form: '' %}
                            <select name="id" id="ProductSelect-{{ section.id }}"
                                    class="product-form__variants form-select {% if product.variants.size <= 1 %} d-none{% else %} d-block{% endif %}">
                                {% for variant in product.variants %}
                                    <option
                                            value="{{ variant.id }}"
                                            {% if variant == current_variant %}
                                                selected="selected"
                                            {% endif %}
                                    >
                                        {{ variant.title }}
                                        {% if variant.available == false %} - {{ 'products.product.sold_out' | t }}{% endif %}
                                    </option>
                                {% endfor %}
                            </select>
                            {% unless product.has_only_default_variant %}
                                <div class="product-form__controls-group d-none">
                                    {% for option in product.options_with_values %}
                                        <div class="selector-wrapper js product-form__item">
                                            <label
                                                    for="SingleOptionSelector-{{ product.id }}-{{ forloop.index0 }}"
                                                    class="label-option{{ forloop.index }}"
                                            >
                                                {{ option.name }}: <span data-variant-selected-name></span>
                                            </label>
                                            <select
                                                    class="single-option-selector single-option-selector-{{ section.id }} product-form__input"
                                                    id="SingleOptionSelector-{{ product.id }}-{{ forloop.index0 }}"
                                                    data-index="option{{ forloop.index }}"
                                            >
                                                {% for value in option.values %}
                                                    <option
                                                            value="{{ value | escape }}"
                                                            {% if option.selected_value == value %}
                                                                selected="selected"
                                                            {% endif %}
                                                    >
                                                        {{ value }}
                                                    </option>
                                                {% endfor %}
                                            </select>
                                        </div>
                                    {% endfor %}
                                </div>
                            {% endunless %}
                            <div
                                    class="d-none product-form__error-message-wrapper product-form__error-message-wrapper--hidden{% if section.settings.enable_payment_button %} product-form__error-message-wrapper--has-payment-button{% endif %}"
                                    data-error-message-wrapper
                                    role="alert"
                            >
                                <span class="d-none">{{ 'general.accessibility.error' | t }} </span>
                                <i class="bi bi-exclamation-circle"></i>
                                <span class="product-form__error-message" data-error-message>
              {{- 'products.product.quantity_minimum_message' | t -}}
            </span>
                            </div>
                            <input
                                    type="hidden"
                                    name="quantity"
                                    value="1"
                                    min="1"
                                    pattern="[0-9]*"
                                    class="product-form__input product-form__input--quantity"
                                    data-quantity-input
                            >
                            <button
                                    type="submit"
                                    name="add"
                                    {% unless current_variant.available %}
                                        aria-disabled="true"
                                    {% endunless %}
                                    aria-label="{% unless current_variant.available %}{{ 'products.product.sold_out' | t }}{% else %}{{ 'products.product.add_to_cart' | t }}{% endunless %}"
                                    class="btn btn-primary product-form__cart-submit me-2 mb-2 float-end"
                                    {% if settings.enable_ajax %}
                                        aria-haspopup="dialog"
                                    {% endif %}
                                    data-add-to-cart
                            >
            <span data-add-to-cart-text class="lh-1">
              {% unless current_variant.available %}
                  <i class="bi bi-bag-x fs-14"></i>
              {% else %}
                  <i class="bi bi-bag fs-14"></i>
              {% endunless %}
            </span>
                                <span class="hide" data-loader>
             <span class="icon-repeat"><i class="bi bi-arrow-repeat"></i></span>
            </span>
                            </button>
                        {% endform %}
                        <p
                                class="d-none"
                                data-loader-status
                                aria-live="assertive"
                                role="alert"
                                aria-hidden="true"
                        >
                            {{ 'products.product.loader_label' | t }}
                        </p>
                    </div>
                    {% if product.has_only_default_variant == false and product_has_only_one_variant != true %}
                        <button type="button"
                                class="float-end dropdown-button dropdown-button-icon btn btn-primary me-2 mb-2"></button>
                    {% endif %}
                    {% unless product == empty %}
                        <script type="application/json" id="ProductJson-{{ section.id }}">
                            {{ product | json }}</script>
                        <script type="application/json" id="ModelJson-{{ section.id }}">
                            {{ product.media | where: 'media_type', 'model' | json }}</script>
                    {% endunless %}
                </div>
            {% endif %}
            {%- if settings.enable_wishlist -%}
                <div class="position-absolute top-0 end-0 z-index-10 p-2">
                        {% render 'button-wishlist', product: product %}
                </div>
            {%- endif -%}
            <div class="position-absolute top-0 start-0 p-2">
                {% render 'product-badge', product: product %}
            </div>
        </div>
      
        <div class="card-content pb-0{% if settings.show_border == false %} px-2 px-lg-3{% endif %}">

            {% if settings.enable_rating_badge_stars %}
                <div class="star-wrap fs-12">
                    <!-- Start of Judge.me code -->
                    <div class='jdgm-widget jdgm-preview-badge'>
                        {{ product.metafields.judgeme.badge }}
                    </div>
                    <!-- End of Judge.me code -->
                </div>
            {% endif %}
            {% render 'product-vendor-type', product: product, show_vendor: settings.show_vendor %}
            <h3 class="fs-14-767 fs-18 card-product-title mb-2"
                aria-hidden="true"><a href="{{ product.url }}">{{ product.title }}</a></h3>
            <div class="d-flex flex-nowrap align-items-center">
                {% render 'product-price-listing', product: product %}
                {% if value != blank %}
                    <p class="opacity-85 fs-14 mb-0"><span class="mx-1">|</span>{{ value }}</p>
                {% endif %}
            </div>
            {%- if settings.enable_product_options -%}
                {% render 'product-card-options', product: product %}
            {%- endif -%}
        </div>
    </div>
{% endif %}
