{% style %}
    .section-extras-spacing-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --section-margin-top: {{ section.settings.margin_top }}px;
    --section-margin-bottom: {{ section.settings.margin_bottom }}px;
    }

    {% if section.settings.use_custom_colors %}
        .section-extras-color-{{ section.id }} {
        --gradient-background: {% if section.settings.color_background_gradient != blank %}{{ section.settings.color_background_gradient }}{% else %}{{ section.settings.color_background }}{% endif %};
        --color-background: {{ section.settings.color_background.red }}, {{ section.settings.color_background.green }}, {{ section.settings.color_background.blue }};
        --color-foreground: {{ section.settings.color_text.red }}, {{ section.settings.color_text.green }}, {{ section.settings.color_text.blue }};
        }
    {% endif %}
{% endstyle %}

<div
        class="
    position-relative icon-with-text-v1 overflow-hidden section-extras-spacing section-extras-spacing-{{ section.id }}
    {% if section.settings.use_custom_colors %} section-extras-color section-extras-color-{{ section.id }} {% endif %}
    {% if section.settings.custom_class != blank %} {{ section.settings.custom_class }}{% endif %}
  "
        {% if section.settings.custom_id != blank %}
            id="{{ section.settings.custom_id }}"
        {% endif %}
>
    <div class="section-{{ section.id }}-padding isolate {{ section.settings.layout }} position-relative">
        {% if section.settings.preheading != '' or section.settings.heading != '' or section.settings.subheading != '' %}
            <div class="cs-section-header d-flex justify-content-center">
              <div class="col-12 col-lg-10 text-center">
                {% render 'heading',
                        heading: section.settings.heading,
                        heading_tag: section.settings.heading_tag,
                        heading_size: section.settings.heading_size,
                        preheading: section.settings.preheading,
                        subheading: section.settings.subheading
                %}
              </div>

            </div>
        {% endif %}
        <div class="row d-flex align-items-center">
            <div class="col-12 col-lg-3">
                {% if section.settings.heading_1 != '' %}
                    <div class="mb-5 text-center text-lg-end" data-aos="fade-right" data-aos-delay="50">
                      <div class="d-flex flex-column flex-lg-row-reverse flex-nowrap hover-translate-x-2">
                        <div class="d-flex justify-content-center justify-content-lg-start icon m-0 mb-3 ms-lg-3">
                          {% if section.settings.icon_1 != '' or section.settings.image_1 != blank %}
                            <div
                                    class="img-width-medium"
                            >
                              {% if section.settings.image_1 != blank %}
                                {% render 'image', lazyload: true, image: section.settings.image_1 %}
                              {% else %}
                                <div class="fs-20">
                                  <i class="bi {{ section.settings.icon_1 }}"></i>
                                </div>
                              {% endif %}
                            </div>
                          {% endif %}
                        </div>
                        <div class="content">
                          {% if section.settings.heading_1 != '' %}
                            <h3 class="h5 mb-0">{{ section.settings.heading_1 }}</h3>
                          {% endif %}
                          {% if section.settings.subheading_1 != blank %}
                            <div class="rte fs-20 opacity-85 rte-inline">
                              {{ section.settings.subheading_1 }}
                            </div>
                          {% endif %}
                        </div>
                      </div>
                    </div>
                {% endif %}
              {% if section.settings.heading_2 != '' %}
                <div class="mb-5 text-center text-lg-end" data-aos="fade-right" data-aos-delay="100">
                  <div class="d-flex flex-column flex-lg-row-reverse flex-nowrap hover-translate-x-2">
                    <div class="d-flex justify-content-center justify-content-lg-start icon m-0 mb-3 ms-lg-3">
                      {% if section.settings.icon_2 != '' or section.settings.image_2 != blank %}
                        <div
                                class="img-width-medium"
                        >
                          {% if section.settings.image_2 != blank %}
                            {% render 'image', lazyload: true, image: section.settings.image_2 %}
                          {% else %}
                            <div class="fs-20">
                              <i class="bi {{ section.settings.icon_2 }}"></i>
                            </div>
                          {% endif %}
                        </div>
                      {% endif %}
                    </div>
                    <div class="content">
                      {% if section.settings.heading_2 != '' %}
                        <h3 class="h5 mb-0">{{ section.settings.heading_2 }}</h3>
                      {% endif %}
                      {% if section.settings.subheading_2 != blank %}
                        <div class="rte fs-20 opacity-85 rte-inline">
                          {{ section.settings.subheading_2 }}
                        </div>
                      {% endif %}
                    </div>
                  </div>
                </div>
              {% endif %}
              {% if section.settings.heading_3 != '' %}
                <div class="mb-5 text-center text-lg-end" data-aos="fade-right" data-aos-delay="150">
                  <div class="d-flex flex-column flex-lg-row-reverse flex-nowrap hover-translate-x-2">
                    <div class="d-flex justify-content-center justify-content-lg-start icon m-0 mb-3 ms-lg-3">
                      {% if section.settings.icon_3 != '' or section.settings.image_3 != blank %}
                        <div
                                class="img-width-medium"
                        >
                          {% if section.settings.image_3 != blank %}
                            {% render 'image', lazyload: true, image: section.settings.image_3 %}
                          {% else %}
                            <div class="fs-20">
                              <i class="bi {{ section.settings.icon_3 }}"></i>
                            </div>
                          {% endif %}
                        </div>
                      {% endif %}
                    </div>
                    <div class="content">
                      {% if section.settings.heading_3 != '' %}
                        <h3 class="h5 mb-0">{{ section.settings.heading_3 }}</h3>
                      {% endif %}
                      {% if section.settings.subheading_3 != blank %}
                        <div class="rte fs-20 opacity-85 rte-inline">
                          {{ section.settings.subheading_3 }}
                        </div>
                      {% endif %}
                    </div>
                  </div>
                </div>
              {% endif %}
            </div>
            <div class="col-12 col-lg-6">
                <div class="content-img animation-move" data-aos="fade-up">
                    {% if section.settings.image != blank %}
                        <div class="media-wrap">
                            {% render 'image-lg', lazyload: true, image: section.settings.image, class: 'w-100' %}
                        </div>
                    {% else %}
                        <div class="media-wrap">
                            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg bg-body-tertiary' }}
                        </div>
                    {% endif %}
                </div>
            </div>
            <div class="col-12 col-lg-3">
              {% if section.settings.heading_4 != '' %}
                <div class="mb-5 text-center text-lg-start" data-aos="fade-left" data-aos-delay="100">
                  <div class="d-flex flex-nowrap justify-content-center justify-content-lg-start flex-column flex-lg-row hover-translate-x">
                    <div class="icon me-0 mb-3 me-lg-3 d-flex justify-content-center justify-content-lg-start">
                      {% if section.settings.icon_4 != '' or section.settings.image_4 != blank %}
                        <div
                                class="img-width-medium"
                        >
                          {% if section.settings.image_4 != blank %}
                            {% render 'image', lazyload: true, image: section.settings.image_4 %}
                          {% else %}
                            <div class="fs-20">
                              <i class="bi {{ section.settings.icon_4 }}"></i>
                            </div>
                          {% endif %}
                        </div>
                      {% endif %}
                    </div>
                    <div class="content">
                      {% if section.settings.heading_4 != '' %}
                        <h3 class="h5 mb-0">{{ section.settings.heading_4 }}</h3>
                      {% endif %}
                      {% if section.settings.subheading_4 != blank %}
                        <div class="rte fs-20 opacity-85 rte-inline">
                          {{ section.settings.subheading_4 }}
                        </div>
                      {% endif %}
                    </div>
                  </div>
                </div>
              {% endif %}
              {% if section.settings.heading_5 != '' %}
                <div class="mb-5 text-center text-lg-start" data-aos="fade-left" data-aos-delay="100">
                  <div class="d-flex flex-nowrap justify-content-center justify-content-lg-start flex-column flex-lg-row hover-translate-x">
                    <div class="icon me-0 mb-3 me-lg-3 d-flex justify-content-center justify-content-lg-start">
                      {% if section.settings.icon_5 != '' or section.settings.image_5 != blank %}
                        <div
                                class="img-width-medium"
                        >
                          {% if section.settings.image_5 != blank %}
                            {% render 'image', lazyload: true, image: section.settings.image_5 %}
                          {% else %}
                            <div class="fs-20">
                              <i class="bi {{ section.settings.icon_5 }}"></i>
                            </div>
                          {% endif %}
                        </div>
                      {% endif %}
                    </div>
                    <div class="content">
                      {% if section.settings.heading_5 != '' %}
                        <h3 class="h5 mb-0">{{ section.settings.heading_5 }}</h3>
                      {% endif %}
                      {% if section.settings.subheading_5 != blank %}
                        <div class="rte fs-20 opacity-85 rte-inline">
                          {{ section.settings.subheading_5 }}
                        </div>
                      {% endif %}
                    </div>
                  </div>
                </div>
              {% endif %}
              {% if section.settings.heading_6 != '' %}
                <div class="mb-5 text-center text-lg-start" data-aos="fade-left" data-aos-delay="150">
                  <div class="d-flex flex-nowrap justify-content-center justify-content-lg-start flex-column flex-lg-row hover-translate-x">
                    <div class="icon me-0 mb-3 me-lg-3 d-flex justify-content-center justify-content-lg-start">
                      {% if section.settings.icon_6 != '' or section.settings.image_6 != blank %}
                        <div
                                class="img-width-medium"
                        >
                          {% if section.settings.image_6 != blank %}
                            {% render 'image', lazyload: true, image: section.settings.image_6 %}
                          {% else %}
                            <div class="fs-20">
                              <i class="bi {{ section.settings.icon_6 }}"></i>
                            </div>
                          {% endif %}
                        </div>
                      {% endif %}
                    </div>
                    <div class="content">
                      {% if section.settings.heading_6 != '' %}
                        <h3 class="h5 mb-0">{{ section.settings.heading_6 }}</h3>
                      {% endif %}
                      {% if section.settings.subheading_6 != blank %}
                        <div class="rte fs-20 opacity-85 rte-inline">
                          {{ section.settings.subheading_6 }}
                        </div>
                      {% endif %}
                    </div>
                  </div>
                </div>
              {% endif %}

            </div>
        </div>
        {% if section.settings.show_read_more %}
            <div class="text-center pb-3 pb-lg-4">
                <a
                        {% if section.settings.button_link == blank %}
                            role="link" aria-disabled="true"
                        {% else %}
                            href="{{ section.settings.button_link }}"
                        {% endif %}
                        class="btn btn-{{ section.settings.button_style }}"
                >
                    <span>{{- section.settings.button_label | escape -}}</span>
                </a>
            </div>
        {% endif %}
    </div>
</div>

