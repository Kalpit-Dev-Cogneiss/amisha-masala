{% comment %}
  Amisha Masala - product recommendations ("You may also like").
  Uses Shopify's recommendations API (same mechanism as the theme's related products) and falls back to the Spices collection.
{% endcomment %}
<section id="AmReco-{{ section.id }}" class="am-reco">
  <div class="container page-width">
    <header class="reco-head">
      <span class="am-eyebrow am-eyebrow--center" data-reveal>{{ section.settings.eyebrow | escape }}</span>
      <h2 class="am-title" data-reveal style="--i: 1;">{{ section.settings.heading | escape }}</h2>
    </header>

    <product-recommendations
      class="product-recommendations reco-wrap"
      data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}"
    >
      {%- assign reco_list = blank -%}
      {%- if recommendations.performed? and recommendations.products_count > 0 -%}
        {%- assign reco_list = recommendations.products -%}
      {%- elsif recommendations.performed? -%}
        {%- assign reco_list = collections['spices'].products -%}
      {%- endif -%}
      {%- if reco_list != blank -%}
        <div class="reco-grid">
          {%- assign shown = 0 -%}
          {%- for item in reco_list -%}
            {%- if item.id != product.id and shown < section.settings.products_to_show -%}
              <div class="reco-item">
                <div class="card-wrapper card-product w-100 h-100">
                  {% render 'product-card-grid', product: item, image_position: 'object_position_middle_center', image_height: 'adapt', show_quick_add: false %}
                </div>
              </div>
              {%- assign shown = shown | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </product-recommendations>

    <div class="reco-more" data-reveal>
      <a class="am-btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} <i class="bi bi-arrow-right"></i></a>
    </div>
  </div>
</section>

<style>
  #AmReco-{{ section.id }} { padding: clamp(60px, 7vw, 110px) 0; background: var(--am-cream); }
  #AmReco-{{ section.id }} .reco-head { text-align: center; margin-bottom: clamp(30px, 4vw, 56px); }
  #AmReco-{{ section.id }} .reco-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  #AmReco-{{ section.id }} .reco-item .card-wrapper {
    overflow: hidden;
    border-radius: 24px;
    background: #fff;
    box-shadow: 0 18px 40px rgba(74, 8, 8, 0.12);
    transition: transform 0.45s var(--am-ease), box-shadow 0.45s;
  }
  #AmReco-{{ section.id }} .reco-item:hover .card-wrapper { transform: translateY(-10px); box-shadow: 0 30px 60px rgba(74, 8, 8, 0.26); }
  #AmReco-{{ section.id }} .reco-more { margin-top: clamp(30px, 4vw, 52px); text-align: center; }
  @media (max-width: 1100px) { #AmReco-{{ section.id }} .reco-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 767px) { #AmReco-{{ section.id }} .reco-grid { grid-template-columns: repeat(2, 1fr); gap: 14px; } }
</style>

{% schema %}
{
  "name": "Amisha - Recommendations",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "More to explore" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 10, "step": 1, "default": 8, "label": "Products to show" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View all spices" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Amisha - Recommendations" }]
}
{% endschema %}
