{% style %}
    .section-extras-spacing-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --section-margin-top: {{ section.settings.margin_top }}px;
    --section-margin-bottom: {{ section.settings.margin_bottom }}px;
    }
    {% if section.settings.use_custom_colors %}
        .section-extras-color-{{ section.id }} {
        --gradient-background: {% if section.settings.color_background_gradient != blank %}{{ section.settings.color_background_gradient }}{% else %}{{ section.settings.color_background }}{% endif %};
        --color-background: {{ section.settings.color_background.red }}, {{ section.settings.color_background.green }}, {{ section.settings.color_background.blue }};
        --color-foreground: {{ section.settings.color_text.red }}, {{ section.settings.color_text.green }}, {{ section.settings.color_text.blue }};
        }
    {% endif %}
{% endstyle %}

<div
        class="position-relative banner-creative-v4 overflow-hidden section-extras-spacing section-extras-spacing-{{ section.id }}

    {% if section.settings.custom_class != blank %} {{ section.settings.custom_class }}{% endif %}
  "
        {% if section.settings.custom_id != blank %}
            id="{{ section.settings.custom_id }}"
        {% endif %}
>
    <div class="{{ section.settings.layout }}">

        <div class="cs-section-header {{ section.settings.heading_alignment }}">
            {% render 'heading',
                    heading: section.settings.heading,
                    class: 'heading',
                    heading_alignment: section.settings.heading_alignment,
                    heading_tag: section.settings.heading_tag,
                    heading_size: section.settings.heading_size,
                    preheading: section.settings.preheading,
                    subheading: section.settings.subheading
            %}
        </div>
        <div class="creative-banner {% if section.settings.use_custom_colors %} section-extras-color section-extras-color-{{ section.id }} {% endif %}">
            <div class="row row-cols-1 row-cols-lg-2 row-height" style="min-height: {{ section.settings.banner_height }}px">
                <div class="col col-height" style="min-height: {{ section.settings.banner_height }}px;">
                    <div class="item-1 position-relative h-100 hover-style-1 card-hover-overlay-dark">
                        {% if section.settings.button_link_1 %}
                            <a class="full-width-link" href="{{ section.settings.button_link_1 }}">
                                <span class="d-none">{{ section.settings.heading_1 }}</span>
                            </a>
                        {% endif %}
                        {% if section.settings.image_1 != blank %}
                            {% render 'image', lazyload: true, image: section.settings.image_1 %}
                        {% else %}
                            {{ 'image' | placeholder_svg_tag: 'placeholder-svg bg-body-tertiary' }}
                        {% endif %}
                        {% if section.settings.heading_1 != '' or section.settings.subheading_1 != '' %}
                        <div class="card-content position-absolute bottom-0 start-0 z-2 p-4">
                          {% if section.settings.heading_1 != '' %}
                          <h3 class="h3 mb-0">{{ section.settings.heading_1 }}</h3>
                          {% endif %}
                          {% if section.settings.subheading_1 != '' %}
                            <div class="rte rte-custom mt-2">{{ section.settings.subheading_1 }}</div>
                          {% endif %}
                        </div>
                        {% endif %}
                    </div>
                </div>
                <div class="col">
                    <div class="row row-cols-1 h-100">
                        <div class="col mb-4 h-50">
                            <div class="item-2 position-relative h-100 hover-style-1 card-hover-overlay-dark">
                                {% if section.settings.button_link_2 %}
                                    <a class="full-width-link" href="{{ section.settings.button_link_2 }}">
                                        <span class="d-none">{{ section.settings.heading_2 }}</span>
                                    </a>
                                {% endif %}
                                {% if section.settings.image_2 != blank %}
                                    {% render 'image', lazyload: true, image: section.settings.image_2 %}
                                {% else %}
                                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg bg-body-tertiary' }}
                                {% endif %}
                              {% if section.settings.heading_2 != '' or section.settings.subheading_2 != '' %}
                                <div class="card-content position-absolute bottom-0 start-0 z-2 p-4">
                                  {% if section.settings.heading_2 != '' %}
                                    <h3 class="h3 mb-0">{{ section.settings.heading_2 }}</h3>
                                  {% endif %}
                                  {% if section.settings.subheading_2 != '' %}
                                    <div class="rte rte-custom mt-2">{{ section.settings.subheading_2 }}</div>
                                  {% endif %}
                                </div>
                              {% endif %}
                            </div>
                        </div>
                        <div class="col h-50">
                            <div class="row row-cols-1 row-cols-sm-2 h-100">
                                <div class="col mb-4">
                                    <div class="item-3 position-relative h-100 hover-style-1 card-hover-overlay-dark">
                                        {% if section.settings.button_link_3 %}
                                            <a class="full-width-link" href="{{ section.settings.button_link_3 }}">
                                                <span class="d-none">{{ section.settings.heading_3 }}</span>
                                            </a>
                                        {% endif %}
                                        {% if section.settings.image_3 != blank %}
                                            {% render 'image', lazyload: true, image: section.settings.image_3 %}
                                        {% else %}
                                            {{ 'image' | placeholder_svg_tag: 'placeholder-svg bg-body-tertiary' }}
                                        {% endif %}
                                      {% if section.settings.heading_3 != '' or section.settings.subheading_3 != '' %}
                                        <div class="card-content position-absolute bottom-0 start-0 z-2 p-4">
                                          {% if section.settings.heading_3 != '' %}
                                            <h3 class="h4 mb-0">{{ section.settings.heading_3 }}</h3>
                                          {% endif %}
                                          {% if section.settings.subheading_3 != '' %}
                                            <div class="rte rte-custom mt-2">{{ section.settings.subheading_3 }}</div>
                                          {% endif %}
                                        </div>
                                      {% endif %}
                                    </div>
                                </div>
                                <div class="col mb-4">
                                    <div class="item-4 position-relative h-100 hover-style-1 card-hover-overlay-dark">
                                        {% if section.settings.button_link_4 %}
                                            <a class="full-width-link" href="{{ section.settings.button_link_4 }}">
                                                <span class="d-none">{{ section.settings.heading_4 }}</span>
                                            </a>
                                        {% endif %}
                                        {% if section.settings.image_4 != blank %}
                                            {% render 'image', lazyload: true, image: section.settings.image_4 %}
                                        {% else %}
                                            {{ 'image' | placeholder_svg_tag: 'placeholder-svg bg-body-tertiary' }}
                                        {% endif %}
                                      {% if section.settings.heading_4 != '' or section.settings.subheading_4 != '' %}
                                        <div class="card-content position-absolute bottom-0 start-0 z-2 p-4">
                                          {% if section.settings.heading_4 != '' %}
                                            <h3 class="h4 mb-0">{{ section.settings.heading_4 }}</h3>
                                          {% endif %}
                                          {% if section.settings.subheading_4 != '' %}
                                            <div class="rte rte-custom mt-2">{{ section.settings.subheading_4 }}</div>
                                          {% endif %}
                                        </div>
                                      {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
