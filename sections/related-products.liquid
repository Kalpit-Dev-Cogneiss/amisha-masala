{% style %}
    .section-extras-spacing-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --section-margin-top: {{ section.settings.margin_top }}px;
    --section-margin-bottom: {{ section.settings.margin_bottom }}px;
    }

    {% if section.settings.use_custom_colors %}
        .section-extras-color-{{ section.id }} {
        --gradient-background: {% if section.settings.color_background_gradient != blank %}{{ section.settings.color_background_gradient }}{% else %}{{ section.settings.color_background }}{% endif %};
        --color-background: {{ section.settings.color_background.red }}, {{ section.settings.color_background.green }}, {{ section.settings.color_background.blue }};
        --color-foreground: {{ section.settings.color_text.red }}, {{ section.settings.color_text.green }}, {{ section.settings.color_text.blue }};
        }
    {% endif %}
{% endstyle %}
<div
        class="
    section-extras-spacing section-extras-spacing-{{ section.id }}
    {% if section.settings.use_custom_colors %} section-extras-color section-extras-color-{{ section.id }} {% endif %}
    {% if section.settings.custom_class != blank %} {{ section.settings.custom_class }}{% endif %}
  "
        {% if section.settings.custom_id != blank %}
          id="{{ section.settings.custom_id }}"
        {% endif %}
>
    <product-recommendations
            class="product-recommendations section-{{ section.id }}-padding isolate"
            data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}&intent=related"
    >
        {%- if recommendations.performed? and recommendations.products_count > 0 -%}
            <div class="{{ section.settings.layout }} position-relative">
                <div class="row">
                    <div class="col-12 col-lg-12">
                        {% if section.settings.heading %}
                            <div class="heading heading-wrap {{ section.settings.heading_alignment }}">
                                {% render 'h-heading',
                                        heading: section.settings.heading,
                                        heading_tag: section.settings.heading_tag,
                                        heading_size: section.settings.heading_size
                                %}
                            </div>
                        {% endif %}
                    </div>
                    <div class="col-12 col-lg-12">
                        <div
                                class="
                grid product-grid
                row gx-{{ section.settings.gutter }}
                row-cols-{{ section.settings.columns_mobile }}
                row-cols-md-{{ section.settings.columns_tablet }}
                row-cols-lg-{{ section.settings.columns_desktop }}
              "
                        >
                            {% for recommendation in recommendations.products %}
                                <div
                                        class="col position-relative mb-{{ section.settings.gutter }}"
                                >
                                    <div class="card-wrapper card-product w-100 h-100">
                                        {% render 'product-card-grid',
                                                product: recommendation,
                                                image_position: section.settings.image_position,
                                                image_height: section.settings.image_height,
                                                show_quick_add: section.settings.enable_quick_add
                                        %}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        {%- endif -%}
    </product-recommendations>
</div>

