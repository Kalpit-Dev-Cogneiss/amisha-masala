{% comment %}
  Amisha Masala - customer reviews.
  - Shows reviews stored on the product in the "Customer reviews" JSON field (custom.reviews):
      [{"name": "...", "rating": 5, "title": "...", "text": "...", "date": "2026-10-19"}]
  - "Write a review" opens a form. It is sent to the store by email (Shopify contact form) for approval; nothing is published automatically.
  - A review app (Judge.me, Loox, etc.) can also be added as an app block inside this section.
{% endcomment %}
{%- liquid
  assign reviews = product.metafields.custom.reviews.value
  assign total = 0
  assign sum = 0
  assign c5 = 0
  assign c4 = 0
  assign c3 = 0
  assign c2 = 0
  assign c1 = 0
  if reviews != blank
    for r in reviews
      assign rating = r.rating | plus: 0
      if rating >= 1 and rating <= 5
        assign total = total | plus: 1
        assign sum = sum | plus: rating
        case rating
          when 5
            assign c5 = c5 | plus: 1
          when 4
            assign c4 = c4 | plus: 1
          when 3
            assign c3 = c3 | plus: 1
          when 2
            assign c2 = c2 | plus: 1
          when 1
            assign c1 = c1 | plus: 1
        endcase
      endif
    endfor
  endif
  if total > 0
    assign average = sum | times: 1.0 | divided_by: total | round: 1
  endif
-%}
<section id="AmRV-{{ section.id }}" class="am-rv">
  <div class="container page-width">
    <header class="rv-head">
      <span class="am-eyebrow am-eyebrow--center" data-reveal>Reviews</span>
      <h2 class="am-title" data-reveal style="--i: 1;">{{ section.settings.heading | escape }}</h2>
    </header>

    <div class="rv-layout">
      <aside class="rv-summary" data-reveal="left">
        {%- if total > 0 -%}
          <div class="rv-avg">
            <span class="rv-avg__num">{{ average }}</span>
            <span class="rv-avg__stars" aria-label="{{ average }} out of 5">
              {%- for i in (1..5) -%}
                {%- assign diff = average | minus: i -%}
                {%- if diff >= 0 -%}<i class="bi bi-star-fill"></i>{%- elsif diff > -1 and diff <= -0.3 -%}<i class="bi bi-star-half"></i>{%- else -%}<i class="bi bi-star"></i>{%- endif -%}
              {%- endfor -%}
            </span>
            <span class="rv-avg__count">Based on {{ total }} review{% if total != 1 %}s{% endif %}</span>
          </div>
          <ul class="rv-bars">
            {%- for n in (1..5) reversed -%}
              {%- case n -%}{%- when 5 -%}{%- assign cnt = c5 -%}{%- when 4 -%}{%- assign cnt = c4 -%}{%- when 3 -%}{%- assign cnt = c3 -%}{%- when 2 -%}{%- assign cnt = c2 -%}{%- else -%}{%- assign cnt = c1 -%}{%- endcase -%}
              <li><span>{{ n }} <i class="bi bi-star-fill"></i></span><span class="rv-bar"><span style="width: {{ cnt | times: 100.0 | divided_by: total | round }}%;"></span></span><span>{{ cnt }}</span></li>
            {%- endfor -%}
          </ul>
        {%- else -%}
          <div class="rv-avg rv-avg--empty">
            <span class="rv-avg__stars rv-avg__stars--empty"><i class="bi bi-star"></i><i class="bi bi-star"></i><i class="bi bi-star"></i><i class="bi bi-star"></i><i class="bi bi-star"></i></span>
            <span class="rv-avg__count">No reviews yet</span>
          </div>
        {%- endif -%}
        <button type="button" class="am-btn" data-rv-open>Write a review <i class="bi bi-pencil-square"></i></button>
      </aside>

      <div class="rv-list" data-reveal="right">
        {%- if total > 0 -%}
          <div class="rv-grid">
            {%- for r in reviews -%}
              {%- assign rating = r.rating | plus: 0 -%}
              {%- if rating >= 1 and rating <= 5 -%}
                <article class="rv-card">
                  <header>
                    <span class="rv-card__avatar">{{ r.name | strip | slice: 0, 1 | upcase | escape }}</span>
                    <span class="rv-card__who"><strong>{{ r.name | escape }}</strong>{% if r.date != blank %}<small>{{ r.date | escape }}</small>{% endif %}</span>
                  </header>
                  <span class="rv-card__stars" aria-label="{{ rating }} out of 5">
                    {%- for i in (1..5) -%}{%- if i <= rating -%}<i class="bi bi-star-fill"></i>{%- else -%}<i class="bi bi-star"></i>{%- endif -%}{%- endfor -%}
                  </span>
                  {%- if r.title != blank -%}<h3>{{ r.title | escape }}</h3>{%- endif -%}
                  <p>{{ r.text | escape }}</p>
                </article>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- else -%}
          <div class="rv-empty">
            <span class="rv-empty__icon"><i class="bi bi-chat-quote-fill"></i></span>
            <h3>Be the first to review {{ product.title | escape }}</h3>
            <p>Have you tried it? Share your experience and help other customers choose. Reviews are published after we approve them.</p>
          </div>
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}
            <div class="rv-app" {{ block.shopify_attributes }}>{% render block %}</div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  <dialog class="rv-modal" id="AmRVModal-{{ section.id }}" aria-labelledby="AmRVTitle-{{ section.id }}">
    <div class="rv-modal__box">
      <button type="button" class="rv-modal__close" data-rv-close aria-label="Close">&times;</button>
      <h3 id="AmRVTitle-{{ section.id }}" class="rv-modal__title">Write a review</h3>
      <p class="rv-modal__product">{{ product.title | escape }}</p>
      {%- form 'contact', id: 'AmRVForm', class: 'rv-form' -%}
        <input type="hidden" name="contact[Enquiry type]" value="Product review">
        <input type="hidden" name="contact[Product]" value="{{ product.title | escape }}">
        <input type="hidden" name="contact[Product link]" value="{{ shop.url }}{{ product.url }}">
        <div class="rv-form__field">
          <span class="rv-form__label">Your rating *</span>
          <div class="rv-stars">
            {%- for n in (1..5) reversed -%}
              <input type="radio" name="contact[Rating]" id="rv-{{ section.id }}-{{ n }}" value="{{ n }}" {% if n == 5 %}required{% endif %}>
              <label for="rv-{{ section.id }}-{{ n }}" title="{{ n }} star{% if n > 1 %}s{% endif %}"><i class="bi bi-star-fill"></i></label>
            {%- endfor -%}
          </div>
        </div>
        <div class="rv-form__row">
          <label>Name *<input type="text" name="contact[name]" required autocomplete="name"></label>
          <label>Email *<input type="email" name="contact[email]" required autocomplete="email"></label>
        </div>
        <label>Review title<input type="text" name="contact[Review title]" maxlength="80"></label>
        <label>Your review *<textarea name="contact[body]" rows="5" required></textarea></label>
        <p class="rv-form__note">Reviews are checked by our team before they are published. Your email is not shown.</p>
        <p class="rv-form__error" data-rv-error hidden>Could not send. Please try again or call {{ section.settings.phone | escape }}.</p>
        <button type="submit" class="am-btn" data-rv-submit>Submit review <i class="bi bi-send-fill"></i></button>
      {%- endform -%}
      <div class="rv-modal__done" data-rv-done hidden>
        <span class="rv-empty__icon"><i class="bi bi-check-lg"></i></span>
        <h3>Thank you!</h3>
        <p>We have received your review. It will appear here once approved.</p>
        <button type="button" class="am-btn" data-rv-close>Close</button>
      </div>
    </div>
  </dialog>
</section>

<style>
  #AmRV-{{ section.id }} { padding: clamp(60px, 7vw, 110px) 0; background: #fff; }
  #AmRV-{{ section.id }} .rv-head { text-align: center; margin-bottom: clamp(30px, 4vw, 56px); }
  #AmRV-{{ section.id }} .rv-layout { display: grid; grid-template-columns: 340px 1fr; gap: clamp(26px, 3vw, 48px); align-items: start; }
  #AmRV-{{ section.id }} .rv-summary {
    padding: 34px 30px;
    border-radius: 30px;
    background: var(--am-cream);
    box-shadow: inset 0 0 0 1px rgba(74, 8, 8, 0.08);
    display: grid;
    gap: 26px;
    justify-items: start;
  }
  #AmRV-{{ section.id }} .rv-avg { display: grid; gap: 8px; }
  #AmRV-{{ section.id }} .rv-avg__num { font-family: var(--bs-font-heading-family); font-size: 78px; line-height: 1; color: var(--am-red); }
  #AmRV-{{ section.id }} .rv-avg__stars { display: inline-flex; gap: 4px; font-size: 22px; color: var(--am-gold); }
  #AmRV-{{ section.id }} .rv-avg__stars--empty { color: #cdbd9a; }
  #AmRV-{{ section.id }} .rv-avg__count { font-size: 15px; font-weight: 600; color: #5a4848; }
  #AmRV-{{ section.id }} .rv-bars { width: 100%; margin: 0; padding: 0; list-style: none; display: grid; gap: 10px; }
  #AmRV-{{ section.id }} .rv-bars li { display: grid; grid-template-columns: 40px 1fr 24px; align-items: center; gap: 10px; font-size: 14px; font-weight: 600; color: #5a4848; }
  #AmRV-{{ section.id }} .rv-bars i { color: var(--am-gold); font-size: 12px; }
  #AmRV-{{ section.id }} .rv-bar { height: 8px; border-radius: 999px; background: #e7dcc3; overflow: hidden; }
  #AmRV-{{ section.id }} .rv-bar span { display: block; height: 100%; border-radius: 999px; background: linear-gradient(90deg, var(--am-gold), var(--am-red)); }

  #AmRV-{{ section.id }} .rv-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 22px; }
  #AmRV-{{ section.id }} .rv-card {
    padding: 28px;
    border-radius: 26px;
    background: #fff;
    box-shadow: 0 20px 44px rgba(74, 8, 8, 0.12);
    border: 1px solid #f1e7d2;
    transition: transform 0.4s var(--am-ease), box-shadow 0.4s;
  }
  #AmRV-{{ section.id }} .rv-card:hover { transform: translateY(-8px); box-shadow: 0 30px 60px rgba(74, 8, 8, 0.22); }
  #AmRV-{{ section.id }} .rv-card header { display: flex; align-items: center; gap: 14px; margin-bottom: 14px; }
  #AmRV-{{ section.id }} .rv-card__avatar { width: 46px; height: 46px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-family: var(--bs-font-heading-family); font-size: 20px; color: #fff; background: linear-gradient(135deg, var(--am-red), #a30f0f); }
  #AmRV-{{ section.id }} .rv-card__who { display: grid; line-height: 1.3; }
  #AmRV-{{ section.id }} .rv-card__who small { color: #8a7a7a; }
  #AmRV-{{ section.id }} .rv-card__stars { display: inline-flex; gap: 3px; margin-bottom: 10px; color: var(--am-gold); font-size: 16px; }
  #AmRV-{{ section.id }} .rv-card h3 { margin: 0 0 8px; font-family: var(--bs-font-heading-family); font-size: 20px; color: var(--am-ink); }
  #AmRV-{{ section.id }} .rv-card p { margin: 0; font-size: 16px; line-height: 1.65; color: #4b3a3a; }
  #AmRV-{{ section.id }} .rv-empty { text-align: center; padding: clamp(36px, 5vw, 64px) 28px; border-radius: 30px; border: 2px dashed #e1c88a; background: #fffaf0; }
  #AmRV-{{ section.id }} .rv-empty__icon { display: inline-flex; align-items: center; justify-content: center; width: 72px; height: 72px; margin-bottom: 16px; border-radius: 50%; font-size: 30px; color: #3a0606; background: linear-gradient(135deg, var(--am-gold-soft), var(--am-gold)); box-shadow: 0 0 0 9px rgba(245, 184, 61, 0.2); }
  #AmRV-{{ section.id }} .rv-empty h3 { margin: 0 0 10px; font-family: var(--bs-font-heading-family); font-size: clamp(22px, 2.2vw, 32px); color: var(--am-ink); }
  #AmRV-{{ section.id }} .rv-empty p { max-width: 520px; margin: 0 auto; font-size: 16.5px; line-height: 1.65; color: #5a4848; }
  #AmRV-{{ section.id }} .rv-app { margin-top: 28px; }

  /* modal */
  .rv-modal { border: 0; padding: 0; width: calc(100% - 32px); max-width: 600px; border-radius: 28px; }
  .rv-modal::backdrop { background: rgba(23, 2, 2, 0.6); }
  .rv-modal__box { position: relative; padding: 34px; max-height: 90vh; overflow: auto; }
  .rv-modal__close { position: absolute; top: 10px; right: 18px; border: 0; background: none; font-size: 32px; line-height: 1; cursor: pointer; }
  .rv-modal__title { margin: 0 0 4px; font-family: var(--bs-font-heading-family); font-size: 32px; }
  .rv-modal__product { margin: 0 0 20px; font-weight: 700; color: var(--am-red); }
  .rv-form { display: grid; gap: 16px; }
  .rv-form label, .rv-form__label { display: grid; gap: 6px; font-size: 13px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #4b3a3a; }
  .rv-form__row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .rv-form input[type="text"], .rv-form input[type="email"], .rv-form textarea { width: 100%; padding: 13px 16px; border: 2px solid #eadfcf; border-radius: 14px; background: #fbf8f1; font: inherit; font-size: 16px; letter-spacing: 0; text-transform: none; }
  .rv-form input:focus, .rv-form textarea:focus { outline: 0; border-color: var(--am-red); background: #fff; }
  .rv-stars { position: relative; display: inline-flex; flex-direction: row-reverse; justify-content: flex-end; gap: 6px; }
  .rv-stars input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .rv-stars label { font-size: 34px; line-height: 1; color: #ddd2bb; cursor: pointer; letter-spacing: 0; text-transform: none; transition: color 0.2s, transform 0.2s; }
  .rv-stars label:hover, .rv-stars label:hover ~ label, .rv-stars input:checked ~ label { color: var(--am-gold); }
  .rv-stars label:hover { transform: scale(1.15); }
  .rv-stars input:focus-visible + label { outline: 2px solid var(--am-red); border-radius: 6px; }
  .rv-form__note { margin: 0; font-size: 13px; color: #6b5a5a; }
  .rv-form__error { margin: 0; color: #b00020; font-size: 14px; }
  .rv-form .am-btn { justify-self: start; }
  .rv-modal__done { text-align: center; padding: 20px 0; }
  .rv-modal__done h3 { font-family: var(--bs-font-heading-family); font-size: 30px; margin: 0 0 8px; }
  .rv-modal__done p { margin: 0 0 20px; color: #5a4848; }
  .rv-modal__done .rv-empty__icon { display: inline-flex; align-items: center; justify-content: center; width: 72px; height: 72px; margin-bottom: 16px; border-radius: 50%; font-size: 30px; color: #3a0606; background: linear-gradient(135deg, var(--am-gold-soft), var(--am-gold)); }

  @media (max-width: 991px) {
    #AmRV-{{ section.id }} .rv-layout { grid-template-columns: 1fr; }
    #AmRV-{{ section.id }} .rv-summary { justify-items: stretch; }
  }
  @media (max-width: 640px) {
    #AmRV-{{ section.id }} .rv-grid { grid-template-columns: 1fr; }
    .rv-form__row { grid-template-columns: 1fr; }
    .rv-modal__box { padding: 26px 20px; }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('AmRV-{{ section.id }}');
    var dlg = document.getElementById('AmRVModal-{{ section.id }}');
    if (!root || !dlg) return;
    var form = dlg.querySelector('form');
    var done = dlg.querySelector('[data-rv-done]');
    var err = dlg.querySelector('[data-rv-error]');
    var btn = dlg.querySelector('[data-rv-submit]');
    root.querySelector('[data-rv-open]').addEventListener('click', function () {
      form.hidden = false; done.hidden = true; err.hidden = true;
      dlg.showModal();
    });
    dlg.addEventListener('click', function (e) {
      if (e.target === dlg || e.target.closest('[data-rv-close]')) dlg.close();
    });
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      err.hidden = true; btn.disabled = true;
      fetch(form.action, { method: 'POST', body: new FormData(form), credentials: 'same-origin' })
        .then(function (res) {
          if (/[?&]contact_posted=true/.test(res.url)) { form.reset(); form.hidden = true; done.hidden = false; }
          else if (/challenge/.test(res.url)) { form.submit(); }
          else { err.hidden = false; }
        })
        .catch(function () { err.hidden = false; })
        .then(function () { btn.disabled = false; });
    });
  })();
</script>

{% schema %}
{
  "name": "Amisha - Reviews",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Customer Reviews" },
    { "type": "text", "id": "phone", "label": "Phone number shown if sending fails", "default": "+91-757 303 0683" }
  ],
  "blocks": [
    { "type": "@app" }
  ],
  "presets": [{ "name": "Amisha - Reviews" }]
}
{% endschema %}
