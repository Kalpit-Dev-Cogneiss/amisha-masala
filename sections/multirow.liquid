{% style %}
    .section-extras-spacing-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --section-margin-top: {{ section.settings.margin_top }}px;
    --section-margin-bottom: {{ section.settings.margin_bottom }}px;
    }
    {% if section.settings.use_custom_colors %}
        .section-extras-color-{{ section.id }} {
        --gradient-background: {% if section.settings.color_background_gradient != blank %}{{ section.settings.color_background_gradient }}{% else %}{{ section.settings.color_background }}{% endif %};
        --color-background: {{ section.settings.color_background.red }}, {{ section.settings.color_background.green }}, {{ section.settings.color_background.blue }};
        --color-foreground: {{ section.settings.color_text.red }}, {{ section.settings.color_text.green }}, {{ section.settings.color_text.blue }};
        }
    {% endif %}
{% endstyle %}

<div
        class="
    multirow section-extras-spacing section-extras-spacing-{{ section.id }}
    {% if section.settings.use_custom_colors %} section-extras-color section-extras-color-{{ section.id }} {% endif %}
    {% if section.settings.custom_class != blank %} {{ section.settings.custom_class }}{% endif %} {{ section.settings.style_slider }}
  "
        {% if section.settings.custom_id != blank %}
            id="{{ section.settings.custom_id }}"
        {% endif %}
>
    <div class="{{ section.settings.layout }} position-relative">
        <div class="{% if section.settings.enable_slider %}hero-slider position-static {% if section.settings.pagination_align == 'middle-right' %}action-slider-2{% endif %}{% else %} clearfix{% endif %}">
            <div
                    class="{% if section.settings.enable_slider %}swiper-container overflow-hidden{% else %} clearfix {% endif %}"
                    {% if section.settings.enable_slider %}
                        data-slide='
            {
                      "slidesPerView": 1,
                        {% if section.settings.auto_rotate %}
            "autoplay": {"delay": {{ section.settings.change_slides_speed }}000},
            {% endif %}
            "speed": 400,
            "loop": {{ section.settings.loop }},
                      "autoHeight": true,
                      "spaceBetween": 0,
                      {% if section.settings.enable_navigation %}
                              "navigation": {"nextEl": ".cs-swiper-button-next{{ section.id }}", "prevEl": ".cs-swiper-button-prev{{ section.id }}"},
                              {% endif %}
                              {% if section.settings.enable_pagination %}
                              "pagination": {
                                "el": ".swiper-pagination",
                                 {% if section.settings.slider_visual != blank and section.settings.slider_visual != 'bullets' %}
                                 "type": "{{ section.settings.slider_visual }}",
                                 {% endif %}
                                 {% if section.settings.slider_visual == 'bullets' %}
                                  "dynamicBullets": "true",
                                 {% endif %}
                                 "clickable": true
                              },
                              {% endif %}
                               "spaceBetween": 0
                  }
          '
                    {% endif %}
            >
                <div class="{% if section.settings.enable_slider %}swiper-wrapper{% else %} clearfix{% endif %}">
                    {% for block in section.blocks %}
                        <div
                                class="{% if section.settings.enable_slider %}swiper-slide{% else %}mb-4 mb-md-{{ section.settings.item_margin }}{% endif %}"
                                {{ block.shopify_attributes }}
                        >
                            {% render 'banner-card-4',
                                    gx: 'gx-5',
                                    image: block.settings.image,
                                    image_mobile: block.settings.image_mobile,
                                    block_id: block.id,
                                    use_overlay: block.settings.use_overlay,
                                    colors_overlay: block.settings.colors_overlay,
                                    overlay_opacity: block.settings.overlay_opacity,
                                    style: 'style-1',
                                    image_height: section.settings.image_height,
                                    image_position: block.settings.image_position,
                                    image_width: section.settings.image_width,
                                    image_layout: section.settings.image_layout,
                                    enable_slider: section.settings.enable_slider,
                                    enable_controls: section.settings.enable_controls,
                                    video: block.settings.video,
                                    video_mobile: block.settings.video_mobile,
                                    forloop: forloop.index,
                                    heading: block.settings.heading,
                                    heading_tag: section.settings.heading_tag,
                                    heading_size: section.settings.heading_size,
                                    preheading: block.settings.preheading,
                                    subheading: block.settings.subheading,
                                    button_label: block.settings.button_label,
                                    button_link: block.settings.button_link,
                                    button_style: block.settings.button_style,
                                    max_width: block.settings.max_width,
                                    text_box_position: section.settings.text_box_position,
                                    text_alignment: section.settings.text_alignment,
                                    text_alignment_mobile: section.settings.text_alignment_mobile,
                                    use_custom_colors: section.settings.use_custom_colors,
                                    use_custom_colors_block: block.settings.use_custom_colors_block,
                                    color_text_block: block.settings.color_text_block,
                                    color_background_block: block.settings.color_background_block,
                                    color_background_gradient_block: block.settings.color_background_gradient_block
                            %}
                        </div>
                    {% endfor %}
                </div>
                {% if section.settings.enable_slider %}
                    {% if section.settings.enable_navigation %}
                        <div class="cs-navigation style-center">
                            {% render 'navigation-prev',
                                    section_id: section.id,
                                    navigation_icon: section.settings.navigation_icon
                            %}

                            {% render 'navigation-next',
                                    section_id: section.id,
                                    navigation_icon: section.settings.navigation_icon
                            %}
                        </div>
                    {% endif %}
                    {% if section.settings.enable_pagination %}
                        <div class="swiper-pagination mt-0 position-relative-767 position-absolute"></div>
                    {% endif %}
                {% endif %}
            </div>
        </div>
    </div>
</div>

