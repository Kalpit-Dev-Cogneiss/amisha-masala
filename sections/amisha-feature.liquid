{% comment %}
  Amisha Masala - feature split: framed photo with floating badge next to a headline, text and a checklist.
  Used for the story, quality and packaging blocks.
{% endcomment %}
<section id="AmFeat-{{ section.id }}" class="am-feat am-feat--{{ section.settings.background }} am-feat--{{ section.settings.image_side }}">
  <div class="container page-width">
    <div class="am-feat__grid">
      <div class="am-feat__media" data-reveal="{% if section.settings.image_side == 'left' %}left{% else %}right{% endif %}">
        <span class="am-feat__frame" aria-hidden="true"></span>
        <div class="am-feat__img">
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '500, 800, 1100', sizes: '(min-width: 992px) 44vw, 90vw', alt: section.settings.heading }}
          {%- endif -%}
        </div>
        {%- if section.settings.badge_number != blank -%}
          <div class="am-feat__badge">
            <strong>{{ section.settings.badge_number | escape }}</strong>
            <span>{{ section.settings.badge_label | escape }}</span>
          </div>
        {%- endif -%}
      </div>

      <div class="am-feat__text">
        {%- if section.settings.eyebrow != blank -%}
          <span class="am-eyebrow{% if section.settings.background == 'dark' %} am-eyebrow--light{% endif %}" data-reveal>{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        <h2 class="am-title{% if section.settings.background == 'dark' %} am-title--light{% endif %}" data-reveal style="--i: 1;">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}
          <div class="am-body" data-reveal style="--i: 2;">{{ section.settings.text }}</div>
        {%- endif -%}
        <ul class="am-feat__points">
          {%- for block in section.blocks -%}
            {%- if block.type == 'point' -%}
              <li data-reveal style="--i: {{ forloop.index | plus: 2 }};" {{ block.shopify_attributes }}>
                <span class="am-feat__tick"><i class="bi bi-check-lg"></i></span>
                <span>{{ block.settings.text | escape }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <div data-reveal style="--i: 8;">
            <a class="am-btn" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }} <i class="bi bi-arrow-right"></i></a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  #AmFeat-{{ section.id }} { padding: clamp(60px, 7vw, 110px) 0; overflow: hidden; }
  #AmFeat-{{ section.id }}.am-feat--cream { background: var(--am-cream); }
  #AmFeat-{{ section.id }}.am-feat--dark { background: radial-gradient(circle at 15% 0%, #7d0f0f 0%, #2a0404 70%); color: #fff; }
  #AmFeat-{{ section.id }}.am-feat--dark .am-body { color: rgba(255, 255, 255, 0.85); }
  #AmFeat-{{ section.id }} .am-feat__grid { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: clamp(40px, 6vw, 110px); }
  #AmFeat-{{ section.id }}.am-feat--right .am-feat__media { order: 2; }
  #AmFeat-{{ section.id }} .am-feat__media { position: relative; padding: 0 28px 28px 0; }
  #AmFeat-{{ section.id }}.am-feat--right .am-feat__media { padding: 0 0 28px 28px; }
  #AmFeat-{{ section.id }} .am-feat__frame {
    position: absolute;
    inset: 28px 0 0 28px;
    border: 3px solid var(--am-gold);
    border-radius: 36px;
  }
  #AmFeat-{{ section.id }}.am-feat--right .am-feat__frame { inset: 28px 28px 0 0; }
  #AmFeat-{{ section.id }} .am-feat__img {
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: 36px;
    overflow: hidden;
    box-shadow: 0 36px 70px rgba(74, 8, 8, 0.3);
    background: var(--am-cream);
  }
  #AmFeat-{{ section.id }} .am-feat__img img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 1.4s var(--am-ease); }
  #AmFeat-{{ section.id }} .am-feat__media:hover .am-feat__img img { transform: scale(1.06); }
  #AmFeat-{{ section.id }} .am-feat__badge {
    position: absolute;
    bottom: 0;
    right: -4px;
    min-width: 150px;
    padding: 20px 26px;
    border-radius: 24px;
    text-align: center;
    color: #fff;
    background: linear-gradient(135deg, var(--am-red), #a30f0f);
    box-shadow: 0 24px 44px rgba(0, 0, 0, 0.3);
    animation: amFeatFloat 5s ease-in-out infinite;
  }
  #AmFeat-{{ section.id }}.am-feat--right .am-feat__badge { right: auto; left: -4px; }
  #AmFeat-{{ section.id }} .am-feat__badge strong { display: block; font-family: var(--bs-font-heading-family); font-size: 44px; line-height: 1; color: var(--am-gold-soft); }
  #AmFeat-{{ section.id }} .am-feat__badge span { display: block; margin-top: 6px; font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
  @keyframes amFeatFloat { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-12px); } }
  @media (prefers-reduced-motion: reduce) { #AmFeat-{{ section.id }} .am-feat__badge { animation: none; } }

  #AmFeat-{{ section.id }} .am-feat__points { margin: 26px 0 34px; padding: 0; list-style: none; display: grid; gap: 14px; }
  #AmFeat-{{ section.id }} .am-feat__points li { display: flex; align-items: flex-start; gap: 16px; font-size: 17px; line-height: 1.55; }
  #AmFeat-{{ section.id }} .am-feat__tick {
    flex: 0 0 34px;
    height: 34px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #3a0606;
    background: linear-gradient(135deg, var(--am-gold-soft), var(--am-gold));
    box-shadow: 0 0 0 5px rgba(245, 184, 61, 0.2);
    font-size: 18px;
  }
  @media (max-width: 991px) {
    #AmFeat-{{ section.id }} .am-feat__grid { grid-template-columns: 1fr; }
    #AmFeat-{{ section.id }}.am-feat--right .am-feat__media { order: 0; }
    #AmFeat-{{ section.id }} .am-feat__media { max-width: 560px; margin: 0 auto; width: 100%; }
  }
</style>

{% schema %}
{
  "name": "Amisha - Feature split",
  "tag": "section",
  "settings": [
    { "type": "select", "id": "image_side", "label": "Photo position", "default": "left", "options": [
      { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ] },
    { "type": "select", "id": "background", "label": "Background", "default": "white", "options": [
      { "value": "white", "label": "White" }, { "value": "cream", "label": "Cream" }, { "value": "dark", "label": "Dark red" } ] },
    { "type": "text", "id": "eyebrow", "label": "Small heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "image_picker", "id": "image", "label": "Photo (square)" },
    { "type": "text", "id": "badge_number", "label": "Badge number" },
    { "type": "text", "id": "badge_label", "label": "Badge label" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Checklist item",
      "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Checklist item" } ]
    }
  ],
  "presets": [{ "name": "Amisha - Feature split" }]
}
{% endschema %}
