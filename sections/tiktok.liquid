<script src="{{ 'embed.js' | asset_url }}" defer="defer"></script>
{% style %}
    .section-extras-spacing-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --section-margin-top: {{ section.settings.margin_top }}px;
    --section-margin-bottom: {{ section.settings.margin_bottom }}px;

    }
    {% if section.settings.use_custom_colors %}
        .section-extras-color-{{ section.id }} {
        --gradient-background: {% if section.settings.color_background_gradient != blank %}{{ section.settings.color_background_gradient }}{% else %}{{ section.settings.color_background }}{% endif %};
        --color-background: {{ section.settings.color_background.red }}, {{ section.settings.color_background.green }}, {{ section.settings.color_background.blue }};
        --color-foreground: {{ section.settings.color_text.red }}, {{ section.settings.color_text.green }}, {{ section.settings.color_text.blue }};
        }
    {% endif %}
{% endstyle %}

<div
        class="
     tiktok {{ section.settings.style }} overflow-hidden-x section-extras-spacing section-extras-spacing-{{ section.id }}
     {% if section.settings.use_custom_colors %} section-extras-color section-extras-color-{{ section.id }} {% endif %}
     {% if section.settings.custom_class != blank %} {{ section.settings.custom_class }}{% endif %}
  "
        {% if section.settings.custom_id != blank %}
            id="{{ section.settings.custom_id }}"
        {% endif %}
>
    <div class="{{ section.settings.layout }} position-relative">
        <div class="cs-section-header {{ section.settings.heading_alignment }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
            {% render 'heading',
                    heading: section.settings.heading,
                    heading_tag: section.settings.heading_tag,
                    heading_size: section.settings.heading_size,
                    preheading: section.settings.preheading,
                    subheading: section.settings.subheading
            %}
        </div>
        <div class="gx-{{ section.settings.gutter }} row row-cols-1 row-cols-sm-{{ section.settings.columns_tablet }} row-cols-lg-{{ section.settings.columns_desktop }}">
            {% for block in section.blocks %}
                <div class="col mb-4{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" {{ block.shopify_attributes }}>
                  {% if block.settings.tiktok_url != blank %}
                    <blockquote class="tiktok-embed w-100 p-0"
                                cite="{{ block.settings.tiktok_url }}"
                                data-video-id="{{ block.settings.tiktok_url | split: '/' | last }}">
                      <div>Loading video...</div>
                    </blockquote>
                  {% else %}
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg bg-body-tertiary' }}
                  {% endif %}
                </div>
            {% endfor %}

        </div>
      {% if section.settings.button_link and section.settings.button_label != blank %}
        <div class="text-center w-100{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          <a
                  {% if section.settings.button_link == blank %}
                    role="link" aria-disabled="true"
                  {% else %}
                    href="{{ section.settings.button_link }}"
                  {% endif %}
                  class="btn-link"
          >
            <span><i class="bi bi-tiktok me-2"></i>{{- section.settings.button_label | escape -}}</span>
          </a>
        </div>
      {% endif %}
    </div>
</div>

{% schema %}
{
  "name": "t:sections.tiktok.name",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
          "value": "container page-width",
          "label": "t:sections.all.layout.options__1.label"
        },
        {
          "value": "container container-inner",
          "label": "t:sections.all.layout.options__2.label"
        },
        {
          "value": "container-fluid",
          "label": "t:sections.all.layout.options__3.label"
        },
        {
          "value": "full-width",
          "label": "t:sections.all.layout.options__4.label"
        }
      ],
      "default": "container page-width",
      "label": "t:sections.all.layout.header"
    },
    {
      "type": "text",
      "id": "preheading",
      "label": "t:sections.all.heading.preheading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.all.heading.label",
      "default": "Multicolumn"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "t:sections.all.heading.subheading"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.all.heading_tag.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_tag.options__2.label"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_tag.options__3.label"
        },
        {
          "value": "h4",
          "label": "t:sections.all.heading_tag.options__4.label"
        },
        {
          "value": "h5",
          "label": "t:sections.all.heading_tag.options__5.label"
        },
        {
          "value": "h6",
          "label": "t:sections.all.heading_tag.options__6.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_tag.label",
      "info": "t:sections.all.heading_tag.info"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "h4",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "h5",
          "label": "t:sections.all.heading_size.options__5.label"
        },
        {
          "value": "h6",
          "label": "t:sections.all.heading_size.options__6.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "t:sections.all.heading_alignment.label",
      "options": [
        {
          "value": "text-start",
          "label": "t:sections.all.heading_alignment.options__1.label"
        },
        {
          "value": "text-center",
          "label": "t:sections.all.heading_alignment.options__2.label"
        },
        {
          "value": "text-end",
          "label": "t:sections.all.heading_alignment.options__3.label"
        }
      ],
      "default": "text-start"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "Follow us on Tiktok.",
      "label": "t:sections.all.button.button_label"
    },
    {
      "type": "url",
      "id": "button_link",
      "default": "/",
      "label": "t:sections.all.button.button_link"
    },
    {
      "type": "header",
      "content": "t:sections.all.layout.header"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "t:sections.all.columns.columns_desktop"
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2,
      "label": "t:sections.all.columns.columns_tablet"
    },
    {
      "type": "range",
      "id": "gutter",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "t:sections.all.columns.gutter"
    },
    {
      "type": "header",
      "content": "t:sections.all.color_options.header"
    },
    {
      "type": "checkbox",
      "id": "use_custom_colors",
      "default": false,
      "label": "t:sections.all.color_options.use_custom_colors"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "t:sections.all.color_options.color_text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "t:sections.all.color_options.color_background",
      "default": "#ffffff"
    },
    {
      "type": "color_background",
      "id": "color_background_gradient",
      "label": "t:sections.all.color_options.color_background_gradient"
    },
    {
      "type": "header",
      "content": "t:sections.all.margin.section_margin_heading"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.margin.margin_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.margin.margin_bottom",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 100
    },
    {
      "type": "header",
      "content": "t:sections.all.custom.header"
    },
    {
      "type": "text",
      "id": "custom_id",
      "label": "t:sections.all.custom.custom_id"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "t:sections.all.custom.custom_class"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "t:sections.tiktok.block.item.name",
      "settings": [
        {
          "type": "text",
          "id": "tiktok_url",
          "label": "TikTok Video URL",
          "default": "https://www.tiktok.com/@username/video/0000000000000000000"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.tiktok.presets.name",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ]
}
{% endschema %}
