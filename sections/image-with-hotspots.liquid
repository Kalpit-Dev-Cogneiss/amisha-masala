{% style %}
    .section-extras-margin-{{ section.id }} {
    --section-margin-top: {{ section.settings.margin_top }}px;
    --section-margin-bottom: {{ section.settings.margin_bottom }}px;
    }
    {% if section.settings.use_custom_colors %}
        @media(min-width: 768px){
        .block-extras-color-{{ section.id }} {
        --color-foreground-block: {{ section.settings.color_text.red }}, {{ section.settings.color_text.green }}, {{ section.settings.color_text.blue }};
        }
        }
    {% endif %}
    {% if section.settings.use_overlay %}
        .card-overlay-{{ section.id }} {
        --color-overlay: {{ section.settings.colors_overlay.red }}, {{ section.settings.colors_overlay.green }}, {{ section.settings.colors_overlay.blue }};
        --color-overlay-opacity: {{ section.settings.overlay_opacity }};
        }
    {% endif %}
{% endstyle %}
<div
        class="position-relative overflow-hidden {% if section.settings.show_border %} have-border-bottom{% endif %}
    card-image-with-hotspots section-extras-margin section-extras-margin-{{ section.id }}
    {% if section.settings.custom_class != blank %} {{ section.settings.custom_class }}{% endif %}
  "
        {% if section.settings.custom_id != blank %}
            id="{{ section.settings.custom_id }}"
        {% endif %}
>
    <div class="{{ section.settings.layout }} position-relative">
        <div class="{% if section.settings.use_custom_colors %} block-extras-color block-extras-color-{{ section.id }}{% endif %}">

            <div class="clearfix {% if section.settings.layout != 'container page-width' %}container page-width{% endif %}">
                {% if section.settings.preheading != '' or section.settings.heading != '' or section.settings.subheading != '' %}
                    <div class="heading {% if section.settings.button_label != '' %}d-flex align-items-center justify-content-between flex-wrap{% else %} text-center{% endif %} heading-wrap">
                        <div class="clearfix">
                            {% if section.settings.preheading != blank %}
                                <div class="preheading fs-14 mb-2 text-uppercase" data-aos="fade-up">
                                    <div class="opacity-85">
                                        {{ section.settings.preheading }}
                                    </div>
                                </div>
                            {% endif %}
                            {% render 'h-heading',
                                    heading_tag: section.settings.heading_tag,
                                    heading_size: section.settings.heading_size,
                                    heading: section.settings.heading,
                                    animation: 'yes'
                            %}

                            {% if section.settings.subheading != blank %}
                                <div class="subheading rte mt-2" data-aos="fade-up" data-aos-delay="200">
                                    <div class="opacity-85">
                                        {{ section.settings.subheading }}
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                        {% if section.settings.button_link and section.settings.button_label != '' %}
                            <div class="sub-4 card-bottom mt-3" data-aos="fade-up" data-aos-delay="400">
                                <a
                                        {% if section.settings.button_link == blank %}
                                            role="link" aria-disabled="true"
                                        {% else %}
                                            href="{{ section.settings.button_link }}"
                                        {% endif %}
                                        class="btn btn-link position-relative z-index-1"
                                >
                                    <span>{{- section.settings.button_label | escape -}}</span>
                                </a>
                            </div>
                        {% endif %}
                    </div>

                {% endif %}
            </div>
            <div
                    class="cs-card card-banner card-banner-one {{ section.settings.style }} {{ section.settings.style_hover }}"
            >
                <div class="position-relative">
                    <div class="card-img-top lh-0 d-block overflow-hidden{% if section.settings.use_overlay %} card-overlay card-overlay-{{ section.id }}{% endif %}">

                        {% if section.settings.image != blank %}
                            <div class="media-wrap {% if section.settings.image_mobile != blank or section.settings.video_mobile != blank %}d-none d-md-block{% endif %}">
                                {% render 'image-lg', lazyload: true, image: section.settings.image, class: 'w-100' %}
                            </div>
                        {% else %}
                            <div class="media-wrap {% if section.settings.image_mobile != blank or section.settings.video_mobile != blank %}d-none d-md-block{% endif %}">
                                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg bg-body-tertiary' }}
                            </div>
                        {% endif %}
                    </div>
                    {% for block in section.blocks %}
                        <div class="item-hotspots item-hotspots-style" {{ block.shopify_attributes }}
                             style="--bs-hotspot-vertical-position: {{ block.settings.vertical_position }}%;
                                     --bs-hotspot-horizontal-position: {{ block.settings.horizontal_position }}%;">
                            <button class="item-hotspots-btn btn-icon-plus btn-icon-plus-style"><i
                                        class="bi bi-plus"></i></button>
                            <div class="content-hotspots content-hotspots-style">
                                <button class="btn-close-modal btn-close-modal-style"><i
                                            class="bi bi-plus"></i></button>
                                <div class="content-inner">
                                    {% if block.settings.heading != '' %}
                                        <h3 class="h6">{{ block.settings.heading }}</h3>
                                    {% endif %}
                                    {% if block.settings.subheading != '' %}
                                        <div class="rte rte-custom mb-0">{{ block.settings.subheading }}</div>
                                    {% endif %}
                                    {% if block.settings.product != blank %}
                                        {% render 'product-card-list-small',
                                                product: block.settings.product,
                                                image_height: 'adapt'
                                        %}
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>

        </div>
    </div>
</div>
{% schema %}
{
  "name": "t:sections.image-with-hotspots.name",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
          "value": "container page-width",
          "label": "t:sections.all.layout.options__1.label"
        },
        {
          "value": "container container-inner",
          "label": "t:sections.all.layout.options__2.label"
        },
        {
          "value": "container-fluid",
          "label": "t:sections.all.layout.options__3.label"
        },
        {
          "value": "full-width",
          "label": "t:sections.all.layout.options__4.label"
        }
      ],
      "default": "full-width",
      "label": "t:sections.all.layout.header"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.all.image.label"
    },
    {
      "type": "text",
      "id": "preheading",
      "default": "New in",
      "label": "t:sections.all.heading.preheading"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Image with text",
      "label": "t:sections.all.heading.label"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "default": "<p>Sale Off 30%</p>",
      "label": "t:sections.all.heading.subheading"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "Buy it now",
      "label": "t:sections.all.button.button_label"
    },
    {
      "type": "url",
      "id": "button_link",
      "default": "/collections/all",
      "label": "t:sections.all.button.button_link"
    },
    {
      "type": "header",
      "content": "t:sections.all.settings.header"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.all.heading_tag.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_tag.options__2.label"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_tag.options__3.label"
        },
        {
          "value": "h4",
          "label": "t:sections.all.heading_tag.options__4.label"
        },
        {
          "value": "h5",
          "label": "t:sections.all.heading_tag.options__5.label"
        },
        {
          "value": "h6",
          "label": "t:sections.all.heading_tag.options__6.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_tag.label",
      "info": "t:sections.all.heading_tag.info"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h-custom-v1",
          "label": "t:sections.all.heading_size.options__custom1.label"
        },
        {
          "value": "h-custom",
          "label": "t:sections.all.heading_size.options__custom.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__0.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "h4",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "h5",
          "label": "t:sections.all.heading_size.options__5.label"
        },
        {
          "value": "h6",
          "label": "t:sections.all.heading_size.options__6.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.layout.header"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:sections.all.text_alignment.label_desktop",
      "options": [
        {
          "value": "text-md-start text-lg-start",
          "label": "t:sections.all.text_alignment.options__1.label"
        },
        {
          "value": "text-md-center text-lg-center",
          "label": "t:sections.all.text_alignment.options__2.label"
        },
        {
          "value": "text-md-end text-lg-end",
          "label": "t:sections.all.text_alignment.options__3.label"
        }
      ],
      "default": "text-md-center text-lg-center"
    },
    {
      "type": "header",
      "content": "t:sections.all.color_options.header"
    },
    {
      "type": "checkbox",
      "id": "use_custom_colors",
      "default": true,
      "label": "t:sections.all.color_options.use_custom_colors"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "t:sections.all.color_options.color_text",
      "default": "#000000"
    },
    {
      "type": "checkbox",
      "id": "use_overlay",
      "default": false,
      "label": "t:sections.all.colors.use_overlay.label"
    },
    {
      "type": "color",
      "id": "colors_overlay",
      "label": "t:sections.all.colors.colors_overlay.label",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "label": "t:sections.all.colors.overlay_opacity.label",
      "default": 0.3
    },
    {
      "type": "header",
      "content": "t:sections.all.margin.section_margin_heading"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.margin.margin_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.margin.margin_bottom",
      "default": 100
    },
    {
      "type": "header",
      "content": "t:sections.all.mobile.header"
    },
    {
      "type": "select",
      "id": "text_alignment_mobile",
      "label": "t:sections.all.text_alignment.label_mobile",
      "options": [
        {
          "value": "text-start",
          "label": "t:sections.all.text_alignment.options__1.label"
        },
        {
          "value": "text-center",
          "label": "t:sections.all.text_alignment.options__2.label"
        },
        {
          "value": "text-end",
          "label": "t:sections.all.text_alignment.options__3.label"
        }
      ],
      "default": "text-start"
    },
    {
      "type": "header",
      "content": "t:sections.all.custom.header"
    },
    {
      "type": "text",
      "id": "custom_id",
      "label": "t:sections.all.custom.custom_id"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "t:sections.all.custom.custom_class"
    }
  ],
  "blocks": [
    {
      "type": "hotspots",
      "name": "t:sections.image-with-hotspots.block.label",
      "settings": [
        {
          "type": "range",
          "id": "vertical_position",
          "label": "t:sections.image-with-hotspots.block.vertical_label",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 50,
          "unit": "%"
        },
        {
          "type": "range",
          "id": "horizontal_position",
          "label": "t:sections.image-with-hotspots.block.horizontal_label",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 50,
          "unit": "%"
        },
        {
          "type": "text",
          "id": "heading",
          "default": "Image with text",
          "label": "t:sections.all.heading.label"
        },
        {
          "type": "richtext",
          "id": "subheading",
          "default": "<p>Sale Off 30%</p>",
          "label": "t:sections.all.heading.subheading"
        },
        {
          "type": "product",
          "id": "product",
          "label": "t:sections.all.product.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.image-with-hotspots.presets.name",
      "blocks": [
        {
          "type": "hotspots",
          "settings": {
            "vertical_position": 25,
            "horizontal_position": 25
          }
        },
        {
          "type": "hotspots",
          "settings": {
            "vertical_position": 75,
            "horizontal_position": 75
          }
        }
      ]
    }
  ]
}
{% endschema %}
