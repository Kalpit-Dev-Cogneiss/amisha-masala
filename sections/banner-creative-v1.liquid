    },
    {
      "type": "text",
      "id": "custom_id",
      "label": "t:sections.all.custom.custom_id"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "t:sections.all.custom.custom_class"
    }
  ],
  "blocks": [
    {
      "type": "card-banner",
      "name": "t:sections.banner-creative-v1.block.card-banner.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.all.image.label"
        },
        {
          "type": "video",
          "id": "video",
          "label": "t:sections.all.video.label"
        },
        {
          "type": "text",
          "id": "preheading",
          "default": "New in",
          "label": "t:sections.all.heading.preheading"
        },
        {
          "type": "text",
          "id": "heading",
          "default": "Image with text",
          "label": "t:sections.all.heading.label"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "t:sections.all.heading.subheading"
        },
        {
          "type": "text",
          "id": "button_label",
          "default": "Buy it now",
          "label": "t:sections.all.button.button_label"
        },
        {
          "type": "url",
          "id": "button_link",
          "default": "/collections/all",
          "label": "t:sections.all.button.button_link"
        },
        {
          "type": "header",
          "content": "t:sections.all.mobile.header"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "t:sections.all.image.label"
        },
        {
          "type": "video",
          "id": "video_mobile",
          "label": "t:sections.all.video.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.banner-creative-v1.presets.name",
      "blocks": [
        {
          "type": "card-banner"
        },
        {
          "type": "card-banner"
        }
      ]
    }
  ]
}
{% endschema %}
