{% style %}
  .section-extras-margin-{{ section.id }} {
  --section-margin-top: {{ section.settings.margin_top }}px;
  --section-margin-bottom: {{ section.settings.margin_bottom }}px;
  }
  {% if section.settings.use_custom_colors %}
    .block-extras-color-{{ section.id }} {
    --gradient-background-block: {% if section.settings.color_background_gradient != blank %}{{ section.settings.color_background_gradient }}{% else %}{{ section.settings.color_background }}{% endif %};
    --color-background-block: {{ section.settings.color_background.red }}, {{ section.settings.color_background.green }}, {{ section.settings.color_background.blue }};
    --color-foreground-block: {{ section.settings.color_text.red }}, {{ section.settings.color_text.green }}, {{ section.settings.color_text.blue }};
    }
  {% endif %}
  {% if section.settings.use_overlay %}
    .card-overlay-{{ section.id }} {
    --color-overlay: {{ section.settings.colors_overlay.red }}, {{ section.settings.colors_overlay.green }}, {{ section.settings.colors_overlay.blue }};
    --color-overlay-opacity: {{ section.settings.overlay_opacity }};
    }
  {% endif %}
{% endstyle %}
<div
        class="position-relative overflow-hidden {% if section.settings.show_border %} have-border-bottom{% endif %}
    card-banner-parallax section-extras-margin section-extras-margin-{{ section.id }}
    {% if section.settings.custom_class != blank %} {{ section.settings.custom_class }}{% endif %}
  "
        {% if section.settings.custom_id != blank %}
          id="{{ section.settings.custom_id }}"
        {% endif %}
>
  <div class="{{ section.settings.layout }} position-relative">
    <div
            class="cs-card card-banner card-banner-one rounded-{{ section.settings.border_radius }} overflow-hidden {{ section.settings.style }} {{ section.settings.style_hover }}"
    >
      <div
              class="jarallax position-relative overflow-hidden card-img-custom-height {{ section.settings.image_height_mobile }} {{ section.settings.image_height }}"
              data-jarallax data-speed="{{ section.settings.speed }}" data-type="{{ section.settings.type }}"
      >
        <div class="card-img-top lh-0 d-block overflow-hidden{% if section.settings.use_overlay %} card-overlay card-overlay-{{ section.id }}{% endif %}">
          {% if section.settings.button_link %}
            <a class="full-width-link" href="{{ section.settings.button_link }}">
              <span class="d-none">{{ section.settings.heading }}</span>
            </a>
          {% endif %}
          {% if section.settings.image != blank %}
            <div class="media-wrap">
              {% render 'image-lg', lazyload: true, image: section.settings.image, class: 'w-100 jarallax-img' %}
            </div>
          {% else %}
            <div class="media-wrap">
              <div class=" ">
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg bg-body-tertiary' }}
              </div>
            </div>
          {% endif %}
        </div>
        <div class="cs-card-body position-absolute start-0 end-0 container page-width {{ section.settings.text_box_position_mobile }} {{ section.settings.text_box_position }} {{ section.settings.text_alignment }} {{ section.settings.text_alignment_mobile }}">
          <div class="cs-card-body-inner {% if section.settings.color_background == "rgba(0,0,0,0)" and section.settings.use_custom_colors %} py-4 px-0 {% else %}p-5{% endif %} {% if section.settings.use_custom_colors %} block-extras-color block-extras-color-{{ section.id }}{% endif %}" style="max-width: {{ section.settings.max_width }}px">
            <div class="card-top position-relative z-index-10">
              {% render 'heading',
                      heading: section.settings.heading,
                      heading_tag: section.settings.heading_tag,
                      heading_size: section.settings.heading_size,
                      preheading: section.settings.preheading,
                      subheading: section.settings.subheading
              %}
            </div>
            {% if section.settings.time != '' %}
             <div class="d-inline-block">
               <countdown-timer class="js-time time-lg position-relative z-1">
                 <input class="d-none js-date" type="date" value="{{ section.settings.time }}">
                 <p class="mb-0 js-countdown d-flex align-items-center flex-nowrap"></p>
               </countdown-timer>
             </div>
            {% endif %}
            {% if section.settings.button_link and section.settings.button_label != blank %}
              <div class="sub-4 card-bottom position-relative z-index-10" data-aos="fade-up"
                   data-aos-delay="400">
                <a
                        {% if section.settings.button_link == blank %}
                          role="link" aria-disabled="true"
                        {% else %}
                          href="{{ section.settings.button_link }}"
                        {% endif %}
                        class="btn btn-{{ section.settings.button_style }} position-relative z-index-1"
                >
                  <span>{{- section.settings.button_label | escape -}}</span>
                </a>
              </div>
            {% endif %}
          </div>
        </div>
        {% if section.settings.enable_scroll %}
          <a class="scroll position-absolute bottom-0 mb-5 start-50 translate-middle-x z-index-10"
             href="#{{ section.settings.id_scroll }}">
            <span></span>
            <span></span>
            <span></span>
          </a>
        {% endif %}
      </div>
    </div>

  </div>

</div>

