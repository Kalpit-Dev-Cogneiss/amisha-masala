{% style %}
    .section-extras-color-{{ section.id }} {
    --color-foreground: {{ section.settings.color_text.red }}, {{ section.settings.color_text.green }}, {{ section.settings.color_text.blue }};
    }
    .section-extras-spacing-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --section-margin-top: {{ section.settings.margin_top }}px;
    --section-margin-bottom: {{ section.settings.margin_bottom }}px;

    --color-border-card: {{ section.settings.color_border.red }}, {{ section.settings.color_border.green }}, {{ section.settings.color_border.blue }};
    }
{% endstyle %}
<div class="section-extras-color section-extras-color-{{ section.id }}">
    {% render 'breadcrumb-banner',
            banner_image: section.settings.banner_image,
            layout_container: section.settings.layout,
            heading: page.title,
            class_img: 'mb-4 mb-lg-5'
    %}
</div>
<div class="container page-width section-extras-spacing section-extras-spacing-{{ section.id }}">
  <div class="row d-flex justify-content-center">
    <div class="col-12 col-lg-6">
      <div class="cs-section-header mb-4 mb-md-5">
        <div class="form-vertical">
          {% form 'reset_customer_password' %}
            <h1 class="text-center">{{ 'customer.reset_password.title' | t }}</h1>

            <p class="text-center">{{ 'customer.reset_password.subtext' | t }}</p>

            {% if form.errors %}
              <div class="form-message form-message--error">
                {{ form.errors | default_errors }}
              </div>
            {% endif %}

            <label for="ResetPassword">{{ 'customer.reset_password.password' | t }}</label>
            <input
              type="password"
              value=""
              name="customer[password]"
              id="ResetPassword"
              class="{% if form.errors contains 'password' %} input--error{% endif %}"
            >

            <label for="PasswordConfirmation">{{ 'customer.reset_password.password_confirm' | t }}</label>
            <input
              type="password"
              value=""
              name="customer[password_confirmation]"
              id="PasswordConfirmation"
              class="{% if form.errors contains 'password_confirmation' %} input--error{% endif %}"
            >

            <button type="submit" class="btn text-center">{{ 'customer.reset_password.submit' | t }}</button>
          {% endform %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-reset-password.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.page_title.name"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "t:sections.all.page_title.settings.background"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "t:sections.all.color_options.color_text",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "t:sections.all.margin.section_margin_heading"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.margin.margin_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.margin.margin_bottom",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 100
    }
  ]
}
{% endschema %}
