<div class="container page-width {% if section.settings.show_share_buttons %}d-flex flex-wrap justify-content-center justify-content-md-between align-items-center{% endif %} password-content-footer text-center text-md-start">
  {% if section.settings.show_share_buttons %}
    <div class="me-3">
      {% render 'social' %}
    </div>
  {% endif %}

  <div class="password-powered-by">
    <small>{{ powered_by_link }}</small>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.password-footer.name",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_share_buttons",
      "label": "t:sections.password-footer.settings.show_share_buttons.label",
      "default": true
    }
  ]
}
{% endschema %}
