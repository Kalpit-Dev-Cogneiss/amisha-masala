{% style %}
  .section-extras-spacing-{{ section.id }} {
  --section-padding-top: {{ section.settings.padding_top }}px;
  --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  --section-margin-top: {{ section.settings.margin_top }}px;
  --section-margin-bottom: {{ section.settings.margin_bottom }}px;

  }

  {% if section.settings.use_custom_colors %}
    .section-extras-color-{{ section.id }} {
    --gradient-background: {% if section.settings.color_background_gradient != blank %}{{ section.settings.color_background_gradient }}{% else %}{{ section.settings.color_background }}{% endif %};
    --color-background: {{ section.settings.color_background.red }}, {{ section.settings.color_background.green }}, {{ section.settings.color_background.blue }};
    --color-foreground: {{ section.settings.color_text.red }}, {{ section.settings.color_text.green }}, {{ section.settings.color_text.blue }};
    }
  {% endif %}
{% endstyle %}

<div
  class="
    section-extras-spacing section-extras-spacing-{{ section.id }}
    {% if section.settings.use_custom_colors %} section-extras-color section-extras-color-{{ section.id }} {% endif %}
    {% if section.settings.custom_class != blank %} {{ section.settings.custom_class }}{% endif %}
  "
  {% if section.settings.custom_id != blank %}
    id="{{ section.settings.custom_id }}"
  {% endif %}
>
  <div class="container page-width position-relative">
    {% render 'heading',
      heading: section.settings.heading,
      class: 'heading',
      heading_alignment: section.settings.heading_alignment,
      heading_tag: section.settings.heading_tag,
      heading_size: section.settings.heading_size,
      preheading: section.settings.preheading,
      subheading: section.settings.subheading
    %}

    {% if section.blocks.size > 0 %}
      <div class="row row-cols-{{ section.settings.columns_mobile }} row-cols-md-{{ section.settings.columns_tablet }} row-cols-lg-{{ section.settings.columns_desktop }}">
        {% for block in section.blocks %}
          <div class="col mb-4 have-image" {{ block.shopify_attributes }}>
            <div class="hover-shadow-item">
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}" class="logo-bar__link">
                {% endif %}
                {% if block.settings.image != blank %}
                  {% assign image = block.settings.image %}
                  {% render 'image', lazyload: true, image: image %}
                {% else %}
                  {{ 'logo' | placeholder_svg_tag: 'placeholder-svg' }}
                {% endif %}
                {% if block.settings.link != blank %}
              </a>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}
    {% if section.blocks.size == 0 %}
      {% render 'no-blocks' %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.logo-bar.name",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "max_blocks": 20,
  "settings": [
    {
      "type": "text",
      "id": "preheading",
      "default": "News",
      "label": "t:sections.all.heading.preheading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.all.heading.label",
      "default": "Logo bar"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "t:sections.all.heading.subheading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
           "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
           "value": "h3",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
           "value": "h4",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
           "value": "h5",
          "label": "t:sections.all.heading_size.options__5.label"
        },
        {
          "value": "h6",
          "label": "t:sections.all.heading_size.options__6.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.all.heading_tag.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_tag.options__2.label"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_tag.options__3.label"
        },
        {
          "value": "h4",
          "label": "t:sections.all.heading_tag.options__4.label"
        },
        {
          "value": "h5",
          "label": "t:sections.all.heading_tag.options__5.label"
        },
        {
          "value": "h6",
          "label": "t:sections.all.heading_tag.options__6.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_tag.label",
      "info": "t:sections.all.heading_tag.info"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "t:sections.all.heading_alignment.label",
      "options": [
        {
          "value": "text-start",
          "label": "t:sections.all.heading_alignment.options__1.label"
        },
        {
          "value": "text-center",
          "label": "t:sections.all.heading_alignment.options__2.label"
        },
        {
          "value": "text-end",
          "label": "t:sections.all.heading_alignment.options__3.label"
        }
      ],
      "default": "text-center"
    },
    {
      "type": "header",
      "content": "t:sections.all.layout.header"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 6,
      "label": "t:sections.all.columns.columns_desktop"
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3,
      "label": "t:sections.all.columns.columns_tablet"
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2,
      "label": "t:sections.all.columns.columns_mobile"
    },
    {
      "type": "header",
      "content": "t:sections.all.color_options.header"
    },
    {
      "type": "checkbox",
      "id": "use_custom_colors",
      "default": false,
      "label": "t:sections.all.color_options.use_custom_colors"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "t:sections.all.color_options.color_text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "t:sections.all.color_options.color_background",
      "default": "#ffffff"
    },
    {
      "type": "color_background",
      "id": "color_background_gradient",
      "label": "t:sections.all.color_options.color_background_gradient"
    },
    {
      "type": "header",
      "content": "t:sections.all.margin.section_margin_heading"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.margin.margin_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.margin.margin_bottom",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 100
    },

    {
      "type": "header",
      "content": "t:sections.all.custom.header"
    },
    {
      "type": "text",
      "id": "custom_id",
      "label": "t:sections.all.custom.custom_id"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "t:sections.all.custom.custom_class"
    }
  ],
  "blocks": [
    {
      "type": "logo_image",
      "name": "t:sections.logo-bar.blocks.logo_image.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.logo-bar.blocks.logo_image.settings.image.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.logo-bar.blocks.logo_image.settings.link.label",
          "info": "t:sections.logo-bar.blocks.logo_image.settings.link.info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.logo-bar.presets.name",
      "blocks": [
        {
          "type": "logo_image"
        },
        {
          "type": "logo_image"
        },
        {
          "type": "logo_image"
        },
        {
          "type": "logo_image"
        },
        {
          "type": "logo_image"
        },
        {
          "type": "logo_image"
        }
      ]
    }
  ]
}
{% endschema %}
