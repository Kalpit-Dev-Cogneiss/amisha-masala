{% comment %}
  Password message which you can edit on http://www.shopify.com/admin/online_store/preferences
{% endcomment %}
<div class="container page-width text-center">
  <div class="mb-5">
    {% unless shop.password_message == blank %}
      <div class="password-message">
        {{ shop.password_message }}
      </div>
    {% endunless %}

    {% form 'storefront_password', class: 'password-form form-single-field' %}
      <label class="label--hidden" for="{{ 'general.password_page.login_form_password_label' | t }}">
        {{- 'general.password_page.login_form_password_placeholder' | t -}}
      </label>
      <div class="input-group">
        <input
          type="password"
          name="password"
          id="Password"
          class="input-group__field"
          autocomplete="current-password"
          {% if form.errors %}
            aria-invalid="true"
            aria-describedby="PasswordLoginForm-password-error"
          {% endif %}
          placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}"
        >

        <span class="input-group__btn">
          <button name="commit" class="btn btn-primary">
            <span>{{ 'general.password_page.login_form_submit' | t }}</span>
          </button>
        </span>
      </div>
      {% if form.errors %}
        {% assign form_id = 'PasswordNewsletterForm' %}
        <span id="{{ form_id }}-password-error" class="input-error-message opacity-85">
          <span class="d-none">{{ 'general.accessibility.error' | t }} </span>
          <i class="bi bi-exclamation-circle"></i>
          <span>{{ form.errors.messages.form }}</span>
        </span>
      {% endif %}
    {% endform %}

    <p>{{ 'general.password_page.admin_link_html' | t }}</p>
  </div>

  {% if section.settings.newsletter_enable %}
    <div class="password-content password-content-inner password-content--rte background-light">
      <h3 class="h5 mb-2">
        {{ section.settings.newsletter_form_heading | escape }}
      </h3>
      {% if section.settings.newsletter_form_subheading != blank %}
        <div class="password__form-subheading rte opacity-85">{{ section.settings.newsletter_form_subheading }}</div>
      {% endif %}

      {% form 'customer', id: 'ContactPassword', class: 'contact-form form-single-field' %}
        {% assign form_id = 'PasswordNewsletterForm' %}
        <input type="hidden" name="contact[tags]" value="prospect, password page">
        <label for="{{ form_id }}-email" class="label--hidden">
          {{- 'general.password_page.signup_form_email_label' | t -}}
        </label>

        {% if form.posted_successfully? %}
          <p class="form-message form-message--success" tabindex="-1" data-form-status>
            {{ 'general.password_page.signup_form_success' | t }}
          </p>
        {% endif %}

        <div class="input-group{% if form.errors %} input-group--error{% endif %}">
          <input
            type="email"
            name="contact[email]"
            id="{{ form_id }}-email"
            class="input-group__field {% if form.errors contains 'email' %} input--error{% endif %}"
            placeholder="{{ section.settings.newsletter_placeholder | escape }}"
            {% if form.errors contains 'email' %}
              aria-invalid="true"
              aria-describedby="{{ form_id }}-email-error"
              data-form-status
            {% endif %}
          >
          <span class="input-group__btn">
            <button type="submit" name="commit" class="btn btn-primary">
              <span>{{ section.settings.newsletter_button_text | escape }}</span>
            </button>
          </span>
        </div>
        {% if form.errors contains 'email' %}
          <span id="{{ form_id }}-email-error" class="input-error-message">
            <span class="d-none">{{ 'general.accessibility.error' | t }} </span>
            <i class="bi bi-exclamation-circle"></i>
            <span>
              {{- form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email }}.</span
            >
          </span>
        {% endif %}
      {% endform %}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "t:sections.password-content.name",
  "settings": [
    {
      "type": "checkbox",
      "id": "newsletter_enable",
      "label": "t:sections.password-content.settings.newsletter_enable.label",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_form_heading",
      "label": "t:sections.password-content.settings.newsletter_form_heading.label",
      "default": "Be the first to know when we launch."
    },
    {
      "type": "richtext",
      "id": "newsletter_form_subheading",
      "label": "t:sections.password-content.settings.newsletter_form_subheading.label",
      "default": "<p>Promotions, new products and sales. Directly to your inbox.</p>"
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "t:sections.password-content.settings.newsletter_placeholder.label",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "newsletter_button_text",
      "label": "t:sections.password-content.settings.newsletter_button_text.label",
      "default": "Notify me"
    }
  ]
}
{% endschema %}
