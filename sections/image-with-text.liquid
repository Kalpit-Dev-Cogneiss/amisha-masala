{% style %}
    .section-extras-spacing-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --section-margin-top: {{ section.settings.margin_top }}px;
    --section-margin-bottom: {{ section.settings.margin_bottom }}px;
    }

    {% if section.settings.use_custom_colors %}
        .section-extras-color-{{ section.id }} {
        --gradient-background: {% if section.settings.color_background_gradient != blank %}{{ section.settings.color_background_gradient }}{% else %}{{ section.settings.color_background }}{% endif %};
        --color-background: {{ section.settings.color_background.red }}, {{ section.settings.color_background.green }}, {{ section.settings.color_background.blue }};
        --color-foreground: {{ section.settings.color_text.red }}, {{ section.settings.color_text.green }}, {{ section.settings.color_text.blue }};
        }
    {% endif %}
{% endstyle %}

<div
        class="
      image-with-text overflow-hidden section-extras-spacing section-extras-spacing-{{ section.id }}
      {% if section.settings.use_custom_colors %} section-extras-color section-extras-color-{{ section.id }} {% endif %}
      {% if section.settings.custom_class != blank %} {{ section.settings.custom_class }}{% endif %}
    "
        {% if section.settings.custom_id != blank %}
            id="{{ section.settings.custom_id }}"
        {% endif %}
>
    <div class="{{ section.settings.layout }} position-relative">
        {% liquid
            case section.settings.image_width
                when '25'
                    assign class_image_width = 'col-lg-3'
                    assign class_content_width = 'col-lg-9'
                when '33'
                    assign class_image_width = 'col-lg-4'
                    assign class_content_width = 'col-lg-8'
                when '50'
                    assign class_image_width = 'col-lg-6'
                    assign class_content_width = 'col-lg-6'
                when '66'
                    assign class_image_width = 'col-lg-8'
                    assign class_content_width = 'col-lg-4'
                when '75'
                    assign class_image_width = 'col-lg-9'
                    assign class_content_width = 'col-lg-3'
                when '100'
                    assign class_image_width = 'col-lg-12'
                    assign class_content_width = 'col-lg-12'
            endcase
        %}

        {% style %}
            {% if section.settings.use_custom_colors %}
                .block-extras-color-{{ section.id }} {
                --gradient-background-block: {% if section.settings.color_background_gradient_block != blank %}{{ section.settings.color_background_gradient_block }}{% else %}{{ section.settings.color_background_block }}{% endif %};
                --color-background-block: {{ section.settings.color_background_block.red }}, {{ section.settings.color_background_block.green }}, {{ section.settings.color_background_block.blue }};
                }
            {% endif %}
        {% endstyle %}
        <div
                class="cs-card card-banner banner-card-4 style-layout {{ section.settings.style_layout }}"
        >
            <div class="clearfix position-relative">
                <div class="row align-items-center{% if section.settings.image_second %} flex-md-row-reverse{% endif %}">
                    <div class="col-12 {{ class_image_width }}" data-aos="fade-right">
                        <div class="card-img-top position-relative lh-0 d-block{% if section.settings.image_height == 'adapt' %} card-adapt{% else %} card-img-custom-height {{ section.settings.image_height }} {% endif %}">
                            {% if section.settings.video != blank %}
                                <div class="clearfix">
                                    {{
                                    section.settings.video
                                    | video_tag:
                                    image_size: '600x',
                                    class: section.settings.image_position,
                                    autoplay: true,
                                    loop: true,
                                    muted: true,
                                    controls: section.settings.enable_controls
                                    }}
                                </div>
                            {% elsif section.settings.image != blank %}
                                <div class="clearfix">
                                    {% render 'image',
                                            lazyload: true,
                                            image: section.settings.image,
                                            class: section.settings.image_position
                                    %}
                                </div>
                            {% else %}
                                <div class="clearfix">
                                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg bg-body-tertiary' }}
                                </div>
                            {% endif %}

                        </div>
                        {% for block in section.blocks %}
                            {% case block.type %}
                                {% when 'image' %}
                                    <div class="image-animation {{ block.settings.image_animation_position }}">
                                        <div class="image-animation-inner {{ block.settings.image_animation_style }}">
                                            {% if block.settings.image_animation %}
                                                {% render 'image', lazyload: true, image: block.settings.image_animation, size: 'small' %}
                                            {% else %}
                                                {{ 'product-2' | placeholder_svg_tag: 'placeholder-svg bg-white' }}
                                            {% endif %}
                                        </div>
                                    </div>
                            {% endcase %}
                        {% endfor %}
                    </div>
                    <div class="col-12 {{ class_content_width }} {% if section.settings.use_custom_colors %} block-extras-color block-extras-color-{{ section.id }}{% endif %}"
                         data-aos="fade-left">
                        <div class="cs-card-body p-3 p-xl-5 position-relative {{ section.settings.text_box_position }} {{ section.settings.text_alignment }} {{ section.settings.text_alignment_mobile }}">
                            <div class="cs-card-body-inner py-3 px-0">
                                {% for block in section.blocks %}
                                    {% case block.type %}
                                        {% when 'caption' %}
                                            <h6 class="fs-14 letter-spacing-2 mb-1 opacity-85 text-uppercase mt-{{ block.settings.margin_top }}">
                                                {{ block.settings.caption }}
                                            </h6>
                                        {% when 'heading' %}
                                            <div class="mt-{{ block.settings.margin_top }}">
                                                {% render 'h-heading',
                                                        heading_tag: block.settings.heading_tag,
                                                        heading_size: block.settings.heading_size,
                                                        heading: block.settings.heading
                                                %}
                                            </div>

                                        {% when 'text' %}
                                            <div class="rte opacity-85 fs-18 mt-{{ block.settings.margin_top }}">
                                                {{ block.settings.text }}
                                            </div>
                                        {% when 'button' %}
                                            {% if block.settings.button_link and block.settings.button_label != blank %}
                                                <div class="card-bottom mb-4 mt-{{ block.settings.margin_top }}">
                                                    <a
                                                            {% if block.settings.button_link == blank %}
                                                                role="link" aria-disabled="true"
                                                            {% else %}
                                                                href="{{ block.settings.button_link }}"
                                                            {% endif %}
                                                            class="btn btn-{{ block.settings.button_style }} w-xs-100"
                                                    >
                                                        <span>{{- block.settings.button_label | escape -}}</span>
                                                    </a>
                                                </div>
                                            {% endif %}
                                        {% when 'iconwithtext' %}
                                            <div class="clearfix mt-{{ block.settings.margin_top }}">
                                                <div class="mb-2">
                                                    <div class="clearfix hover-translate-x">
                                                        {% if block.settings.image1 != blank %}
                                                            <div class="clearfix">


                                                                <div class="mb-2 img-width-medium item-hover">
                                                                    {% render 'image', lazyload: true, image: block.settings.image1, size: 'small' %}
                                                                </div>
                                                            </div>
                                                        {% endif %}
                                                        <div class="clearfix">
                                                            {% if block.settings.heading1 != blank %}
                                                                <p class="mb-0 fw-bold">
                                                                    {{ block.settings.heading1 }}
                                                                </p>
                                                            {% endif %}
                                                            {% if block.settings.subheading1 != blank %}
                                                                <div class="rte opacity-85 fs-14">
                                                                    {{ block.settings.subheading1 }}
                                                                </div>
                                                            {% endif %}
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="mb-2">
                                                    <div class="clearfix hover-translate-x">
                                                        {% if block.settings.image2 != blank %}
                                                            <div class="clearfix">


                                                                <div class="mb-2 img-width-medium item-hover">
                                                                    {% render 'image', lazyload: true, image: block.settings.image2, size: 'small' %}
                                                                </div>
                                                            </div>
                                                        {% endif %}
                                                        <div class="clearfix">
                                                            {% if block.settings.heading2 != blank %}
                                                                <p class="mb-0 fw-bold">
                                                                    {{ block.settings.heading2 }}
                                                                </p>
                                                            {% endif %}
                                                            {% if block.settings.subheading2 != blank %}
                                                                <div class="rte opacity-85 fs-14">
                                                                    {{ block.settings.subheading2 }}
                                                                </div>
                                                            {% endif %}
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="mb-2">
                                                    <div class="clearfix hover-translate-x">
                                                        {% if block.settings.image3 != blank %}
                                                            <div class="clearfix">


                                                                <div class="mb-2 img-width-medium item-hover">
                                                                    {% render 'image', lazyload: true, image: block.settings.image3, size: 'small' %}
                                                                </div>
                                                            </div>
                                                        {% endif %}
                                                        <div class="clearfix">
                                                            {% if block.settings.heading3 != blank %}
                                                                <p class="mb-0 fw-bold">
                                                                    {{ block.settings.heading3 }}
                                                                </p>
                                                            {% endif %}
                                                            {% if block.settings.subheading3 != blank %}
                                                                <div class="rte opacity-85 fs-14">
                                                                    {{ block.settings.subheading3 }}
                                                                </div>
                                                            {% endif %}
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                    {% endcase %}
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
