                                <div class="hamburger-menu" data-bs-toggle="offcanvas" data-bs-target="#offcanvasMenu"
                                     aria-controls="offcanvasMenu">
                                    <div class="hamburger-inner">
                                        <span></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-4 col-lg-2 d-flex align-items-center justify-content-center">
                        {% if request.page_type == 'index' %}
                            <h1 class="h6 site-header__logo mb-0">
                                {% endif %}
                                {% if settings.logo %}
                                    <a href="{{ routes.root_url }}"
                                       class="site-header__logo-image d-flex align-items-center"
                                       data-image-loading-animation>
                                        {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
                                        {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio -%}
                                        {% capture sizes %}(max-width: {{ settings.logo_width | times: 2 }}px) 50vw, {{ settings.logo_width }}px{% endcapture %}
                                        {% capture widths %}{{ settings.logo_width }}, {{ settings.logo_width | times: 1.5 | round }}, {{ settings.logo_width | times: 2 }}{% endcapture %}
                                        {{ settings.logo | image_url: width: 600 | image_tag:
                                        class: 'header__heading-logo motion-reduce',
                                        widths: widths,
                                        height: logo_height,
                                        width: settings.logo_width,
                                        alt: logo_alt,
                                        sizes: sizes,
                                        preload: true
                                        }}
                                    </a>
                                {% else %}
                                    <a class="site-header__logo-link h6 text-uppercase fw-bold"
                                       href="{{ routes.root_url }}">{{ shop.name }}</a>
                                {% endif %}
                                {% if request.page_type == 'index' %}
                            </h1>
                            {% endif %}
                        </div>
                        <div class="col-4 col-lg-5 d-flex justify-content-end">
                            <div class="site-header__icons{% if shop.customer_accounts_enabled %} site-header__icons--plus{% endif %}">
                                <div class="site-header__icons-wrapper d-flex align-items-center">
                                    {% if section.settings.enable_search %}
                                        <button type="button" id="searchForm"
                                                aria-label="{{ 'layout.navigation.search' | t }}" data-bs-toggle="modal"
                                                data-bs-target="#modalSearch"
                                                class="btn-link site-header__icon site-header__icon px-0">
                                            {% render 'icon-search' %}
                                            <span class="d-none">{{ 'layout.navigation.search' | t }}</span>
                                        </button>
                                    {% endif %}
                                    {% if shop.customer_accounts_enabled and section.settings.enable_account %}
                                        {% if customer %}
                                            <a href="{{ routes.account_url }}"
                                               class="site-header__icon site-header__account"
                                               aria-label="{{ 'layout.customer.account' | t }}">
                                                {% render 'icon-login' %}
                                                <span class="d-none">{{ 'layout.customer.account' | t }}</span>
                                            </a>
                                        {% else %}
                                            <a href="{{ routes.account_login_url }}"
                                               class="site-header__icon site-header__account"
                                               aria-label="{{ 'layout.customer.log_in' | t }}">
                                                {% render 'icon-login' %}
                                                <span class="d-none">{{ 'layout.customer.log_in' | t }}</span>
                                            </a>
                                        {% endif %}
                                    {% endif %}
                                    {% if settings.enable_wishlist and section.settings.enable_wishlist %}
                                        <a href="{{ settings.wishlist_page.url }}"
                                           class="site-header__icon position-relative"
                                           aria-label="Wishlist">
                                            {% render 'icon-heart' %}
                                            <div class="have_info site-header__cart-count">
                                                <span data-wishlist-count>0</span>
                                            </div>
                                        </a>
                                    {% endif %}
                                    {% if section.settings.enable_cart %}
                                        <a href="{{ routes.cart_url }}"
                                           class="site-header__icon site-header__cart position-relative"
                                           aria-label="{{ 'layout.cart.title' | t }}">
                                            <i class="bi bi-bag-check"></i>
                                            <span class="d-none">{{ 'layout.cart.title' | t }}</span>
                                            <div id="CartCount"
                                                 class="have_info site-header__cart-count{% if cart.item_count == 0 %} hide{% endif %} critical-hidden"
                                                 data-cart-count-bubble>
                                                <span data-cart-count>{{ cart.item_count }}</span>
                                                <span class="d-none">{{ 'layout.cart.items_count' | t: count: cart.item_count }}</span>
                                            </div>
                                        </a>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}
            {% if section.settings.logo_position == 'left-hamburger' %}
                <div class="container page-width">
                    <div class="row d-flex align-items-center">
                        <div class="col-6 d-flex align-items-center">
                            <div class="d-none">
                                <div class="header__inline-menu">
                                    {% # theme-check-disable %}
                                    {% render 'site-nav', linklist: section.settings.main_linklist, class: 'list--inline' %}
                                    {% # theme-check-enable %}
                                </div>
                            </div>
                            <div class="d-flex">
                                <div class="hamburger-menu" data-bs-toggle="offcanvas" data-bs-target="#offcanvasMenu"
                                     aria-controls="offcanvasMenu">
                                    <div class="hamburger-inner">
                                        <span></span>
                                    </div>
                                </div>
                            </div>
                        {% if request.page_type == 'index' %}
                            <h1 class="h6 site-header__logo mb-0">
                                {% endif %}
                                {% if settings.logo %}
                                    <a href="{{ routes.root_url }}"
                                       class="site-header__logo-image d-flex align-items-center"
                                       data-image-loading-animation>
                                        {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
                                        {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio -%}
                                        {% capture sizes %}(max-width: {{ settings.logo_width | times: 2 }}px) 50vw, {{ settings.logo_width }}px{% endcapture %}
                                        {% capture widths %}{{ settings.logo_width }}, {{ settings.logo_width | times: 1.5 | round }}, {{ settings.logo_width | times: 2 }}{% endcapture %}
                                        {{ settings.logo | image_url: width: 600 | image_tag:
                                        class: 'header__heading-logo motion-reduce',
                                        widths: widths,
                                        height: logo_height,
                                        width: settings.logo_width,
                                        alt: logo_alt,
                                        sizes: sizes,
                                        preload: true
                                        }}
                                    </a>
                                {% else %}
                                    <a class="site-header__logo-link h6 text-uppercase fw-bold"
                                       href="{{ routes.root_url }}">{{ shop.name }}</a>
                                {% endif %}
                                {% if request.page_type == 'index' %}
                            </h1>
                            {% endif %}
                        </div>
                        <div class="col-6 d-flex justify-content-end">
                            <div class="site-header__icons{% if shop.customer_accounts_enabled %} site-header__icons--plus{% endif %}">
                                <div class="site-header__icons-wrapper d-flex align-items-center">
                                    {% if section.settings.enable_search %}
                                        <button type="button" id="searchForm"
                                                aria-label="{{ 'layout.navigation.search' | t }}" data-bs-toggle="modal"
                                                data-bs-target="#modalSearch"
                                                class="btn-link site-header__icon site-header__icon px-0">
                                            {% render 'icon-search' %}
                                            <span class="d-none">{{ 'layout.navigation.search' | t }}</span>
                                        </button>
                                    {% endif %}
                                    {% if shop.customer_accounts_enabled and section.settings.enable_account %}
                                        {% if customer %}
                                            <a href="{{ routes.account_url }}"
                                               class="site-header__icon site-header__account"
                                               aria-label="{{ 'layout.customer.account' | t }}">
                                                {% render 'icon-login' %}
                                                <span class="d-none">{{ 'layout.customer.account' | t }}</span>
                                            </a>
                                        {% else %}
                                            <a href="{{ routes.account_login_url }}"
                                               class="site-header__icon site-header__account"
                                               aria-label="{{ 'layout.customer.log_in' | t }}">
                                                {% render 'icon-login' %}
                                                <span class="d-none">{{ 'layout.customer.log_in' | t }}</span>
                                            </a>
                                        {% endif %}
                                    {% endif %}
                                    {% if settings.enable_wishlist and section.settings.enable_wishlist %}
                                        <a href="{{ settings.wishlist_page.url }}"
                                           class="site-header__icon position-relative"
                                           aria-label="Wishlist">
                                            {% render 'icon-heart' %}
                                            <div class="have_info site-header__cart-count">
                                                <span data-wishlist-count>0</span>
                                            </div>
                                        </a>
                                    {% endif %}
                                    {% if section.settings.enable_cart %}
                                        <a href="{{ routes.cart_url }}"
                                           class="site-header__icon site-header__cart position-relative"
                                           aria-label="{{ 'layout.cart.title' | t }}">
                                            <i class="bi bi-bag-check"></i>
                                            <span class="d-none">{{ 'layout.cart.title' | t }}</span>
                                            <div id="CartCount"
                                                 class="have_info site-header__cart-count{% if cart.item_count == 0 %} hide{% endif %} critical-hidden"
                                                 data-cart-count-bubble>
                                                <span data-cart-count>{{ cart.item_count }}</span>
                                                <span class="d-none">{{ 'layout.cart.items_count' | t: count: cart.item_count }}</span>
                                            </div>
                                        </a>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}

        </header>
    </div>
</div>

<script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "Organization",
      "name": {{ shop.name | json }},
    {% if section.settings.logo %}
      "logo": {{ section.settings.logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    "sameAs": [
    {{ settings.social_twitter_link | json }}
      {{ settings.social_facebook_link | json }}
      {{ settings.social_pinterest_link | json }}
      {{ settings.social_instagram_link | json }}
      {{ settings.social_tiktok_link | json }}
      {{ settings.social_tumblr_link | json }}
      {{ settings.social_snapchat_link | json }}
      {{ settings.social_youtube_link | json }}
      {{ settings.social_vimeo_link | json }}
    ],
    "url": {{ request.origin | append: page.url | json }}
    }
</script>

{%- if request.page_type == 'index' -%}
    {% assign potential_action_target = request.origin | append: routes.search_url | append: "?q={search_term_string}" %}
    <script type="application/ld+json">
        {
          "@context": "http://schema.org",
          "@type": "WebSite",
          "name": {{ shop.name | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
      },
      "url": {{ request.origin | append: page.url | json }}
        }
    </script>
{%- endif -%}

