<div class="password-content container page-width">
  {% if section.settings.logo %}
    {% assign image_url = section.settings.logo | image_url %}
    <a href="{{ routes.root_url }}" itemprop="url" class="site-header__logo-image d-inline-block mb-5">
      {% capture logo_alt %}{{ section.settings.logo.alt | default: shop.name }}{% endcapture %}
      <img
        class="js"
        src="{{ image_url | asset_url }}"
        data-widths="[180, 360, 540, 720, 900, 1080, 1296, 1512, 1728, 2048]"
        data-aspectratio="{{ section.settings.logo.aspect_ratio }}"
        data-sizes="auto"
        loading="lazy"
        width="auto"
        height="auto"
        alt="{{ logo_alt | escape }}"
        style="max-width: {{ section.settings.logo_max_width }}px"
      >
      <noscript>
        {% capture image_size %}{{ section.settings.logo_max_width | escape }}x{% endcapture %}
        <img
          src="{{ section.settings.logo | image_url: image_size }}"
          srcset="{{ section.settings.logo | image_url: image_size }} 1x, {{ section.settings.logo | image_url: image_size, scale: 2 }} 2x"
          loading="lazy"
          alt="{{ section.settings.logo.alt | default: shop.name }}"
          itemprop="logo"
          width="auto"
          height="auto"
          style="max-width: {{ section.settings.logo_max_width }}px;"
        >
      </noscript>
    </a>
  {% else %}
    <h1 class="site-header__logo-link h6 mb-0 d-inline-block mb-3">
      <span class="logo">{{ shop.name }}</span>
    </h1>
  {% endif %}

  <h2 class="h1 password-content__title mb-3 mb-lg-4">{{ section.settings.header | escape }}</h2>
</div>

{% schema %}
{
  "name": "t:sections.password-header.name",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:sections.password-header.settings.logo.label"
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "label": "t:sections.password-header.settings.logo_max_width.label",
      "min": 50,
      "max": 500,
      "step": 10,
      "unit": "px",
      "default": 100
    },
    {
      "type": "text",
      "id": "header",
      "label": "t:sections.password-header.settings.header.label",
      "default": "Coming Soon"
    }
  ]
}
{% endschema %}
