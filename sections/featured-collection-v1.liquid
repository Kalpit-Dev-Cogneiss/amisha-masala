{% style %}
  .section-extras-spacing-{{ section.id }} {
  --section-padding-top: {{ section.settings.padding_top }}px;
  --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  --section-margin-top: {{ section.settings.margin_top }}px;
  --section-margin-bottom: {{ section.settings.margin_bottom }}px;
  }
  {% if section.settings.use_custom_colors %}
    .section-extras-color-{{ section.id }} {
    --gradient-background: {% if section.settings.color_background_gradient != blank %}{{ section.settings.color_background_gradient }}{% else %}{{ section.settings.color_background }}{% endif %};
    --color-background: {{ section.settings.color_background.red }}, {{ section.settings.color_background.green }}, {{ section.settings.color_background.blue }};
    --color-foreground: {{ section.settings.color_text.red }}, {{ section.settings.color_text.green }}, {{ section.settings.color_text.blue }};
    }
  {% endif %}
{% endstyle %}
<div
        class="section-extras-spacing section-extras-spacing-{{ section.id }}
     {% if section.settings.use_custom_colors %} section-extras-color section-extras-color-{{ section.id }} {% endif %}
     {% if section.settings.custom_class != blank %} {{ section.settings.custom_class }}{% endif %}
  "
        {% if section.settings.custom_id != blank %}
          id="{{ section.settings.custom_id }}"
        {% endif %}
>
  <div class="{{ section.settings.layout }} position-relative overflow-hidden">
    <div class="row{% if section.settings.reverse_mobile %} d-flex flex-column-reverse flex-md-row{% endif %}">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'content_left' %}
            <div class="col-12 mb-4 mb-lg-0 col-md-{{ block.settings.col_width }}">
              {% render 'banner-card-hero-1',
                      image: block.settings.image,
                      image_mobile: block.settings.image_mobile,
                      use_overlay: block.settings.use_overlay,
                      colors_overlay: block.settings.colors_overlay,
                      overlay_opacity: block.settings.overlay_opacity,
                      video: block.settings.video,
                      video_mobile: block.settings.video_mobile,
                      image_height_mobile: block.settings.image_height_mobile,
                      heading_tag: block.settings.heading_tag,
                      animation_slide: '',
                      block_id: block.id,
                      use_custom_colors_block: section.settings.use_custom_colors,
                      color_text_block: section.settings.color_text,
                      color_background_block: section.settings.color_background,
                      color_background_gradient_block: section.settings.color_background_gradient,
                      heading: block.settings.heading,
                      heading_size: block.settings.heading_size,
                      preheading: block.settings.preheading,
                      subheading: block.settings.subheading,
                      button_label: block.settings.button_label,
                      button_link: block.settings.button_link,
                      button_style: block.settings.button_style,
                      text_alignment: block.settings.text_alignment,
                      text_alignment_mobile: block.settings.text_alignment_mobile
              %}
            </div>
          {% when 'product' %}
            <div class="col-12 col-md-{{ block.settings.col_width }} {{ block.settings.style_slider }}">

              <div class="hero-slider position-static">
                <div
                        {% if block.settings.enable_slider %}
                          class="swiper-container overflow-hidden"
                          data-slide='
                {
                    "slidesPerView": {{ block.settings.columns_desktop }},
                    {% if block.settings.auto_rotate %}
                    "autoplay": {"delay": {{ block.settings.change_slides_speed }}000},
                    {% endif %}
                    "loop": {{ block.settings.loop }},
                    "autoHeight": true,
                    "spaceBetween": 0,
                    {% if block.settings.enable_pagination %}
                    "pagination": {
                      "el": ".swiper-pagination",
                       {% if block.settings.slider_visual != blank and block.settings.slider_visual != 'bullets' %}
                       "type": "{{ block.settings.slider_visual }}",
                       {% endif %}
                       {% if block.settings.slider_visual == 'bullets' %}
                        "dynamicBullets": "true",
                       {% endif %}
                       "clickable": true
                    },
                    {% endif %}
                    "breakpoints": {
                      "0": { "slidesPerView": {{ block.settings.columns_mobile }}, "spaceBetween": 10 },
                      "480": {"slidesPerView": {{ block.settings.columns_mobile }},"spaceBetween": 20 },
                      "768": { "slidesPerView": {{ block.settings.columns_tablet }}, "spaceBetween": 20 },
                      "992": { "slidesPerView": {{ block.settings.columns_desktop }},"spaceBetween": 20 },
                      "1200": {"slidesPerView": {{ block.settings.columns_desktop }},"spaceBetween": 20 }
                    }
                }
              '
                        {% endif %}
                >
                  <div
                          class="
                {% if block.settings.enable_slider %}
                  swiper-wrapper align-items-normal
                {% else %}
                  row gx-2 gx-lg-{{ block.settings.gutter }}
                  row-cols-{{ block.settings.columns_mobile }}
                  row-cols-md-{{ block.settings.columns_tablet }}
                  row-cols-lg-{{ block.settings.columns_desktop }}
                {% endif %}
              "
                  >
                    {% assign counter = 0 %}
                    {% for product in block.settings.collection.products limit: block.settings.products_to_show %}
                      {% if forloop.index == 3 or forloop.index == 7 %}
                        {% assign counter = 0 %}
                      {% endif %}
                      {% assign counter = counter | plus: 100 %}
                      <div
                              class="position-relative {% if block.settings.enable_slider %} swiper-slide{% else %}col mb-{{ block.settings.gutter }}{% endif %}"
                              data-aos="fade-up" data-aos-delay="{{ counter }}"
                      >
                        <div class="card-wrapper card-product h-100">
                          {% render 'product-card-grid',
                                  product: product,
                                  image_position: block.settings.image_position,
                                  image_height: block.settings.image_height,
                                  show_quick_add: block.settings.enable_quick_add,
                                  style_product: 'style-2'
                          %}
                        </div>
                      </div>
                    {% else %}
                      {% for i in (1..block.settings.products_to_show) %}
                        <div class="d-flex justify-content-between flex-column">
                          <div class="card-wrapper card-product w-100 h-100">
                            <div class="card-product-inner d-flex justify-content-between flex-column h-100{% if settings.show_border %} settings-card rounded-{{ settings.border_radius }}{% endif %}">
                              <div class="product-card position-relative style-v2">
                                <div class="mb-3 overflow-hidden position-relative">
                                  <a class="full-width-link" href="#">
                                    <span class="d-none">{{ 'homepage.onboarding.product_title' | t }}</span>
                                  </a>
                                  <div class="card-img-top hover-secondary-image card-adapt">
                                    {% capture current %}{% cycle 1, 2, 3, 4 %}{% endcapture %}
                                    {{ 'product-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                                  </div>
                                  <div class="position-absolute bottom-0 end-0 start-0 w-100 flex-1 action-btn z-index-10">
                                    <button class="btn btn-primary product-form__cart-submit text-uppercase">
                                      {{ 'products.product.add_to_cart' | t }}
                                    </button>
                                  </div>
                                  <div class="position-absolute top-0 end-0 m-3 z-index-10">
                                    <div class="ms-2">
                                      <button type="button"
                                              aria-label="Add to wishlist"
                                              class="btn-action active"
                                              button-wishlist=""
                                              data-product-handle="fresh-lemon-copy">
                                        <svg xmlns="http://www.w3.org/2000/svg"
                                             width="24"
                                             height="24" viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="1.2"
                                             stroke-linecap="round"
                                             stroke-linejoin="round"
                                             class="icon-wishlist feather feather-heart">
                                          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                                        </svg>

                                      </button>
                                    </div>
                                  </div>
                                </div>
                                <div class="card-content px-2 px-lg-3 pb-2 pb-lg-3">
                                  <h3 class="fs-14 card-product-title mb-2"
                                      aria-hidden="true">{{ 'homepage.onboarding.product_title' | t }}</h3>
                                  <div class="d-flex flex-nowrap align-items-center justify-content-center">
                                    <div class="price price--listing font-body">
                                      $19.99 <p class="fs-14 mb-0"><span
                                                class="mx-1">|</span>300g
                                      </p>
                                    </div>
                                  </div>
                                </div>
                              </div>
                            </div>
                          </div>
                        </div>
                      {% endfor %}
                    {% endfor %}
                  </div>
                  {% if block.settings.products_to_show > block.settings.columns_desktop
                  and block.settings.enable_slider
                  %}
                    {% if block.settings.enable_pagination %}
                      <div class="swiper-pagination position-relative mt-4"></div>
                    {% endif %}
                  {% endif %}
                </div>
              </div>
            </div>
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
