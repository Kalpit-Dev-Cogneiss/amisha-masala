          "label": "t:sections.all.layout.options__4.label"
        }
      ],
      "default": "full-width",
      "label": "t:sections.all.layout.header"
    },
    {
      "type": "checkbox",
      "id": "reverse_mobile",
      "default": false,
      "label": "t:sections.all.reverse.label"
    },
    {
      "type": "header",
