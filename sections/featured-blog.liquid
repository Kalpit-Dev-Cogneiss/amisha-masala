{% style %}
    .section-extras-spacing-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --section-margin-top: {{ section.settings.margin_top }}px;
    --section-margin-bottom: {{ section.settings.margin_bottom }}px;
    --color-border-card: {{ section.settings.color_border.red }}, {{ section.settings.color_border.green }}, {{ section.settings.color_border.blue }};
    }
    {% if section.settings.use_custom_colors %}
        .section-extras-color-{{ section.id }} {
        --gradient-background: {% if section.settings.color_background_gradient != blank %}{{ section.settings.color_background_gradient }}{% else %}{{ section.settings.color_background }}{% endif %};
        --color-background: {{ section.settings.color_background.red }}, {{ section.settings.color_background.green }}, {{ section.settings.color_background.blue }};
        --color-foreground: {{ section.settings.color_text.red }}, {{ section.settings.color_text.green }}, {{ section.settings.color_text.blue }};
        }
    {% endif %}
{% endstyle %}
{% liquid
    case section.settings.gutter
        when 0
            assign gutter_slider = 0
        when 1
            assign gutter_slider = 0.25 | times: 16
        when 2
            assign gutter_slider = 0.5 | times: 16
        when 3
            assign gutter_slider = 1 | times: 16
        when 4
            assign gutter_slider = 1.5 | times: 16
        when 5
            assign gutter_slider = 3 | times: 16
    endcase
%}
<div
        class="
    section-extras-spacing section-extras-spacing-{{ section.id }} {% if section.settings.use_custom_colors %} section-extras-color section-extras-color-{{ section.id }} {% endif %}
    {% if section.settings.custom_class != blank %} {{ section.settings.custom_class }}{% endif %} {{ section.settings.style_slider }}
  "
        {% if section.settings.custom_id != blank %}
            id="{{ section.settings.custom_id }}"
        {% endif %}
>
    <div class="container page-width position-relative">
        {% if section.settings.preheading != '' or section.settings.heading != '' or section.settings.subheading != '' %}
            <div class="cs-section-header {{ section.settings.heading_alignment }}">
                {% render 'heading',
                        heading: section.settings.heading,
                        class: '',
                        heading_tag: section.settings.heading_tag,
                        heading_size: section.settings.heading_size,
                        preheading: section.settings.preheading,
                        subheading: section.settings.subheading
                %}
            </div>
        {% endif %}
        {% if section.settings.enable_slider and section.settings.enable_navigation %}
            <div class="cs-navigation style-center relative-767 mb-3">
                {% render 'navigation-prev',
                        section_id: section.id,
                        navigation_icon: section.settings.navigation_icon
                %}

                {% render 'navigation-next',
                        section_id: section.id,
                        navigation_icon: section.settings.navigation_icon
                %}
            </div>
        {% endif %}
        <div class="{% if section.settings.enable_slider %}hero-slider hero-slider-col position-static{% else %}clearfix{% endif %}">
            <div
                    class="overflow-hidden{% if section.settings.enable_slider %} swiper-container{% endif %}"
                    {% if section.settings.enable_slider %}
                        data-slide='
            {
                      "slidesPerView": {{ section.settings.columns_desktop }},
                        {% if section.settings.auto_rotate %}
            "autoplay": {"delay": {{ section.settings.change_slides_speed }}000},
            {% endif %}
            "speed": 400,
            "loop": {{ section.settings.loop }},
                      "autoHeight": true,
                      "spaceBetween": 0,
                      {% if section.settings.enable_navigation %}
                              "navigation": {"nextEl": ".cs-swiper-button-next{{ section.id }}", "prevEl": ".cs-swiper-button-prev{{ section.id }}"},
                              {% endif %}
                              {% if section.settings.enable_pagination %}
                              "pagination": {
                                "el": ".swiper-pagination",
                                 {% if section.settings.slider_visual != blank and section.settings.slider_visual != 'bullets' %}
                                 "type": "{{ section.settings.slider_visual }}",
                                 {% endif %}
                                 {% if section.settings.slider_visual == 'bullets' %}
                                  "dynamicBullets": "true",
                                 {% endif %}
                                 "clickable": true
                              },
                              {% endif %}
                              "breakpoints": {
                                      "0": { "slidesPerView": {{ section.settings.columns_mobile }}, "spaceBetween": {{ gutter_slider }} },
                                      "480": {"slidesPerView": {{ section.settings.columns_mobile }},"spaceBetween": {{ gutter_slider }} },
                                      "768": { "slidesPerView": {{ section.settings.columns_tablet }}, "spaceBetween": {{ gutter_slider }} },
                                       "992": { "slidesPerView": {{ section.settings.columns_desktop }},"spaceBetween": {{ gutter_slider }} },
                                      "1200": {"slidesPerView": {{ section.settings.columns_desktop }},"spaceBetween": {{ gutter_slider }} }
                                      }
                  }
          '
                    {% endif %}
            >
                <div class="{% if section.settings.enable_slider %}swiper-wrapper{% else %}row gx-{{ section.settings.gutter }} row-cols-{{ section.settings.columns_mobile }} row-cols-md-{{ section.settings.columns_tablet }} row-cols-lg-{{ section.settings.columns_desktop }}{% endif %}">
                    {% assign blog = blogs[section.settings.blog] %}
                    {% assign counter = 0 %}
                    {% for article in blog.articles limit: section.settings.post_limit %}
                        {% assign counter = counter | plus: 100 %}
                        <div data-aos="fade-up" data-aos-delay="{{ counter }}"
                             class="{% if section.settings.enable_slider %} swiper-slide{% else %}col mb-{{ section.settings.gutter }}{% endif %}"
                        >
                            <div class="card-wrapper w-100 h-100">
                                {% render 'blog-card-grid',
                                        article: article,
                                        title_size: 'h6',
                                        blog_title: blog.title,
                                        blog_url: blog.url,
                                        blog_show_date: section.settings.blog_show_date,
                                        blog_show_excerpt: section.settings.blog_show_excerpt,
                                        blog_show_comment: section.settings.blog_show_comment,
                                        blog_show_read_more: section.settings.blog_show_read_more,
                                        image_position: section.settings.image_position,
                                        image_height: section.settings.image_height,
                                        border_radius: section.settings.border_radius
                                %}
                            </div>
                        </div>
                    {% else %}
                        {% for i in (1..section.settings.post_limit) %}
                            <div class="{% if section.settings.enable_slider %} swiper-slide{% else %}col mb-{{ section.settings.gutter }}{% endif %}">
                                <div class="card-wrapper w-100 h-100">
                                    <div class="cs-card blog-card position-relative h-100 d-flex flex-column">
                                      <div class="position-relative">
                                        <div class="card-img-top rounded-{{ section.settings.border_radius }} card-hover-overlay-dark lh-0 d-block overflow-hidden">
                                          {{ 'image' | placeholder_svg_tag: 'placeholder-svg bg-body-tertiary' }}
                                        </div>
                                      </div>

                                        <div class="cs-card-body pt-3">
                                            <div class="clearfix">
                                                {% if section.settings.blog_show_date %}
                                                    <div class="d-flex align-items-center flex-wrap fs-12 text-uppercase letter-spacing-2">
                                                        <p class="opacity-85 mb-1">
                                                            {{ 'homepage.onboarding.blog_date' | t }}
                                                        </p>
                                                    </div>
                                                {% endif %}
                                                <h3 class="h6">
                                                    <a href="#">{{ 'homepage.onboarding.blog_title' | t }}</a>
                                                </h3>
                                                {% if section.settings.blog_show_excerpt %}
                                                    <div class="rte opacity-85 mt-2">
                                                        {{ 'homepage.onboarding.blog_excerpt' | t }}
                                                    </div>
                                                {% endif %}
                                            </div>
                                            <div class="clearfix mt-4">
                                                <a
                                                        href="#"
                                                        class="hover-underline d-inline-block text-uppercase fs-12"
                                                >
                                                    {{ 'homepage.onboarding.read_more' | t -}}
                                                </a>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    {% endfor %}
                </div>
                {% if section.settings.enable_slider and section.settings.enable_pagination %}
                    <div class="swiper-pagination position-relative mt-4"></div>
                {% endif %}
            </div>
        </div>
        {% if section.settings.show_view_all %}
            <div class="text-center mt-4">
                <a
                        href="{{ blog.url }}"
                        class="btn btn-{{ section.settings.button_style }}"
                        aria-label="{{ 'blogs.article.view_all_blogs' | t }}"
                >
                    {{ 'blogs.article.view_all' | t }}
                </a>
            </div>
        {% endif %}
    </div>
</div>

