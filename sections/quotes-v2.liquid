{% style %}
    .section-extras-margin-{{ section.id }} {
    --section-margin-top: {{ section.settings.margin_top }}px;
    --section-margin-bottom: {{ section.settings.margin_bottom }}px;
    }
    .section-extras-padding-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    {% if section.settings.use_custom_colors %}
        .section-extras-color-{{ section.id }} {
        --gradient-background: {% if section.settings.color_background_gradient != blank %}{{ section.settings.color_background_gradient }}{% else %}{{ section.settings.color_background }}{% endif %};
        --color-background: {{ section.settings.color_background.red }}, {{ section.settings.color_background.green }}, {{ section.settings.color_background.blue }};
        --color-foreground: {{ section.settings.color_text.red }}, {{ section.settings.color_text.green }}, {{ section.settings.color_text.blue }};
        }
    {% endif %}
{% endstyle %}
{% liquid
    case section.settings.text_alignment
        when 'text-star'
            assign text_alignment_flex = 'justify-content-start'
        when 'text-center'
            assign text_alignment_flex = 'justify-content-center'
        when 'text-end'
            assign text_alignment_flex = 'justify-content-end'
    endcase
%}
<div
        class="section-quote-v2 hover-navigation position-relative section-extras-margin section-extras-margin-{{ section.id }} {{ section.settings.style_slider }}
    {% if section.settings.use_custom_colors %} section-extras-color section-extras-color-{{ section.id }} {% endif %}
    {% if section.settings.custom_class != blank %} {{ section.settings.custom_class }}{% endif %}
  "
        {% if section.settings.custom_id != blank %}
            id="{{ section.settings.custom_id }}"
        {% endif %}
>
    <div class="section-extras-padding section-extras-padding-{{ section.id }}{% if section.settings.enable_parallax and section.settings.background_image != blank %} jarallax{% endif %}" {% if section.settings.enable_parallax and section.settings.background_image != blank %}
        data-jarallax data-speed="{{ section.settings.speed }}" data-type="{{ section.settings.type }}"
        style="background-image: url('{{ section.settings.background_image | image_url: width: 1920 }}')"
            {% endif %}>
        <div class="container page-width">
            <div class="row gx-{{ section.settings.gutter }} row align-items-center justify-content-between{% if section.settings.image_second %} flex-column flex-md-row-reverse{% endif %}">
                <div class="col col-12 col-md-4 mb-4 mb-md-0" data-aos="fade-right">
                    <div class="clearfix{% if section.settings.image_height == 'adapt' %} card-adapt{% else %} card-img-custom-height {{ section.settings.image_height }} {% endif %}">
                        <div class="card-img-top">
                            {% if section.settings.image %}
                                {% render 'image', lazyload: true, image: section.settings.image %}
                            {% else %}
                                {{ 'image' | placeholder_svg_tag: 'placeholder-svg bg-body-tertiary' }}
                            {% endif %}
                        </div>
                    </div>
                </div>
                <div class="col col-12 col-md-7" data-aos="fade-up">
                    <div class="cs-section-header {{ section.settings.heading_alignment }}">
                        {% render 'heading',
                                heading: section.settings.heading,
                                class: '',
                                heading_tag: section.settings.heading_tag,
                                heading_size: section.settings.heading_size,
                                preheading: section.settings.preheading,
                                subheading: section.settings.subheading
                        %}
                    </div>
                    <div class="{% if section.settings.enable_slider %}hero-slider hero-slider-col position-static{% else %}content-wrap{% endif %}">
                        <div
                                class="overflow-hidden{% if section.settings.enable_slider %} swiper-container{% endif %}"
                                {% if section.settings.enable_slider %}
                                    data-slide='
                {
                          "slidesPerView": 1,
                            {% if section.settings.auto_rotate %}
                "autoplay": {"delay": {{ section.settings.change_slides_speed }}000},
                {% endif %}
                "speed": 400,
                "loop": {{ section.settings.loop }},
                          "autoHeight": false,
                          {% if section.settings.enable_navigation %}
                                  "navigation": {"nextEl": ".cs-swiper-button-next{{ section.id }}", "prevEl": ".cs-swiper-button-prev{{ section.id }}"},
                                  {% endif %}
                                  {% if section.settings.enable_pagination %}
                                  "pagination": {
                                    "el": ".swiper-pagination",
                                     {% if section.settings.slider_visual != blank and section.settings.slider_visual != 'bullets' %}
                                     "type": "{{ section.settings.slider_visual }}",
                                     {% endif %}
                                     {% if section.settings.slider_visual == 'bullets' %}
                                      "dynamicBullets": "true",
                                     {% endif %}
                                     "clickable": true
                                  },
                                  {% endif %}
                                  "spaceBetween": 0
                      }
              '
                                {% endif %}
                        >
                            <div class="{% if section.settings.enable_slider %}swiper-wrapper{% else %}row gx-{{ section.settings.gutter }} row-cols-1{% endif %}">
                                {% for block in section.blocks %}
                                    <div
                                            class="{% if section.settings.enable_slider %} swiper-slide{% else %}col mb-4 mb-lg-5{% endif %}"
                                            {{ block.shopify_attributes }}
                                    >
                                        <div class="clearfix {{ section.settings.text_alignment }}">
                                            <div class="star-wrap mb-2 color-yellow">
                                                {% for i in (1..5) %}
                                                    <i class="bi bi-star-fill text-primary"></i>
                                                {% endfor %}
                                            </div>
                                            {% if block.settings.quote != blank %}
                                                <div class="rte mb-0 fs-20">
                                                    {{ block.settings.quote }}
                                                </div>
                                            {% endif %}
                                        </div>

                                        <div class="d-flex align-items-center flex-nowrap pt-3 border-top {% if section.settings.text_alignment == 'text-end' %} text-end flex-row-reverse {% endif %} {{ text_alignment_flex }}">
                                            {% if block.settings.avatar != blank %}
                                                <div class="image-fit image-circle-60 {% if section.settings.text_alignment == 'text-end' %}ms-3{% else %}me-3{% endif %}">
                                                    {% render 'image', lazyload: true, image: block.settings.avatar, size: 'small' %}
                                                </div>
                                            {% else %}
                                                <div class="image-fit background-button image-circle-60 {% if section.settings.text_alignment == 'text-end' %}ms-3{% else %}me-3{% endif %}">
                                                    {% render 'icon-quote' %}
                                                </div>
                                            {% endif %}
                                            <div class="clearfix flex-1">
                                                {% if block.settings.author != blank %}
                                                    <p class="fs-18 mb-0">
                                                        {{ block.settings.author }}
                                                    </p>
                                                {% endif %}
                                                {% if block.settings.info != blank %}
                                                    <p class="fs-14 mb-0 opacity-85">{{ block.settings.info }}</p>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                            {% if section.settings.enable_slider %}
                                {% if section.settings.enable_pagination or section.settings.enable_navigation %}
                                    <div class="action-swiper position-relative d-flex {{ text_alignment_flex }} mt-4 {% if section.settings.enable_pagination and section.settings.slider_visual == "progressbar" %} action-progressbar{% endif %}">
                                        <div class="d-flex align-items-center flex-nowrap cs-navigation style-v1">
                                            {% if section.settings.enable_navigation and section.settings.navigation_position == 'bottom' %}
                                                {% render 'navigation-prev',
                                                        section_id: section.id,
                                                        navigation_icon: section.settings.navigation_icon
                                                %}
                                            {% endif %}
                                            {% if section.settings.enable_pagination %}
                                                <div class="swiper-pagination"></div>
                                            {% endif %}
                                            {% if section.settings.enable_navigation and section.settings.navigation_position == 'bottom' %}
                                                {% render 'navigation-next',
                                                        section_id: section.id,
                                                        navigation_icon: section.settings.navigation_icon
                                                %}
                                            {% endif %}
                                        </div>
                                    </div>
                                {% endif %}
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
