{% comment %}
  Amisha Masala - "Owner's Pride" showcase section.
  Dark photo background, outlined watermark, gradient title, glass pillar cards, stats strip.
{% endcomment %}
{%- liquid
  assign bg = section.settings.background_image
-%}
<section
  id="OwnersPride-{{ section.id }}"
  class="op"
  data-op
  style="--op-edge: {{ section.settings.edge_color }};"
>
  <div
    class="op__bg"
    {% if bg != blank %}
      style="background-image: url('{{ bg | image_url: width: 2400 }}');"
    {% endif %}
  ></div>
  <div class="op__shade"></div>
  <svg class="op__wave op__wave--top" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path d="M0,0 L1440,0 L1440,24 C1100,104 380,104 0,24 Z"></path>
  </svg>
  <svg class="op__wave op__wave--bottom" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path d="M0,90 L1440,90 L1440,66 C1100,-14 380,-14 0,66 Z"></path>
  </svg>

  <div class="container page-width op__inner" data-watermark="{{ section.settings.watermark | escape }}">
    <header class="op__head op__reveal">
      {%- if section.settings.preheading != blank -%}
        <span class="op__eyebrow">{{ section.settings.preheading | escape }}</span>
      {%- endif -%}
      <h2 class="op__title">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.quote != blank -%}
        <p class="op__quote">{{ section.settings.quote | escape }}</p>
      {%- endif -%}
    </header>

    <div class="op__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'pillar' -%}
          <article class="op__card op__reveal" style="--i: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
            <span class="op__icon" aria-hidden="true"><i class="bi {{ block.settings.icon | escape }}"></i></span>
            <h3 class="op__card-title">{{ block.settings.heading | escape }}</h3>
            <p class="op__card-text">{{ block.settings.text | escape }}</p>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <ul class="op__stats op__reveal" style="--i: 4;">
      {%- for block in section.blocks -%}
        {%- if block.type == 'stat' -%}
          <li class="op__stat" {{ block.shopify_attributes }}>
            <span class="op__stat-num">{{ block.settings.number | escape }}</span>
            <span class="op__stat-label">{{ block.settings.label | escape }}</span>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

<style>
  #OwnersPride-{{ section.id }} {
    --op-gold: #f5b83d;
    --op-gold-soft: #ffd36b;
    position: relative;
    overflow: hidden;
    color: #fff;
    padding: clamp(110px, 12vw, 180px) 0 clamp(100px, 11vw, 160px);
    background: radial-gradient(circle at 18% 0%, #9b1212 0%, #4a0808 48%, #170202 100%);
    isolation: isolate;
  }
  #OwnersPride-{{ section.id }} .op__bg {
    position: absolute;
    inset: 0;
    z-index: -3;
    background-size: cover;
    background-position: center;
    opacity: 0.32;
  }
  @media (min-width: 992px) and (hover: hover) {
    #OwnersPride-{{ section.id }} .op__bg { background-attachment: fixed; }
  }
  #OwnersPride-{{ section.id }} .op__shade {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      linear-gradient(180deg, rgba(23, 2, 2, 0.55) 0%, rgba(23, 2, 2, 0.15) 45%, rgba(23, 2, 2, 0.7) 100%);
  }
  #OwnersPride-{{ section.id }} .op__wave {
    position: absolute;
    left: 0;
    width: 100%;
    height: clamp(40px, 6vw, 90px);
    z-index: -1;
  }
  #OwnersPride-{{ section.id }} .op__wave path { fill: var(--op-edge, #fff); }
  #OwnersPride-{{ section.id }} .op__wave--top { top: -1px; }
  #OwnersPride-{{ section.id }} .op__wave--bottom { bottom: -1px; }

  #OwnersPride-{{ section.id }} .op__inner { position: relative; }
  #OwnersPride-{{ section.id }} .op__inner::before {
    content: attr(data-watermark);
    position: absolute;
    top: -0.12em;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--bs-font-heading-family);
    font-size: clamp(120px, 24vw, 380px);
    line-height: 1;
    letter-spacing: 0.04em;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.12);
    white-space: nowrap;
    pointer-events: none;
    z-index: -1;
  }

  #OwnersPride-{{ section.id }} .op__head { text-align: center; position: relative; margin-bottom: clamp(48px, 6vw, 84px); }
  #OwnersPride-{{ section.id }} .op__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.38em;
    text-transform: uppercase;
    color: var(--op-gold);
  }
  #OwnersPride-{{ section.id }} .op__eyebrow::before,
  #OwnersPride-{{ section.id }} .op__eyebrow::after {
    content: "";
    width: clamp(28px, 6vw, 80px);
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--op-gold));
  }
  #OwnersPride-{{ section.id }} .op__eyebrow::after { transform: scaleX(-1); }
  #OwnersPride-{{ section.id }} .op__title {
    margin: 18px 0 22px;
    font-family: var(--bs-font-heading-family);
    font-size: clamp(46px, 8vw, 118px);
    line-height: 1;
    background: linear-gradient(90deg, #ffffff 0%, var(--op-gold-soft) 55%, var(--op-gold) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 6px 24px rgba(0, 0, 0, 0.35));
  }
  #OwnersPride-{{ section.id }} .op__quote {
    position: relative;
    max-width: 820px;
    margin: 0 auto;
    padding-top: 26px;
    font-size: clamp(18px, 2.1vw, 27px);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.9);
  }
  #OwnersPride-{{ section.id }} .op__quote::before {
    content: "\201C";
    position: absolute;
    top: -34px;
    left: 50%;
    transform: translateX(-50%);
    font-family: Georgia, serif;
    font-size: 110px;
    line-height: 1;
    color: var(--op-gold);
    opacity: 0.85;
  }

  #OwnersPride-{{ section.id }} .op__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
    counter-reset: op;
  }
  @media (max-width: 1100px) { #OwnersPride-{{ section.id }} .op__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 575px) { #OwnersPride-{{ section.id }} .op__grid { grid-template-columns: 1fr; } }

  #OwnersPride-{{ section.id }} .op__card {
    position: relative;
    overflow: hidden;
    padding: 38px 28px 34px;
    border-radius: 24px;
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0.04));
    border: 1px solid rgba(255, 255, 255, 0.2);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1), border-color 0.4s, box-shadow 0.4s;
  }
  #OwnersPride-{{ section.id }} .op__card::before {
    counter-increment: op;
    content: counter(op, decimal-leading-zero);
    position: absolute;
    top: 8px;
    right: 18px;
    font-family: var(--bs-font-heading-family);
    font-size: 76px;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(245, 184, 61, 0.5);
    transition: -webkit-text-stroke-color 0.4s;
  }
  #OwnersPride-{{ section.id }} .op__card::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--op-gold), #ec1d1d);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  #OwnersPride-{{ section.id }} .op__card:hover {
    transform: translateY(-12px);
    border-color: var(--op-gold);
    box-shadow: 0 28px 60px rgba(0, 0, 0, 0.5), 0 0 40px rgba(245, 184, 61, 0.18);
  }
  #OwnersPride-{{ section.id }} .op__card:hover::before { -webkit-text-stroke-color: var(--op-gold); }
  #OwnersPride-{{ section.id }} .op__card:hover::after { transform: scaleX(1); }

  #OwnersPride-{{ section.id }} .op__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 66px;
    height: 66px;
    border-radius: 50%;
    font-size: 28px;
    color: #3a0606;
    background: linear-gradient(135deg, var(--op-gold-soft), var(--op-gold));
    box-shadow: 0 0 0 8px rgba(245, 184, 61, 0.16), 0 12px 24px rgba(0, 0, 0, 0.35);
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  #OwnersPride-{{ section.id }} .op__card:hover .op__icon { transform: rotate(-8deg) scale(1.08); }
  #OwnersPride-{{ section.id }} .op__card-title {
    margin: 26px 0 12px;
    font-family: var(--bs-font-heading-family);
    font-size: clamp(20px, 1.7vw, 25px);
    line-height: 1.2;
    color: #fff;
  }
  #OwnersPride-{{ section.id }} .op__card-text {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.82);
  }

  #OwnersPride-{{ section.id }} .op__stats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 28px clamp(36px, 7vw, 110px);
    margin: clamp(56px, 6vw, 84px) 0 0;
    padding: 38px 0 0;
    list-style: none;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
  }
  #OwnersPride-{{ section.id }} .op__stat { text-align: center; }
  #OwnersPride-{{ section.id }} .op__stat-num {
    display: block;
    font-family: var(--bs-font-heading-family);
    font-size: clamp(42px, 5vw, 68px);
    line-height: 1;
    color: var(--op-gold);
  }
  #OwnersPride-{{ section.id }} .op__stat-label {
    display: block;
    margin-top: 8px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.78);
  }

  /* scroll-in animation (only when JS is available) */
  #OwnersPride-{{ section.id }}.op-js .op__reveal {
    opacity: 0;
    transform: translateY(34px);
    transition: opacity 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) calc(var(--i, 0) * 0.12s),
      transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) calc(var(--i, 0) * 0.12s),
      border-color 0.4s, box-shadow 0.4s;
  }
  #OwnersPride-{{ section.id }}.op-js.op-in .op__reveal { opacity: 1; transform: none; }
  #OwnersPride-{{ section.id }}.op-js.op-in .op__card:hover { transform: translateY(-12px); }
  @media (prefers-reduced-motion: reduce) {
    #OwnersPride-{{ section.id }}.op-js .op__reveal { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  (function () {
    var el = document.getElementById('OwnersPride-{{ section.id }}');
    if (!el) return;
    el.classList.add('op-js');
    if (!('IntersectionObserver' in window) || (window.Shopify && Shopify.designMode)) {
      el.classList.add('op-in');
      return;
    }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { el.classList.add('op-in'); io.disconnect(); }
      });
    }, { threshold: 0.15 });
    io.observe(el);
  })();
</script>

{% schema %}
{
  "name": "Owner's Pride",
  "tag": "section",
  "class": "section-owners-pride",
  "settings": [
    { "type": "text", "id": "preheading", "label": "Small heading", "default": "J. B. Food Products" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Owner's Pride" },
    { "type": "text", "id": "watermark", "label": "Big outlined background word", "default": "PRIDE" },
    { "type": "textarea", "id": "quote", "label": "Intro quote", "default": "Our primary motto is the ultimate satisfaction of our customers. We will continuously strive to be the Best." },
    { "type": "image_picker", "id": "background_image", "label": "Background photo" },
    { "type": "color", "id": "edge_color", "label": "Color of the wavy top and bottom edge (match the page background)", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar card",
      "settings": [
        { "type": "text", "id": "icon", "label": "Bootstrap icon class", "default": "bi-patch-check", "info": "e.g. bi-people, bi-geo-alt, bi-tag" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Quality at Each Stage" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    },
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "25+" },
        { "type": "text", "id": "label", "label": "Label", "default": "Years of experience" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Owner's Pride",
      "blocks": [
        { "type": "pillar" },
        { "type": "pillar" },
        { "type": "pillar" },
        { "type": "pillar" }
      ]
    }
  ]
}
{% endschema %}
