{% style %}
    .section-extras-spacing-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --section-margin-top: {{ section.settings.margin_top }}px;
    --section-margin-bottom: {{ section.settings.margin_bottom }}px;

    }
    {% if section.settings.use_custom_colors %}
        .section-extras-color-{{ section.id }} {
        --gradient-background: {% if section.settings.color_background_gradient != blank %}{{ section.settings.color_background_gradient }}{% else %}{{ section.settings.color_background }}{% endif %};
        --color-background: {{ section.settings.color_background.red }}, {{ section.settings.color_background.green }}, {{ section.settings.color_background.blue }};
        --color-foreground: {{ section.settings.color_text.red }}, {{ section.settings.color_text.green }}, {{ section.settings.color_text.blue }};
        }
    {% endif %}
{% endstyle %}

<div
        class="
     multicolumn {{ section.settings.style }} overflow-hidden-x section-extras-spacing section-extras-spacing-{{ section.id }}
     {% if section.settings.use_custom_colors %} section-extras-color section-extras-color-{{ section.id }} {% endif %}
     {% if section.settings.custom_class != blank %} {{ section.settings.custom_class }}{% endif %}
  "
        {% if section.settings.custom_id != blank %}
            id="{{ section.settings.custom_id }}"
        {% endif %}
>
    <div class="section-{{ section.id }}-padding isolate {{ section.settings.layout }} position-relative">
        <div class="cs-section-header {{ section.settings.heading_alignment }}">
            {% render 'heading',
                    heading: section.settings.heading,
                    heading_tag: section.settings.heading_tag,
                    heading_size: section.settings.heading_size,
                    preheading: section.settings.preheading,
                    subheading: section.settings.subheading
            %}
        </div>
        <div class="gx-{{ section.settings.gutter }} row row-cols-1 row-cols-sm-{{ section.settings.columns_tablet }} row-cols-lg-{{ section.settings.columns_desktop }}">
            {% for block in section.blocks %}
                <div class="col mb-4" {{ block.shopify_attributes }}>

                    {% liquid
                        case section.settings.image_width
                            when '25'
                                assign class_image_width = 'col-3'
                            when '33'
                                assign class_image_width = 'col-4'
                            when '50'
                                assign class_image_width = 'col-6'
                            when '66'
                                assign class_image_width = 'col-8'
                            when '75'
                                assign class_image_width = 'col-9'
                            when '100'
                                assign class_image_width = 'col-12'
                        endcase
                    %}
                    <div
                            class="cs-card h-100"
                    >
                        <div class="row d-flex justify-content-center">
                            <div class="{{ class_image_width }}">
                                <div class="position-relative">
                                    <div class="card-img-top hover-background rounded-{{ section.settings.border_radius }} lh-0 d-block overflow-hidden{% if section.settings.image_height == 'adapt' %} card-adapt{% else %} card-img-custom-height {{ section.settings.image_height }} {% endif %}">
                                        {% if block.settings.button_link %}
                                            <a class="full-width-link" href="{{ block.settings.button_link }}">
                                                <span class="d-none">{{ block.settings.heading }}</span>
                                            </a>
                                        {% endif %}
                                        {% if block.settings.video_mobile != blank %}
                                            <div class="d-block d-md-none">
                                                {{
                                                block.settings.video_mobile
                                                | video_tag: image_size: '600x', autoplay: true, loop: true, muted: true, controls: false
                                                }}
                                            </div>
                                        {% else %}
                                            {% if block.settings.image_mobile != blank %}
                                                <div class="d-block d-md-none">
                                                    {% render 'image', lazyload: true, image: block.settings.image_mobile %}
                                                </div>
                                            {% endif %}
                                        {% endif %}
                                        {% if block.settings.video != blank %}
                                            <div class="media-wrap {% if block.settings.image_mobile != blank or block.settings.video_mobile != blank %}d-none d-md-block{% endif %}">
                                                {{ block.settings.video | video_tag: image_size: '600x', autoplay: true, loop: true, muted: true, controls: false }}
                                            </div>
                                        {% else %}
                                            {% if block.settings.image != blank %}
                                                <div class="media-wrap {% if block.settings.image_mobile != blank or block.settings.video_mobile != blank %}d-none d-md-block{% endif %}">
                                                    {% render 'image', lazyload: true, image: block.settings.image %}
                                                </div>
                                            {% else %}
                                                <div class="media-wrap {% if block.settings.image_mobile != blank or block.settings.video_mobile != blank %}d-none d-md-block{% endif %}">
                                                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg bg-body-tertiary' }}
                                                </div>
                                            {% endif %}
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="cs-card-body {% if section.settings.style == 'style-2' %} style-black px-3 pt-3 {% else %}py-4{% endif %} {{ section.settings.text_alignment }}">
                            <div class="cs-card-body-inner d-flex flex-column justify-content-between">
                                <div class="card-top">
                                    {% render 'heading-content',
                                            heading: block.settings.heading,
                                            heading_tag: section.settings.heading_tag_card,
                                            heading_size: section.settings.heading_size_card,
                                            subheading: block.settings.subheading,
                                            preheading: block.settings.preheading,
                                            animation: 'off'
                                    %}
                                </div>
                                {% if block.settings.button_link and block.settings.button_label != blank %}
                                    <div class="card-bottom mb-3">
                                        <a
                                                {% if block.settings.button_link == blank %}
                                                    role="link" aria-disabled="true"
                                                {% else %}
                                                    href="{{ block.settings.button_link }}"
                                                {% endif %}
                                                class="btn btn-{{ block.settings.button_style }} position-relative z-index-1"
                                        >
                                            <span>{{- block.settings.button_label | escape -}}</span>
                                        </a>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                </div>
            {% endfor %}
        </div>
    </div>
</div>

