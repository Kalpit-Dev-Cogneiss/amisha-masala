          "id": "title",
          "label": "t:sections.footer.blocks.text.settings.title.label",
          "default": "Talk about your business"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.footer.blocks.text.settings.text.label",
          "default": "<p>Share store details, promotions, or brand content with your customers.</p>"
        }
      ]
    },
    {
      "type": "gallery",
      "name": "t:sections.footer.blocks.gallery.name",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.footer.blocks.text.settings.title.label",
          "default": "Instagram"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.footer.blocks.gallery.settings.url.label"
        },
        {
          "type": "image_picker",
          "id": "image1",
          "label": "t:sections.footer.blocks.gallery.settings.images.image_1"
        },
        {
          "type": "image_picker",
          "id": "image2",
          "label": "t:sections.footer.blocks.gallery.settings.images.image_2"
        },
        {
          "type": "image_picker",
          "id": "image3",
          "label": "t:sections.footer.blocks.gallery.settings.images.image_3"
        },
        {
          "type": "image_picker",
          "id": "image4",
          "label": "t:sections.footer.blocks.gallery.settings.images.image_4"
        },
        {
          "type": "image_picker",
          "id": "image5",
          "label": "t:sections.footer.blocks.gallery.settings.images.image_5"
        },
        {
          "type": "image_picker",
          "id": "image6",
          "label": "t:sections.footer.blocks.gallery.settings.images.image_6"
        },
        {
          "type": "image_picker",
          "id": "image7",
          "label": "t:sections.footer.blocks.gallery.settings.images.image_7"
        },
        {
          "type": "image_picker",
          "id": "image8",
          "label": "t:sections.footer.blocks.gallery.settings.images.image_8"
        },
        {
