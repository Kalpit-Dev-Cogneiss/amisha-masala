{% style %}
  .section-extras-spacing-{{ section.id }} {
  --section-padding-top: {{ section.settings.padding_top }}px;
  --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  --section-margin-top: {{ section.settings.margin_top }}px;
  --section-margin-bottom: {{ section.settings.margin_bottom }}px;

  --color-border-card: {{ section.settings.color_border.red }}, {{ section.settings.color_border.green }}, {{ section.settings.color_border.blue }};
  }

  {% if section.settings.use_custom_colors %}
    .section-extras-color-{{ section.id }} {
    --gradient-background: {% if section.settings.color_background_gradient != blank %}{{ section.settings.color_background_gradient }}{% else %}{{ section.settings.color_background }}{% endif %};
    --color-background: {{ section.settings.color_background.red }}, {{ section.settings.color_background.green }}, {{ section.settings.color_background.blue }};
    --color-foreground: {{ section.settings.color_text.red }}, {{ section.settings.color_text.green }}, {{ section.settings.color_text.blue }};
    }
  {% endif %}
{% endstyle %}
{% liquid

  case section.settings.columns_mobile
    when '1'
      assign columns_mobile = 'col-12 col-sm-12'
    when '2'
      assign columns_mobile = 'col-6 col-sm-6'
  endcase

  case section.settings.columns_tablet
    when 1
      assign columns_tablet = 'col-md-12'
    when 2
      assign columns_tablet = 'col-md-6'
    when 3
      assign columns_tablet = 'col-md-4'
    when 4
      assign columns_tablet = 'col-md-3'
  endcase

  case section.settings.columns_desktop
    when 1
      assign columns_desktop = 'col-lg-12'
    when 2
      assign columns_desktop = 'col-lg-6'
    when 3
      assign columns_desktop = 'col-lg-4'
    when 4
      assign columns_desktop = 'col-lg-3'
  endcase
%}
<div
  class="
    section-extras-spacing section-extras-spacing-{{ section.id }} {% if section.settings.use_custom_colors %} section-extras-color section-extras-color-{{ section.id }} {% endif %}
    {% if section.settings.background_image != blank %} section-have-background-image position-relative overflow-hidden{% endif %}
    {% if section.settings.custom_class != blank %} {{ section.settings.custom_class }}{% endif %}
  "
  {% if section.settings.custom_id != blank %}
    id="{{ section.settings.custom_id }}"
  {% endif %}
>
  <div class="container page-width">
    <div
      class="
        cs-section-header {{ section.settings.heading_alignment }}
        {% if section.settings.show_view_all %} have-more{% endif %}
      "
    >
      {% if section.settings.show_view_all and section.settings.heading_alignment == 'text-center' %}
        <div class="d-none d-md-block flex-1"></div>
      {% endif %}
      {% render 'heading',
        heading: section.settings.heading,
        class: '',
        heading_tag: section.settings.heading_tag,
        heading_size: section.settings.heading_size,
        preheading: section.settings.preheading,
        subheading: section.settings.subheading
      %}
      {% if section.settings.show_view_all %}
        <div class="content-more text-nowrap">
          <a
            href="{{ blog.url }}"
            class="hover-underline d-inline-block"
            aria-label="{{ 'blogs.article.view_all_blogs' | t }}"
          >
            {{ 'blogs.article.view_all' | t }}
          </a>
        </div>
      {% endif %}
    </div>

    <div class="row gx-{{ section.settings.gutter }}" data-aos="fade-up">
      {% assign blog = blogs[section.settings.blog] %}

      {% for article in blog.articles limit: section.settings.post_limit %}

        {% if forloop.index == 1 %}
          <div class="col col-12 mb-{{ section.settings.gutter }}">
            <div class="card-wrapper w-100 h-100">
              {% render 'blog-card-list',
                article: article,
                blog_title: blog.title,
                blog_url: blog.url,
                blog_show_date: section.settings.blog_show_date,
                blog_show_excerpt: section.settings.blog_show_excerpt,
                blog_show_comment: section.settings.blog_show_comment,
                blog_show_read_more: section.settings.blog_show_read_more,
                image_position: section.settings.image_position,
                image_height: section.settings.image_height,
                      border_radius: section.settings.border_radius
              %}
            </div>
          </div>
        {% else %}
          <div
            class="{{ columns_mobile }} {{ columns_tablet }} {{ columns_desktop }} mb-{{ section.settings.gutter }}"
          >
            <div class="card-wrapper w-100 h-100">
              {% render 'blog-card-grid',
                article: article,
                title_size: 'h6',
                blog_title: blog.title,
                blog_url: blog.url,
                blog_show_date: section.settings.blog_show_date,
                blog_show_excerpt: false,
                blog_show_comment: section.settings.blog_show_comment,
                blog_show_read_more: section.settings.blog_show_read_more,
                image_position: section.settings.image_position,
                image_height: section.settings.image_height,
                      border_radius: section.settings.border_radius
              %}
            </div>
          </div>
        {% endif %}
      {% else %}
        {% for i in (1..section.settings.post_limit) %}
          {% if i == 1 %}
            <div class="col col-12 mb-{{ section.settings.gutter }}">
              <div class="card-wrapper w-100 h-100">
                <div class="cs-card blog-card position-relative h-100 d-flex flex-column">
                 <div class="row align-items-center">
                    <div class="col-12 col-md-6">
                      <div class="position-relative">
                        <div class="card-img-top card-hover-overlay-dark lh-0 d-block overflow-hidden rounded-{{ section.settings.border_radius }}">
                          {{ 'image' | placeholder_svg_tag: 'placeholder-svg bg-body-tertiary' }}
                        </div>
                      </div>

                    </div>
                   <div class="col-12 col-md-6">
                     <div class="cs-card-body p-3 d-flex flex-column justify-content-between flex-1 py-3 py-md-4">
                       <div class="clearfix">
                         {% if section.settings.blog_show_date %}
                           <div class="d-flex align-items-center flex-wrap fs-12 text-uppercase letter-spacing-2">
                             <p class="opacity-85 mb-1">
                               {{ 'homepage.onboarding.blog_date' | t }}
                             </p>
                           </div>
                         {% endif %}
                         <h3 class="pe-0 pe-xl-5 mb-0">
                           <a href="#">{{ 'homepage.onboarding.blog_title' | t }}</a>
                         </h3>
                         {% if section.settings.blog_show_excerpt %}
                           <div class="rte opacity-85 mt-2">
                             {{ 'homepage.onboarding.blog_excerpt' | t }}
                           </div>
                         {% endif %}
                       </div>
                       <div class="clearfix mt-4">
                         <a
                                 href="#"
                                 class="hover-underline d-inline-block text-uppercase fs-12"
                         >
                           {{ 'homepage.onboarding.read_more' | t -}}
                         </a>
                       </div>
                     </div>
                   </div>
                 </div>
                </div>
              </div>
            </div>
          {% else %}
            <div class="{{ columns_mobile }} {{ columns_tablet }} {{ columns_desktop }} mb-{{ section.settings.gutter }}">
              <div class="card-wrapper w-100 h-100">
                <div class="cs-card blog-card position-relative h-100 d-flex flex-column">
                  <div class="position-relative">
                    <div class="card-img-top card-hover-overlay-dark lh-0 d-block overflow-hidden rounded-{{ section.settings.border_radius }}">
                      {{ 'image' | placeholder_svg_tag: 'placeholder-svg bg-body-tertiary' }}
                    </div>
                  </div>
                  <div class="cs-card-body p-3 d-flex flex-column justify-content-between flex-1 py-3 py-md-4">
                    <div class="clearfix">
                      {% if section.settings.blog_show_date %}
                        <div class="d-flex align-items-center flex-wrap fs-12 text-uppercase letter-spacing-2">
                          <p class="opacity-85 mb-1">
                            {{ 'homepage.onboarding.blog_date' | t }}
                          </p>
                        </div>
                      {% endif %}
                      <h3 class="h6">
                        <a href="#">{{ 'homepage.onboarding.blog_title' | t }}</a>
                      </h3>
                    </div>
                    <div class="clearfix mt-4">
                      <a
                              href="#"
                              class="hover-underline d-inline-block text-uppercase fs-12"
                      >
                        {{ 'homepage.onboarding.read_more' | t -}}
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</div>
{% schema %}
