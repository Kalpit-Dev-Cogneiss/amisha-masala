{% comment %}
  Amisha Masala - brand story: headline + text, layered photo composition with a floating badge,
  and a count-up numbers strip.
{% endcomment %}
<section id="AmStory-{{ section.id }}" class="am-story">
  <div class="container page-width">
    <div class="am-story__grid">
      <div class="am-story__text">
        {%- if section.settings.eyebrow != blank -%}
          <span class="am-eyebrow" data-reveal>{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        <h2 class="am-title" data-reveal style="--i: 1;">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.lead != blank -%}
          <div class="am-lead" data-reveal style="--i: 2;">{{ section.settings.lead }}</div>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="am-body" data-reveal style="--i: 3;">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <div data-reveal style="--i: 4;">
            <a class="am-btn" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }} <i class="bi bi-arrow-right"></i></a>
          </div>
        {%- endif -%}
      </div>

      <div class="am-story__media" data-reveal="right">
        <span class="am-story__dots" aria-hidden="true"></span>
        <div class="am-story__img am-story__img--main">
          {%- if section.settings.image_main != blank -%}
            {{ section.settings.image_main | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '500, 800, 1100', sizes: '(min-width: 992px) 40vw, 90vw', alt: section.settings.heading }}
          {%- endif -%}
        </div>
        <div class="am-story__img am-story__img--small">
          {%- if section.settings.image_small != blank -%}
            {{ section.settings.image_small | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 600', sizes: '260px', alt: '' }}
          {%- endif -%}
        </div>
        {%- if section.settings.badge_number != blank -%}
          <div class="am-story__badge">
            <strong>{{ section.settings.badge_number | escape }}</strong>
            <span>{{ section.settings.badge_label | escape }}</span>
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- assign has_counters = false -%}
    {%- for block in section.blocks -%}{%- if block.type == 'counter' -%}{%- assign has_counters = true -%}{%- endif -%}{%- endfor -%}
    {%- if has_counters -%}
      <ul class="am-counters">
        {%- for block in section.blocks -%}
          {%- if block.type == 'counter' -%}
            <li class="am-counters__item" data-reveal style="--i: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
              <span class="am-counters__num"><span data-count="{{ block.settings.number | escape }}" data-suffix="{{ block.settings.suffix | escape }}">{{ block.settings.number | escape }}{{ block.settings.suffix | escape }}</span></span>
              <span class="am-counters__label">{{ block.settings.label | escape }}</span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

<style>
  #AmStory-{{ section.id }} { padding: clamp(70px, 8vw, 120px) 0 clamp(60px, 7vw, 100px); overflow: hidden; }
  #AmStory-{{ section.id }} .am-story__grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: clamp(40px, 6vw, 110px);
  }
  #AmStory-{{ section.id }} .am-story__text .am-btn { margin-top: 12px; }
  #AmStory-{{ section.id }} .am-story__media { position: relative; padding: 0 0 70px 60px; }
  #AmStory-{{ section.id }} .am-story__img img { display: block; width: 100%; height: 100%; object-fit: cover; }
  #AmStory-{{ section.id }} .am-story__img--main {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 999px 999px 32px 32px;
    overflow: hidden;
    box-shadow: 0 40px 80px rgba(74, 8, 8, 0.28);
    background: var(--am-cream);
  }
  #AmStory-{{ section.id }} .am-story__img--small {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 44%;
    aspect-ratio: 1 / 1;
    border-radius: 28px;
    overflow: hidden;
    border: 8px solid #fff;
    box-shadow: 0 24px 50px rgba(74, 8, 8, 0.3);
    background: var(--am-cream);
  }
  #AmStory-{{ section.id }} .am-story__badge {
    position: absolute;
    top: 6%;
    right: -2%;
    width: 150px;
    height: 150px;
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #3a0606;
    background: linear-gradient(135deg, var(--am-gold-soft), var(--am-gold));
    box-shadow: 0 0 0 10px rgba(245, 184, 61, 0.25), 0 24px 44px rgba(0, 0, 0, 0.25);
    animation: amFloat 5s ease-in-out infinite;
  }
  #AmStory-{{ section.id }} .am-story__badge strong { font-family: var(--bs-font-heading-family); font-size: 42px; line-height: 1; }
  #AmStory-{{ section.id }} .am-story__badge span { margin-top: 4px; padding: 0 14px; font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; line-height: 1.3; }
  #AmStory-{{ section.id }} .am-story__dots {
    position: absolute;
    top: 8%;
    left: 8px;
    width: 130px;
    height: 130px;
    background-image: radial-gradient(var(--am-red) 2.4px, transparent 2.6px);
    background-size: 20px 20px;
    opacity: 0.55;
  }
  @keyframes amFloat { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-14px); } }
  @media (prefers-reduced-motion: reduce) { #AmStory-{{ section.id }} .am-story__badge { animation: none; } }

  #AmStory-{{ section.id }} .am-counters {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: clamp(50px, 6vw, 90px) 0 0;
    padding: 36px 10px;
    list-style: none;
    border-radius: 32px;
    background: var(--am-cream);
    box-shadow: inset 0 0 0 1px rgba(74, 8, 8, 0.08);
  }
  #AmStory-{{ section.id }} .am-counters__item { text-align: center; padding: 8px 14px; border-left: 1px solid rgba(74, 8, 8, 0.14); }
  #AmStory-{{ section.id }} .am-counters__item:first-child { border-left: 0; }
  #AmStory-{{ section.id }} .am-counters__num { display: block; font-family: var(--bs-font-heading-family); font-size: clamp(44px, 5vw, 76px); line-height: 1; color: var(--am-red); }
  #AmStory-{{ section.id }} .am-counters__label { display: block; margin-top: 10px; font-size: 13px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: #4b3a3a; }

  @media (max-width: 991px) {
    #AmStory-{{ section.id }} .am-story__grid { grid-template-columns: 1fr; }
    #AmStory-{{ section.id }} .am-story__media { max-width: 560px; margin: 0 auto; width: 100%; }
    #AmStory-{{ section.id }} .am-counters { grid-template-columns: repeat(2, 1fr); row-gap: 20px; }
    #AmStory-{{ section.id }} .am-counters__item:nth-child(3) { border-left: 0; }
  }
  @media (max-width: 575px) {
    #AmStory-{{ section.id }} .am-story__media { padding-left: 24px; }
    #AmStory-{{ section.id }} .am-story__badge { width: 118px; height: 118px; }
    #AmStory-{{ section.id }} .am-story__badge strong { font-size: 32px; }
  }
</style>

{% schema %}
{
  "name": "Amisha - Brand story",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "About Us" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Amisha Masala" },
    { "type": "richtext", "id": "lead", "label": "Lead paragraph" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "image_main", "label": "Main photo (tall)" },
    { "type": "image_picker", "id": "image_small", "label": "Small photo (square)" },
    { "type": "text", "id": "badge_number", "label": "Badge number", "default": "35+" },
    { "type": "text", "id": "badge_label", "label": "Badge label", "default": "Years of experience" }
  ],
  "blocks": [
    {
      "type": "counter",
      "name": "Counter",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "35" },
        { "type": "text", "id": "suffix", "label": "After the number", "default": "+" },
        { "type": "text", "id": "label", "label": "Label", "default": "Years of experience" }
      ]
    }
  ],
  "presets": [{ "name": "Amisha - Brand story" }]
}
{% endschema %}
