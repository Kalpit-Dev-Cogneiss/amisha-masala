{% comment %}
  Amisha Masala - locations: photo cards for the corporate office and the factory units.
{% endcomment %}
<section id="AmLoc-{{ section.id }}" class="am-loc am-loc--{{ section.settings.background }}">
  <div class="container page-width">
    <header class="am-loc__head">
      {%- if section.settings.eyebrow != blank -%}
        <span class="am-eyebrow am-eyebrow--center" data-reveal>{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      <h2 class="am-title" data-reveal style="--i: 1;">{{ section.settings.heading | escape }}</h2>
    </header>

    <div class="am-loc__grid">
      {%- for block in section.blocks -%}
        <article class="am-place" data-reveal style="--i: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
          <div class="am-place__img">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 700, 900', sizes: '(min-width: 992px) 30vw, 90vw', alt: block.settings.name }}
            {%- endif -%}
            <span class="am-place__tag">{{ block.settings.tag | escape }}</span>
          </div>
          <div class="am-place__body">
            <h3 class="am-place__name">{{ block.settings.name | escape }}</h3>
            <p class="am-place__addr"><i class="bi bi-geo-alt-fill"></i><span>{{ block.settings.address | escape | newline_to_br }}</span></p>
            {%- if block.settings.map_link != blank -%}
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  #AmLoc-{{ section.id }} { padding: clamp(60px, 7vw, 110px) 0; }
  #AmLoc-{{ section.id }}.am-loc--cream { background: var(--am-cream); }
  #AmLoc-{{ section.id }} .am-loc__head { text-align: center; margin-bottom: clamp(34px, 5vw, 60px); }
  #AmLoc-{{ section.id }} .am-loc__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
  #AmLoc-{{ section.id }} .am-place {
    overflow: hidden;
    border-radius: 28px;
    background: #fff;
    box-shadow: 0 22px 50px rgba(74, 8, 8, 0.14);
    transition: transform 0.5s var(--am-ease), box-shadow 0.5s;
  }
  #AmLoc-{{ section.id }} .am-place:hover { transform: translateY(-10px); box-shadow: 0 34px 70px rgba(74, 8, 8, 0.28); }
  #AmLoc-{{ section.id }} .am-place__img { position: relative; aspect-ratio: 3 / 2; overflow: hidden; background: var(--am-cream); }
  #AmLoc-{{ section.id }} .am-place__img img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--am-ease); }
  #AmLoc-{{ section.id }} .am-place:hover .am-place__img img { transform: scale(1.08); }
  #AmLoc-{{ section.id }} .am-place__tag {
    position: absolute;
    top: 16px;
    left: 16px;
    padding: 7px 16px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #3a0606;
    background: linear-gradient(135deg, var(--am-gold-soft), var(--am-gold));
  }
  #AmLoc-{{ section.id }} .am-place__body { padding: 26px 28px 30px; }
  #AmLoc-{{ section.id }} .am-place__name { margin: 0 0 12px; font-family: var(--bs-font-heading-family); font-size: 26px; color: var(--am-ink); }
  #AmLoc-{{ section.id }} .am-place__addr { display: flex; gap: 12px; margin: 0 0 18px; font-size: 16px; line-height: 1.6; color: #4b3a3a; }
  #AmLoc-{{ section.id }} .am-place__addr i { color: var(--am-red); margin-top: 3px; }
  #AmLoc-{{ section.id }} .am-place__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--am-red);
    text-decoration: none;
    border-bottom: 2px solid currentColor;
    padding-bottom: 3px;
  }
  #AmLoc-{{ section.id }} .am-place__link:hover { color: var(--am-wine); }
  @media (max-width: 991px) { #AmLoc-{{ section.id }} .am-loc__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 575px) { #AmLoc-{{ section.id }} .am-loc__grid { grid-template-columns: 1fr; } }
</style>

{% schema %}
{
  "name": "Amisha - Locations",
  "tag": "section",
  "settings": [
    { "type": "select", "id": "background", "label": "Background", "default": "white", "options": [
      { "value": "white", "label": "White" }, { "value": "cream", "label": "Cream" } ] },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Find Us" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our Facilities" }
  ],
  "blocks": [
    {
      "type": "place",
      "name": "Location",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "tag", "label": "Label on photo", "default": "Corporate Office" },
        { "type": "text", "id": "name", "label": "Name", "default": "Corporate Office" },
        { "type": "textarea", "id": "address", "label": "Address" },
        { "type": "url", "id": "map_link", "label": "Google Maps link" }
      ]
    }
  ],
  "presets": [{ "name": "Amisha - Locations", "blocks": [{ "type": "place" }, { "type": "place" }, { "type": "place" }] }]
}
{% endschema %}
