<div class="container container-inner">
    <div class="row gx-{{ section.settings.gutter }} justify-content-center">
        {% for block in section.blocks %}
            {% case block.type %}
                {% when 'info' %}
                    <div class="col col-12 col-md-6 col-lg-5 mb-4">
                        <div class="sticky-lg-top">
                            {% render 'heading',
                                    heading: block.settings.heading,
                                    class: '',
                                    animation: 'off',
                                    heading_tag: 'h2',
                                    heading_size: section.settings.heading_size,
                                    subheading: block.settings.subheading
                            %}
                            {% if block.settings.content != blank %}
                                <div class="rte rte-custom">
                                    {{ block.settings.content }}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {% when 'form' %}
                {% style %}
                    {% if block.settings.use_custom_colors %}
                        .section-extras-color-{{ block.id }} {
                        --gradient-background: {% if block.settings.color_background_gradient != blank %}{{ block.settings.color_background_gradient }}{% else %}{{ block.settings.color_background }}{% endif %};
                        --color-background: {{ block.settings.color_background.red }}, {{ block.settings.color_background.green }}, {{ block.settings.color_background.blue }};
                        --color-foreground: {{ block.settings.color_text.red }}, {{ block.settings.color_text.green }}, {{ block.settings.color_text.blue }};
                        }
                    {% endif %}
                {% endstyle %}
                    <div class="col col-12 col-md-6 col-lg-7 mb-4">
                        <div class="sticky-lg-top {% if block.settings.use_custom_colors %}p-4 p-lg-5 section-extras-color section-extras-color-{{ block.id }}{% endif %}">
                            {% render 'heading',
                                    heading: block.settings.heading,
                                    class: '',
                                    heading_tag: 'h2',
                                    animation: 'off',
                                    heading_size: section.settings.heading_size,
                                    subheading: block.settings.subheading
                            %}
                            <div class="contact-form form-vertical style-3">
                                {% assign form_id = 'ContactForm' %}
                                {% form 'contact', id: form_id %}
                                    {% render 'form-status', form: form, form_id: form_id %}
                                    <div class="col mb-{{ section.settings.gutter }}">
                                        <label for="{{ form_id }}-name">{{ 'contact.form.name' | t }}</label>
                                        <input
                                                class="form-control"
                                                type="text"
                                                id="{{ form_id }}-name"
                                                name="contact[{{ 'contact.form.name' | t }}]"
                                                value="{% if form.first_name and form.last_name %}{{ form.first_name }} {{ form.last_name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                                        >
                                    </div>
                                    <div class="col mb-{{ section.settings.gutter }}">
                                        <label for="{{ form_id }}-email">
                                            {{- 'contact.form.email' | t }}
                                            <span
                                                    aria-hidden="true"
                                            >*</span
                                            ></label
                                        >
                                        <input
                                                class="form-control"
                                                type="email"
                                                id="{{ form_id }}-email"
                                                name="contact[email]"
                                                autocorrect="off"
                                                autocapitalize="off"
                                                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                                                aria-required="true"
                                                {% if form.errors contains 'email' %}
                                                    class="input--error"
                                                    aria-invalid="true"
                                                    aria-describedby="{{ form_id }}-email-error"
                                                {% endif %}
                                        >
                                        {% if form.errors contains 'email' %}
                                            <span id="{{ form_id }}-email-error" class="input-error-message">
                                <span class="d-none">{{ 'general.accessibility.error' | t }} </span>
                                <i class="bi bi-exclamation-circle"></i>
                                <span>
                                  {{- form.errors.translated_fields.email | capitalize }}
                                    {{ form.errors.messages.email }}.</span
                                >
                              </span>
                                        {% endif %}
                                    </div>
                                    <div class="col mb-{{ section.settings.gutter }}">
                                        <label for="{{ form_id }}-phone">{{ 'contact.form.phone' | t }}</label>
                                        <input
                                                class="form-control"
                                                type="tel"
                                                id="{{ form_id }}-phone"
                                                name="contact[{{ 'contact.form.phone' | t }}]"
                                                pattern="[0-9\-]*"
                                                value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                                        >
                                    </div>
                                    <div class="col mb-{{ section.settings.gutter }}">
                                        <label for="{{ form_id }}-message">{{ 'contact.form.message' | t }}</label>
                                        <textarea
                                                class="form-control"
                                                rows="10"
                                                id="{{ form_id }}-message"
                                                name="contact[{{ 'contact.form.message' | t }}]"
                                        >{% if form.body %}{{ form.body }}{% endif %}</textarea>
                                    </div>
                                    <button type="submit" class="btn btn-lg btn-{{ section.settings.button_style }}">
                                        {{ 'contact.form.submit' | t }}
                                    </button>
                                {% endform %}
                            </div>
                        </div>
                    </div>
            {% endcase %}
        {% endfor %}
    </div>
</div>
{% schema %}
{
  "name": "t:sections.contact-form.name",
  "settings": [
    {
      "type": "select",
      "id": "button_style",
      "options": [
        {
          "value": "primary",
          "label": "t:sections.all.button.button_style.options__1.label"
        },
        {
          "value": "outline-dark",
          "label": "t:sections.all.button.button_style.options__2.label"
        },
        {
          "value": "light",
          "label": "t:sections.all.button.button_style.options__3.label"
        },
        {
          "value": "dark",
          "label": "t:sections.all.button.button_style.options__4.label"
        }
      ],
      "default": "primary",
      "label": "t:sections.all.button.button_style.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "h4",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "h5",
          "label": "t:sections.all.heading_size.options__5.label"
        },
        {
          "value": "h6",
          "label": "t:sections.all.heading_size.options__6.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "range",
      "id": "gutter",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "t:sections.all.columns.gutter"
    }
  ],
  "blocks": [
    {
      "type": "form",
      "name": "t:sections.contact-form.blocks.form.label",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.all.heading.label",
          "default": "Send Us A Message"
        },
        {
          "type": "richtext",
          "id": "subheading",
          "label": "t:sections.all.heading.subheading"
        },
        {
          "type": "checkbox",
          "id": "use_custom_colors",
          "default": false,
          "label": "t:sections.all.color_options.use_custom_colors"
        },
        {
          "type": "color",
          "id": "color_text",
          "label": "t:sections.all.color_options.color_text",
          "default": "#000000"
        },
        {
          "type": "color",
          "id": "color_background",
          "label": "t:sections.all.color_options.color_background",
          "default": "#ffffff"
        },
        {
          "type": "color_background",
          "id": "color_background_gradient",
          "label": "t:sections.all.color_options.color_background_gradient"
        }
      ]
    },
    {
      "type": "info",
      "name": "t:sections.contact-form.blocks.information.label",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.all.heading.label",
          "default": "Information"
        },
        {
          "type": "richtext",
          "id": "subheading",
          "label": "t:sections.all.heading.subheading"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "t:sections.all.heading.content"
        },
        {
          "type": "header",
          "content": "t:sections.all.color_options.header"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.contact-form.presets.name",
      "blocks": [
        {
          "type": "form"
        }
      ]
    }
  ]
}
{% endschema %}
