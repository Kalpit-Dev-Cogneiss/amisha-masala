{% style %}
    .section-extras-margin-{{ section.id }} {
    --section-margin-top: {{ section.settings.margin_top }}px;
    --section-margin-bottom: {{ section.settings.margin_bottom }}px;
    }
    .section-extras-padding-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    {% if section.settings.use_custom_colors %}
        .section-extras-color-{{ section.id }} {
        --gradient-background: {% if section.settings.color_background_gradient != blank %}{{ section.settings.color_background_gradient }}{% else %}{{ section.settings.color_background }}{% endif %};
        --color-background: {{ section.settings.color_background.red }}, {{ section.settings.color_background.green }}, {{ section.settings.color_background.blue }};
        --color-foreground: {{ section.settings.color_text.red }}, {{ section.settings.color_text.green }}, {{ section.settings.color_text.blue }};
        }
    {% endif %}
{% endstyle %}
{% liquid
    case section.settings.text_alignment
        when 'text-star'
            assign text_alignment_flex = 'justify-content-start'
        when 'text-center'
            assign text_alignment_flex = 'justify-content-center'
        when 'text-end'
            assign text_alignment_flex = 'justify-content-end'
    endcase
%}
<div
        class="section-quote-v1 hover-navigation position-relative overflow-hidden section-extras-margin section-extras-margin-{{ section.id }} {{ section.settings.style_slider }}
    {% if section.settings.use_custom_colors %} section-extras-color section-extras-color-{{ section.id }} {% endif %}
    {% if section.settings.custom_class != blank %} {{ section.settings.custom_class }}{% endif %}
  "
        {% if section.settings.custom_id != blank %}
            id="{{ section.settings.custom_id }}"
        {% endif %}
>
    <div class="section-extras-padding section-extras-padding-{{ section.id }}{% if section.settings.enable_parallax and section.settings.background_image != blank %} jarallax{% endif %}" {% if section.settings.enable_parallax and section.settings.background_image != blank %}
        data-jarallax data-speed="{{ section.settings.speed }}" data-type="{{ section.settings.type }}"
        style="background-image: url('{{ section.settings.background_image | image_url: width: 1920 }}')"
            {% endif %}>
        <div class="{{ section.settings.layout }} position-relative">
            <div class="cs-section-header {{ section.settings.heading_alignment }}">
                {% render 'heading',
                        heading: section.settings.heading,
                        class: '',
                        heading_tag: section.settings.heading_tag,
                        heading_size: section.settings.heading_size,
                        preheading: section.settings.preheading,
                        subheading: section.settings.subheading
                %}
            </div>
            {% if section.settings.enable_slider and section.settings.enable_navigation %}
                <div class="cs-navigation style-v1 style-center relative-767 mb-3">
                    {% render 'navigation-prev',
                            section_id: section.id,
                            navigation_icon: section.settings.navigation_icon
                    %}

                    {% render 'navigation-next',
                            section_id: section.id,
                            navigation_icon: section.settings.navigation_icon
                    %}
                </div>
            {% endif %}
            <div class="{% if section.settings.enable_slider %}hero-slider position-static hero-slider-col{% else %}content-wrap {% endif %}">
                <div
                        class="overflow-hidden{% if section.settings.enable_slider %} swiper-container{% endif %}"
                        {% if section.settings.enable_slider %}
                            data-slide='
            {
                      "slidesPerView": {{ section.settings.columns_desktop }},
                        {% if section.settings.auto_rotate %}
            "autoplay": {"delay": {{ section.settings.change_slides_speed }}000},
            {% endif %}
            "speed": 400,
            "loop": {{ section.settings.loop }},
                      "autoHeight": false,
                      "spaceBetween": 0,
                      {% if section.settings.enable_navigation %}
                              "navigation": {"nextEl": ".cs-swiper-button-next{{ section.id }}", "prevEl": ".cs-swiper-button-prev{{ section.id }}"},
                              {% endif %}
                              {% if section.settings.enable_pagination %}
                              "pagination": {
                                "el": ".swiper-pagination",
                                 {% if section.settings.slider_visual != blank and section.settings.slider_visual != 'bullets' %}
                                 "type": "{{ section.settings.slider_visual }}",
                                 {% endif %}
                                 {% if section.settings.slider_visual == 'bullets' %}
                                  "dynamicBullets": "true",
                                 {% endif %}
                                 "clickable": true
                              },
                              {% endif %}
                              "breakpoints": {
                                      "0": { "slidesPerView": {{ section.settings.columns_mobile }}, "spaceBetween": 30 },
                                      "480": {"slidesPerView": {{ section.settings.columns_mobile }},"spaceBetween": 30 },
                                      "768": { "slidesPerView": {{ section.settings.columns_tablet }}, "spaceBetween": 30},
                                       "992": { "slidesPerView": {{ section.settings.columns_desktop }},"spaceBetween": 30},
                                      "1200": {"slidesPerView": {{ section.settings.columns_desktop }},"spaceBetween": 30 }
                                      }
                  }
          '
                        {% endif %}
                >
                    <div class="{% if section.settings.enable_slider %}swiper-wrapper{% else %}row gx-{{ section.settings.gutter }} row-cols-{{ section.settings.columns_mobile }} row-cols-md-{{ section.settings.columns_tablet }} row-cols-lg-{{ section.settings.columns_desktop }}{% endif %}">
                        {% assign counter = 0 %}
                        {% for block in section.blocks %}
                            {% assign counter = counter | plus: 100 %}
                            <div
                                    class="{% if section.settings.enable_slider %} swiper-slide h-100{% else %}col mb-{{ section.settings.gutter }}{% endif %}"
                                    data-aos="fade-up" data-aos-delay="{{ counter }}"
                                    {{ block.shopify_attributes }}
                            >
                                <div class="quotes-wrapper-v1{% if section.settings.enable_container %} container-white {% endif %}">
                                    <div class="quotes-inner{% if section.settings.enable_container %} container-white-inner{% endif %}">
                                        <div class="mb-4 {{ section.settings.text_alignment }}">
                                            <div class="star-wrap mb-2">
                                                {% for i in (1..5) %}
                                                    <i class="bi bi-star-fill"></i>
                                                {% endfor %}
                                            </div>
                                            {% if block.settings.quote != blank %}
                                                <div class="rte mb-3 fs-20">
                                                    {{ block.settings.quote }}
                                                </div>
                                            {% endif %}
                                        </div>
                                        <div class="d-flex align-items-center flex-nowrap {% if section.settings.text_alignment == 'text-end' %} text-end flex-row-reverse {% endif %} {{ text_alignment_flex }}">
                                            {% if block.settings.avatar != blank %}
                                                <div class="image-fit image-circle-60 {% if section.settings.text_alignment == 'text-end' %}ms-3{% else %}me-3{% endif %}">
                                                    {% render 'image', lazyload: true, image: block.settings.avatar, size: 'small' %}
                                                </div>
                                            {% else %}
                                                <div class="image-fit background-button image-circle-60 {% if section.settings.text_alignment == 'text-end' %}ms-3{% else %}me-3{% endif %}">
                                                    {% render 'icon-quote' %}
                                                </div>
                                            {% endif %}

                                            <div class="content-info">
                                                {% if block.settings.author != blank %}
                                                    <p class="fs-18 mb-0">
                                                        {{ block.settings.author }}
                                                    </p>
                                                {% endif %}
                                                {% if block.settings.info != blank %}
                                                    <p class="fs-16 mb-0 opacity-85">{{ block.settings.info }}</p>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                    {% if section.settings.enable_slider and section.settings.enable_pagination %}
                        <div class="swiper-pagination position-relative mt-4"></div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

