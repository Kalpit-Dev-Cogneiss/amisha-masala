    "amisha_feature_quality": {
      "type": "amisha-feature",
      "settings": {
        "image_side": "left",
        "background": "white",
        "eyebrow": "Quality Assurance",
        "heading": "Nothing but the BEST!",
        "text": "<p>Our products conform to stringent international quality standards. Right from procuring raw material to packing and delivery, we ensure our customers are served with only the very best of flavour.</p>",
