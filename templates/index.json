    "amisha_story": {
      "type": "amisha-story",
      "settings": {
        "eyebrow": "About Us",
        "heading": "Amisha Masala",
        "lead": "<p>Our Indian cuisine and gourmet delicacies are known all over the world for their delightful taste and aroma. At J. B. Food Products we ensure that this proud legacy continues to strive.</p>",
        "text": "<p>With over 35 years of experience in manufacturing spices, our endeavor in the spice industry has paid off. The best quality of spices and spice mixes, maintained by rigid standards of quality control, produced at our modern facilities are sound proof of this.</p><p>With a vast choice of finely ground spices (masalas), J. B. Food Products are able to meet the growing demands in an expanding market.</p>",
        "button_label": "Our story",
        "button_link": "shopify://pages/about-us",
        "image_main": "shopify://shop_images/story-main.webp",
