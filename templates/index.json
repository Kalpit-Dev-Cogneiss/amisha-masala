      },
      "blocks": {
        "point_1": {
          "type": "point",
          "settings": {
            "text": "Tested for purity, quality and safety: pesticide residues, aflatoxin and heavy metals"
          }
        },
        "point_2": {
          "type": "point",
          "settings": {
            "text": "Microbiological tests including total plate count, Salmonella, E. coli and yeast & mould"
          }
        },
        "point_3": {
          "type": "point",
          "settings": {
            "text": "Curcumin, capsaicin, Scoville index, pungency and colour value checked"
          }
        },
        "point_4": {
          "type": "point",
          "settings": {
            "text": "International protocols followed: ASTA, AOAC, AOCS and EU"
          }
        }
