    "collapsible_content_cMhkNK": {
      "type": "collapsible-content",
      "blocks": {
        "collapsible_row_GVJD3r": {
          "type": "collapsible-row",
          "settings": {
            "heading": "1. What makes your sauces special?",
            "row_content": "<p>Our sauces are crafted from unique, high-quality ingredients with traditional recipes passed down through generations. We use no artificial preservatives or additives—just pure, bold flavor in every bottle.<\/p>",
            "page": ""
          }
        },
        "collapsible_row_jppGiN": {
          "type": "collapsible-row",
          "settings": {
            "heading": "2. How should I store the sauce after opening?",
            "row_content": "<p>Once opened, our sauces should be kept in the refrigerator to maintain freshness and flavor. Be sure to close the cap tightly after each use.<\/p>",
            "page": ""
          }
        },
        "collapsible_row_yBxJFA": {
          "type": "collapsible-row",
          "settings": {
            "heading": "3. Do you offer international shipping?",
            "row_content": "<p>Yes! We offer international shipping to most countries. Shipping costs and delivery times will vary depending on your location. You can check shipping options during checkout.<\/p>",
            "page": ""
          }
        },
        "collapsible_row_EgFdWn": {
          "type": "collapsible-row",
          "settings": {
            "heading": "4. Are your sauces spicy?",
            "row_content": "<p>We offer a variety of sauces ranging from mild to extra spicy. Each product has a spice level indicated on the label, so you can choose the perfect one for your taste buds!<\/p>",
            "page": ""
          }
        }
      },
