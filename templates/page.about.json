    "amisha_feature_story": {
      "type": "amisha-feature",
      "settings": {
        "image_side": "right",
        "background": "white",
        "eyebrow": "Our Story",
        "heading": "About Amisha Masala",
        "text": "<p>Our Indian cuisine and gourmet delicacies are known all over the world for their delightful taste and aroma. At J. B. Food Products we ensure that this proud legacy continues to strive.</p><p>With over 35 years of experience in manufacturing spices, our endeavor in the spice industry has paid off. The best quality of spices and spice mixes, maintained by rigid standards of quality control, produced at our modern facilities are sound proof of this.</p><p>With a vast choice of finely ground spices (masalas), J. B. Food Products are able to meet the growing demands in an expanding market.</p>",
        "image": "shopify://shop_images/about-story.webp",
        "badge_number": "35+",
        "badge_label": "Years of experience",
        "button_label": "Shop spices",
        "button_link": "shopify://collections/spices"
      }
    },
    "amisha_feature_quality": {
      "type": "amisha-feature",
      "settings": {
        "image_side": "left",
        "background": "white",
        "eyebrow": "Quality Assurance",
        "heading": "Nothing but the BEST!",
        "text": "<p>Our products conform to stringent international quality standards. Right from procuring raw material to packing and delivery, we ensure our customers are served with only the very best of flavour.</p>",
        "image": "shopify://shop_images/about-quality.webp",
        "badge_number": "400",
        "badge_label": "Tons cold storage",
        "button_label": "Know more",
        "button_link": "shopify://pages/about-us"
      },
      "blocks": {
        "point_1": {
          "type": "point",
          "settings": {
            "text": "Tested for purity, quality and safety: pesticide residues, aflatoxin and heavy metals"
          }
        },
        "point_2": {
          "type": "point",
          "settings": {
            "text": "Microbiological tests including total plate count, Salmonella, E. coli and yeast & mould"
          }
        },
        "point_3": {
          "type": "point",
          "settings": {
            "text": "Curcumin, capsaicin, Scoville index, pungency and colour value checked"
          }
        },
        "point_4": {
          "type": "point",
          "settings": {
            "text": "International protocols followed: ASTA, AOAC, AOCS and EU"
          }
        }
      },
      "block_order": [
        "point_1",
        "point_2",
        "point_3",
        "point_4"
      ]
    },
    "amisha_feature_packaging": {
